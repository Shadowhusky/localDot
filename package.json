{
  "name": "localdot",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.29.3",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "lint": "biome check .",
    "format": "biome format --write .",
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "vitest run",
    "test:docker": "vitest run --config vitest.docker.config.ts",
    "hygiene": "node scripts/check-hygiene.mjs",
    "test:keyd": "vitest run --config vitest.keyd.config.ts",
    "keyd": "cd keyd && go build -o bin/keyd ./cmd/keyd && exec ./bin/keyd"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@types/node": "^24.0.0",
    "jsdom": "30.1.1",
    "typescript": "7.0.2",
    "vitest": "5.0.3"
  }
}
