{
  "name": "localdot",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.29.3",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "lint": "biome check . && node apps/web/scripts/ui-guard.mjs",
    "format": "biome format --write .",
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "vitest run",
    "test:remote": "pnpm --filter @localdot/remote build && pnpm --filter @localdot/remote test",
    "test:docker": "vitest run --config vitest.docker.config.ts",
    "test:eval": "vitest run --config vitest.eval.config.ts",
    "hygiene": "node scripts/check-hygiene.mjs",
    "check:ui": "node apps/web/scripts/ui-guard.mjs",
    "check:pack": "node scripts/check-pack.mjs",
    "check:pack-archive": "node scripts/check-pack-archive.mjs",
    "build:app-package": "node --experimental-transform-types apps/cli/scripts/pack-app-release.mjs",
    "build:keyd-package": "node --experimental-transform-types apps/cli/scripts/build-keyd-package.mjs",
    "test:keyd": "vitest run --config vitest.keyd.config.ts",
    "test:native-macos": "node scripts/check-native-macos.mjs",
    "keyd": "cd keyd && go build -o bin/keyd ./cmd/keyd && exec ./bin/keyd",
    "test:codex": "vitest run --config vitest.codex.config.ts",
    "test:codex-signin": "vitest run --config vitest.codex-signin.config.ts",
    "check:codex-release": "node --experimental-transform-types scripts/check-codex-release.mjs"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@types/node": "^24.0.0",
    "jsdom": "30.1.1",
    "typescript": "7.0.2",
    "vitest": "5.0.3"
  }
}
