{"kind":"text","format":"plain","lines":["/* Blue Hour — jazz night poster","   Design system: palette, type scale, grid. Shared by the A3 print sheet","   and the 1080x1350 Instagram crop. Sizes come from the --fs-* / --pad-*","   variables each sheet sets, so one system covers both formats. */","","*, *::before, *::after { box-sizing: border-box; }","",":root {","  /* palette — three colours plus two tints of the ink */","  --night:   #0A1430;   /* deep blue ground */","  --ink:     #F2EEE3;   /* warm off-white */","  --amber:   #F2A03C;   /* single accent: the lantern light */","  --ink-70:  rgba(242, 238, 227, .70);","  --ink-20:  rgba(242, 238, 227, .20);","","  --display: \"Inter Display\", \"Inter\", system-ui, sans-serif;","  --sans:    \"Inter\", system-ui, sans-serif;","  --mono:    \"JetBrains Mono\", ui-monospace, monospace;","}","","html, body { margin: 0; padding: 0; background: var(--night); }","",".sheet {","  position: relative;","  overflow: hidden;","  width: var(--sheet-w);","  height: var(--sheet-h);","  padding: var(--pad-y) var(--pad-x);","  background: var(--night);","  color: var(--ink);","  display: flex;","  flex-direction: column;","  font-family: var(--sans);","}","","/* --- top line ------------------------------------------------------- */",".hdr { display: flex; justify-content: space-between; align-items: baseline; gap: 1em; padding-bottom: var(--gap-s); }","",".eyebrow {","  margin: 0;"],"truncated":true}