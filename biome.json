{
  "$schema": "https://biomejs.dev/schemas/2.5.15/schema.json",
  "vcs": { "enabled": true, "clientKind": "git", "useIgnoreFile": true },
  "files": {
    "includes": [
      "**",
      "!spikes",
      "!packages/protocol/schema",
      "!apps/web/vendor",
      "!apps/web/dist",
      "!apps/daemon/src/agent/web/fixtures",
      "!apps/site/film/index.html"
    ]
  },
  "formatter": { "enabled": true, "indentStyle": "space", "indentWidth": 2, "lineWidth": 100 },
  "linter": {
    "enabled": true,
    "rules": { "preset": "recommended", "style": { "noDefaultExport": "error" } }
  },
  "javascript": { "formatter": { "quoteStyle": "double", "semicolons": "always" } },
  "css": { "parser": { "tailwindDirectives": true } },
  "overrides": [
    {
      "includes": ["apps/cli/src/install/sigstore-tuf-root.json"],
      "formatter": { "enabled": false }
    },
    {
      "includes": ["**/*.config.ts", "**/*.config.mjs"],
      "linter": { "rules": { "style": { "noDefaultExport": "off" } } }
    }
  ]
}
