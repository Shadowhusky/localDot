+/* A 32-bit TrueColor visual can be XRGB, with no alpha channel. Xvfb exposes
+ * those after ARGB visuals; selecting the last 32-bit visual produces black
+ * rectangular corners even with compositing and a transparent cairo surface. */
+static bool visual_has_alpha(xcb_render_query_pict_formats_reply_t *formats,
+                             xcb_visualid_t id) {
+  if (formats == NULL) {
+    return false;
+  }
+  xcb_render_pictvisual_t *pv = xcb_render_util_find_visual_format(formats, id);
+  if (pv == NULL) {
+    return false;
+  }
+  xcb_render_pictforminfo_iterator_t it =
+      xcb_render_query_pict_formats_formats_iterator(formats);
+  for (; it.rem; xcb_render_pictforminfo_next(&it)) {
+    if (it.data->id == pv->format) {
+      return it.data->type == XCB_RENDER_PICT_TYPE_DIRECT &&
+             it.data->direct.alpha_mask != 0;
+    }
+  }
+  return false;
+}
