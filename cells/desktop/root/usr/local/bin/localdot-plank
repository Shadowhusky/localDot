#!/bin/bash
# Plank keeps its settings in dconf and its launchers on the home volume; the dock's look and its
# items are pinned before every start. It floats and reserves no screen edge: it hides while a
# window overlaps it and comes back when the pointer reaches the bottom edge (pressure reveal
# needs relative motion, which the stream's absolute pointer never makes).
dock="net.launchpad.plank.dock.settings:/net/launchpad/plank/docks/dock1/"
launchers="${HOME}/.config/plank/dock1/launchers"
mkdir -p "$launchers"
rm -f "$launchers"/*.dockitem
items=()
for app in thunar chromium xfce4-terminal codium org.xfce.mousepad \
  libreoffice-writer libreoffice-calc libreoffice-impress gimp; do
  dir=/usr/share/applications
  [ -e "/usr/local/share/applications/$app.desktop" ] && dir=/usr/local/share/applications
  printf '[PlankDockItemPreferences]\nLauncher=file://%s/%s.desktop\n' \
    "$dir" "$app" > "$launchers/$app.dockitem"
  items+=("'$app.dockitem'")
done
gsettings set "$dock" dock-items "[$(IFS=,; echo "${items[*]}")]"
gsettings set "$dock" theme "'localdot-glass'"
gsettings set "$dock" position "'bottom'"
gsettings set "$dock" alignment "'center'"
gsettings set "$dock" hide-mode "'window-dodge'"
gsettings set "$dock" hide-delay 300
gsettings set "$dock" unhide-delay 0
gsettings set "$dock" pressure-reveal false
gsettings set "$dock" icon-size 48
gsettings set "$dock" zoom-enabled false
gsettings set "$dock" lock-items true
gsettings set "$dock" show-dock-item false
exec plank
