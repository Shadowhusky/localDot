{
  "$schema": "../../apps/remote/node_modules/wrangler/config-schema.json",
  "name": "localdot-downloads",
  "main": "worker.ts",
  "account_id": "31c17ebe287229213316608e4ef93f80",
  "compatibility_date": "2026-10-11",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [{ "pattern": "downloads.localdot.dev", "custom_domain": true }],
  "d1_databases": [
    {
      "binding": "STATS",
      "database_name": "localdot-stats",
      "database_id": "49d4b0d0-f4b7-4c7c-9737-f8561bd90a0b"
    }
  ],
  "assets": {
    "directory": "./.site",
    "binding": "ASSETS",
    "run_worker_first": ["/install.sh", "/install.ps1"],
    "html_handling": "none",
    "not_found_handling": "none"
  },
  "observability": {
    "enabled": true,
    "logs": { "invocation_logs": false },
    "traces": { "enabled": true, "head_sampling_rate": 0.01 }
  }
}
