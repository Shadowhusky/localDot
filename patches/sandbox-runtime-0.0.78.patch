diff --git a/dist/sandbox/loopback-bind.js b/dist/sandbox/loopback-bind.js
new file mode 100644
index 0000000..e3a8140
--- /dev/null
+++ b/dist/sandbox/loopback-bind.js
@@ -0,0 +1,11 @@
+// localDot's narrow macOS callback-listener extension. It never grants egress.
+export function assertLoopbackBindPorts(network, platform) {
+    const ports = network?.loopbackBindPorts;
+    if (ports === undefined) return;
+    if (platform !== 'macos' || !Array.isArray(ports) || ports.length === 0 || ports.length > 32 ||
+        new Set(ports).size !== ports.length || ports.some(port => !Number.isInteger(port) || port < 1 || port > 65535) ||
+        network.allowLocalBinding !== false || network.allowAllUnixSockets === true ||
+        network.strictAllowlist !== true || !Array.isArray(network.allowedDomains)) {
+        throw new Error('Restricted loopback listeners require macOS, exact ports and strict network isolation.');
+    }
+}
