+++ b/apps/daemon/src/safety/risk.ts
@@ -0,0 +1,292 @@
+import type {
+  ActionClass,
+  ApprovalSource,
+  AutonomyLevel,
+  DesktopWindow,
+  Target,
+  ToolName,
+} from "@localdot/protocol";
+import {
+  BROWSER_APPS,
+  BROWSER_SETTINGS_URL,
+  CAPTCHA_HOSTS,
+  CAPTCHA_NAME,
+  CHECKOUT_PATH,
+  CONFIRM_FIRST,
+  DELETE,
+  EDITABLE_ROLES,
+  EXECUTABLE_FILE,
+  FILE_MANAGERS,
+  OTP_FIELD,
+  PAYMENT_FIELD,
+  PERMISSION,
+  POST,
+  POST_FIELD,
+  PURCHASE,
+  type Phrases,
+  RUN_PROGRAM,
+  SEND,
+  SEND_FIELD,
+  SETTINGS_APPS,
+  TERMINAL_APPS,
+} from "./risk-words.ts";
+import { classifyShell } from "./shell-risk.ts";
+
+// What a rule found: the class whose autonomy level decides, how risky this instance is, and what
+// "approve similar" would cover. `memory` (a remember call) and `opaque` (a command localDot cannot
+// read) are not user-settable classes: they ask only after untrusted input (P6-R19, P6-R21).
+export type RiskClass = Exclude<ActionClass, "read"> | "memory" | "opaque";
+
+export interface RiskSubject {
+  // What the approval names: a pressed control, a field, keys, a command, a file.
+  kind: "button" | "field" | "keys" | "point" | "command" | "file" | "memory";
+  // Raw text (a page's or the model's): approval-text.ts sanitizes and quotes it.
+  text: string;
+}
+
+export interface RiskFinding {
+  cls: RiskClass;
+  risk: "medium" | "high";
+  source: ApprovalSource;
+  subject: RiskSubject;
+  where: { host?: string; app?: string; window?: string };
+  similarKey: string;
+  rule: string;
+}
+
+export const HANDOFF_CLASSES = new Set<RiskClass>(["login", "2fa", "captcha", "payment"]);
+
+// The level that applies to one finding (P6-R3): a high-risk finding never acts, and after the
+// session has read untrusted input (a page, a file, command output, a screenshot) nothing risky
+// acts either; `memory` and `opaque` ask only then.
+export function levelFor(
+  f: RiskFinding,
+  levels: Readonly<Record<ActionClass, AutonomyLevel>>,
+  tainted: boolean,
+): AutonomyLevel {
+  if (f.cls === "memory" || f.cls === "opaque") return tainted ? "ask" : "act";
+  const level = levels[f.cls];
+  if (level === "act" && (f.risk === "high" || tainted)) return "ask";
+  return level;
+}
+
+// The strongest finding decides: hand-offs first, then high risk, then the first found.
+export function strongest(findings: readonly RiskFinding[]): RiskFinding | undefined {
+  const rank = (f: RiskFinding) => (HANDOFF_CLASSES.has(f.cls) ? 2 : f.risk === "high" ? 1 : 0);
+  let best: RiskFinding | undefined;
+  for (const f of findings) if (!best || rank(f) > rank(best)) best = f;
+  return best;
+}
+
+// Names compare after Unicode compatibility folding, lower-cased, with format characters dropped
+// and every run of punctuation or space as one space: "Ｂｕｙ​ now!" is "buy now".
+export function norm(s: string | undefined): string {
+  return (s ?? "")
+    .normalize("NFKC")
+    .replace(/\p{Cf}/gu, "")
+    .toLowerCase()
+    .replace(/[^\p{L}\p{N}]+/gu, " ")
+    .trim();
+}
+
+export function matches(name: string, p: Phrases): boolean {
+  if (!name) return false;
+  const first = name.split(" ")[0] ?? "";
+  if (p.first.includes(first)) return true;
+  const padded = ` ${name} `;
+  return p.anywhere.some((phrase) => padded.includes(` ${phrase} `));
+}
+
+export function hostOf(url: string | undefined): string | undefined {
+  if (!url) return undefined;
+  try {
+    const u = new URL(url);
+    return u.protocol === "http:" || u.protocol === "https:" ? u.hostname : undefined;
+  } catch {
+    return undefined;
+  }
+}
+
+function isCaptchaUrl(url: string | undefined): boolean {
+  if (!url) return false;
+  try {
+    const u = new URL(url);
+    const host = u.hostname;
+    if (CAPTCHA_HOSTS.some((h) => host === h || host.endsWith(`.${h}`))) return true;
+    return /(^|\.)google\.com$/.test(host) && u.pathname.startsWith("/recaptcha");
+  } catch {
+    return false;
+  }
+}
+
+function isCheckout(url: string | undefined): boolean {
+  if (!url) return false;
+  try {
+    return CHECKOUT_PATH.test(new URL(url).pathname);
+  } catch {
+    return false;
+  }
+}
+
+export interface GuiRiskInput {
+  verb: "click" | "scroll" | "type" | "key";
+  count?: number;
+  // What desktopd found at the point (accessibility or CDP), or null when it found nothing in time.
+  target: Target | null;
+  // The X window under the point (desktopd's window-at), or null.
+  window: DesktopWindow | null;
+  // The page the target is on, when it is web content.
+  pageUrl?: string;
+  // type: the text the agent would type (classified only when the window is a terminal).
+  text?: string;
+  // key: the combo, X-style names.
+  combo?: readonly string[];
+}
+
+// The GUI rules (spec "Risk rules"): the action kind, the target's role and name, the page URL and,
+// for typing into a terminal, shell patterns. Scrolls are never risky.
+export function classifyGui(i: GuiRiskInput): RiskFinding[] {
+  if (i.verb === "scroll") return [];
+  const t = i.target;
+  const name = norm(t?.name);
+  const role = norm(t?.role);
+  // A WM_CLASS keeps its hyphens ("xfce4-terminal"): only case and spaces are folded.
+  const app = (i.window?.cls ?? t?.app ?? "").toLowerCase().trim();
+  const url = i.pageUrl ?? t?.url;
+  const host = hostOf(url);
+  const where = {
+    ...(host ? { host } : {}),
+    ...(app ? { app } : {}),
+    ...(i.window?.title ? { window: i.window.title } : {}),
+  };
+  const editable = EDITABLE_ROLES.has(role) || t?.secret === true;
+  const scope = host ?? app ?? "desktop";
+  const found = (
+    cls: RiskClass,
+    risk: "medium" | "high",
+    subject: RiskSubject,
+    rule: string,
+  ): RiskFinding => ({ cls, risk, source: "gui", subject, where, similarKey: `${cls}|gui|${scope}`, rule });
+  const subjectOf = (kind: RiskSubject["kind"]): RiskSubject =>
+    t?.name ? { kind, text: t.name } : { kind: "point", text: "" };
+  const out: RiskFinding[] = [];
+
+  // Hand-offs: credentials, one-time codes, card details and CAPTCHAs are the user's (spec).
+  if (isCaptchaUrl(url) || CAPTCHA_NAME.test(name) || CAPTCHA_NAME.test(role))
+    out.push(found("captcha", "high", subjectOf("button"), "captcha"));
+  if (i.verb === "type" && t) {
+    if (t.secret === true || role === "password text")
+      out.push(found("login", "high", subjectOf("field"), "secret field"));
+    else if (PAYMENT_FIELD.test(name)) out.push(found("payment", "high", subjectOf("field"), "card field"));
+    else if (OTP_FIELD.test(name)) out.push(found("2fa", "high", subjectOf("field"), "one-time code field"));
+  }
+
+  // Settings: any press in a settings tool, or on Chromium's own settings pages.
+  if (SETTINGS_APPS.has(app) || (url && BROWSER_SETTINGS_URL.test(url)))
+    out.push(found("system_settings", "high", subjectOf("button"), "settings app"));
+
+  // Typing into a terminal runs commands: the shell rules apply to the text.
+  if (i.verb === "type" && i.text && (TERMINAL_APPS.has(app) || role === "terminal")) {
+    for (const f of classifyShell(i.text))
+      out.push({ ...f, source: "gui", where, similarKey: `${f.cls}|gui|${app}` });
+  }
+
+  if (i.verb === "click" && !editable && name) {
+    const web = BROWSER_APPS.has(app) || host !== undefined;
+    if (matches(name, PURCHASE)) out.push(found("purchase", "high", subjectOf("button"), "purchase name"));
+    else if (isCheckout(url) && CONFIRM_FIRST.includes(name.split(" ")[0] ?? ""))
+      out.push(found("purchase", "high", subjectOf("button"), "confirm on a checkout page"));
+    if (matches(name, SEND)) out.push(found("send", "medium", subjectOf("button"), "send name"));
+    if (matches(name, POST)) out.push(found("post", "medium", subjectOf("button"), "post name"));
+    if (matches(name, DELETE))
+      out.push(found("delete", web ? "high" : "medium", subjectOf("button"), "delete name"));
+    if (matches(name, PERMISSION))
+      out.push(found("system_settings", "high", subjectOf("button"), "permission name"));
+    if (matches(name, RUN_PROGRAM))
+      out.push(found("run_downloaded", "high", subjectOf("button"), "run or install name"));
+  }
+  // Opening a program file from the file manager runs it.
+  if (
+    i.verb === "click" &&
+    (i.count ?? 1) >= 2 &&
+    FILE_MANAGERS.has(app) &&
+    t?.name &&
+    EXECUTABLE_FILE.test(t.name.trim())
+  )
+    out.push(found("run_downloaded", "high", { kind: "file", text: t.name }, "open a program file"));
+
+  if (i.verb === "key" && isEnter(i.combo) && editable) {
+    const keys: RiskSubject = { kind: "keys", text: (i.combo ?? []).join("+") };
+    if (isCheckout(url)) out.push(found("purchase", "high", keys, "enter on a checkout page"));
+    if (POST_FIELD.test(name)) out.push(found("post", "medium", keys, "enter in a post field"));
+    else if (SEND_FIELD.test(name)) out.push(found("send", "medium", keys, "enter in a message field"));
+  }
+  // Delete in a file manager removes the selection.
+  if (i.verb === "key" && FILE_MANAGERS.has(app) && (i.combo ?? []).some((k) => norm(k) === "delete"))
+    out.push(found("delete", "medium", { kind: "keys", text: (i.combo ?? []).join("+") }, "delete key"));
+  return out;
+}
+
+function isEnter(combo: readonly string[] | undefined): boolean {
+  return (combo ?? []).some((k) => ["return", "enter", "kp enter"].includes(norm(k)));
+}
+
+// Home in the desktop cell is /config (linuxserver's base); the model may write ~ or $HOME.
+const HOME_PREFIX = /^(~|\$HOME|\$\{HOME\}|\/config)(?=\/|$)/;
+export function homePath(p: string): string {
+  return p.trim().replace(HOME_PREFIX, "~");
+}
+
+// Files that start programs or change how the computer behaves at the next login (P6-R20).
+export const PERSISTENCE_PATHS: readonly RegExp[] = [
+  /^~\/\.(bashrc|bash_profile|bash_login|profile|zshrc|zprofile|zshenv|xprofile|xinitrc|xsessionrc|pam_environment)$/,
+  /^~\/\.config\/(autostart|systemd|environment\.d|xfce4)\//,
+  /^~\/\.local\/share\/applications\//,
+  /^~\/\.ssh\//,
+  /^~\/\.(gnupg|pki)\//,
+  /^\/(etc|usr|boot|bin|sbin|lib|lib64|opt|var\/spool\/cron)\//,
+];
+export function isPersistencePath(p: string): boolean {
+  const h = homePath(p);
+  return PERSISTENCE_PATHS.some((re) => re.test(h));
+}
+
+// The tool-level rules: what a call's input says before anything runs. GUI actions are judged at
+// press time by the gateway's guard (classifyGui), when the target is known.
+export function classifyTool(tool: ToolName, input: unknown): RiskFinding[] {
+  const i = input as Record<string, unknown>;
+  switch (tool) {
+    case "shell":
+      return classifyShell(String(i.command ?? ""));
+    case "files": {
+      const path = String(i.path ?? "");
+      if ((i.op === "write" || i.op === "edit") && isPersistencePath(path))
+        return [
+          {
+            cls: "system_settings",
+            risk: "high",
+            source: "files",
+            subject: { kind: "file", text: homePath(path) },
+            where: {},
+            similarKey: `system_settings|files|${homePath(path)}`,
+            rule: "startup or system file",
+          },
+        ];
+      return [];
+    }
+    case "remember":
+      return [
+        {
+          cls: "memory",
+          risk: "medium",
+          source: "memory",
+          subject: { kind: "memory", text: String(i.file ?? "") },
+          where: {},
+          similarKey: `memory|memory|${String(i.file ?? "")}`,
+          rule: "memory change",
+        },
+      ];
+    default:
+      return [];
+  }
+}
