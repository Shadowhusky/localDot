+};
+
+export const PERMISSION: Phrases = {
+  first: ["allow", "authorize", "authorise", "grant"],
+  anywhere: ["allow access", "always allow", "grant access", "give access"],
+};
+
+export const RUN_PROGRAM: Phrases = {
+  first: ["install", "run", "execute"],
+  anywhere: ["run anyway", "open anyway", "run in terminal", "install now"],
+};
+
+// Generic confirmations that mean "buy" on a checkout page (by the page URL).
+export const CONFIRM_FIRST = [
+  "continue",
+  "confirm",
+  "submit",
+  "next",
+  "done",
+  "ok",
+  "proceed",
+  "complete",
+  "finish",
+];
+export const CHECKOUT_PATH = /\/(checkout|payment|payments|pay|billing|purchase|buy|order|orders)(\/|$|[-_.])/i;
+
+// Fields the agent must never type into: credentials, one-time codes and card details.
+export const OTP_FIELD =
+  /\b(verification|one time|one-time|otp|2fa|two factor|two-factor|security|authentication|auth|login|sms|access) code\b|\b(passcode|totp|otp)\b/;
+export const PAYMENT_FIELD =
+  /\b(card number|credit card|debit card|cardholder|cvv|cvc|cvv2|csc|card security code|expiry|expiration|exp date|iban|routing number|account number|sort code|bsb)\b/;
+export const CAPTCHA_NAME =
+  /captcha|recaptcha|hcaptcha|turnstile|i ?a?m not a robot|verify (you are|you re|that you are) (a )?human|are you a robot|press and hold/;
+export const CAPTCHA_HOSTS = [
+  "recaptcha.net",
