+
+export const SEND: Phrases = {
+  first: ["send", "reply", "forward", "share", "invite", "submit"],
+  anywhere: ["send message", "send email", "send now", "reply all", "send invite"],
+};
+
+export const POST: Phrases = {
+  first: ["post", "publish", "tweet", "retweet", "repost", "comment", "upload"],
+  anywhere: ["go live", "post comment", "share post", "add comment"],
+};
+
+export const DELETE: Phrases = {
+  first: [
+    "delete",
+    "remove",
+    "discard",
+    "erase",
+    "unsubscribe",
+    "deactivate",
+    "revoke",
+    "uninstall",
+    "trash",
