index 0000000..4f34f58
--- /dev/null
+++ b/packages/protocol/src/safety.ts
@@ -0,0 +1,187 @@
+import { z } from "zod";
+
+// Control and safety (spec "Safety and control", M5): the autonomy levels per action class, the
+// approval timeout, and the takeover input wire.
+
+// Action classes, from the spec's defaults: ask for purchases, sending, posting, deleting, running
+// downloaded programs and changing system settings; hand off logins, 2FA, CAPTCHAs and payment
+// fields; act on reading and browsing.
+export const ACTION_CLASSES = [
+  "read",
+  "purchase",
+  "send",
+  "post",
+  "delete",
+  "run_downloaded",
+  "system_settings",
+  "login",
+  "2fa",
+  "captcha",
+  "payment",
+] as const;
+export const ActionClass = z.enum(ACTION_CLASSES);
+export type ActionClass = z.infer<typeof ActionClass>;
+
+export const AutonomyLevel = z.enum(["act", "ask", "handoff"]);
+export type AutonomyLevel = z.infer<typeof AutonomyLevel>;
+
+export const DEFAULT_AUTONOMY: Readonly<Record<ActionClass, AutonomyLevel>> = {
+  read: "act",
+  purchase: "ask",
+  send: "ask",
+  post: "ask",
+  delete: "ask",
+  run_downloaded: "ask",
+  system_settings: "ask",
+  login: "handoff",
+  "2fa": "handoff",
+  captcha: "handoff",
+  payment: "handoff",
+};
+
+// What the user may pick per class (P6-R3). Reading always acts; the hand-off classes always hand
+// off, because the agent never types credentials; the high-risk classes never act.
+export const ALLOWED_LEVELS: Readonly<Record<ActionClass, readonly AutonomyLevel[]>> = {
+  read: ["act"],
+  purchase: ["ask", "handoff"],
+  send: ["act", "ask", "handoff"],
+  post: ["act", "ask", "handoff"],
+  delete: ["act", "ask", "handoff"],
+  run_downloaded: ["ask", "handoff"],
+  system_settings: ["ask", "handoff"],
+  login: ["handoff"],
+  "2fa": ["handoff"],
+  captcha: ["handoff"],
+  payment: ["handoff"],
+};
+
+// <home>/safety.json. Only the classes the user changed are stored; the rest follow the defaults.
+export const AutonomySettings = z
+  .object({
+    v: z.literal(1),
+    levels: z.partialRecord(ActionClass, AutonomyLevel),
+  })
+  .strict()
+  .superRefine((s, ctx) => {
+    for (const [cls, level] of Object.entries(s.levels) as [ActionClass, AutonomyLevel][]) {
+      if (!ALLOWED_LEVELS[cls].includes(level))
+        ctx.addIssue({
+          code: "custom",
+          path: ["levels", cls],
+          message: `${cls} can be ${ALLOWED_LEVELS[cls].join(" or ")}, not ${level}`,
+        });
+    }
+  });
+export type AutonomySettings = z.infer<typeof AutonomySettings>;
+export const DEFAULT_AUTONOMY_SETTINGS: AutonomySettings = { v: 1, levels: {} };
+
+export function effectiveLevels(s: AutonomySettings): Record<ActionClass, AutonomyLevel> {
+  return { ...DEFAULT_AUTONOMY, ...s.levels };
+}
+
+// An approval left unanswered this long is denied (spec "Approvals").
+export const APPROVAL_TIMEOUT_MS = 10 * 60 * 1000;
+
+// The keys the user's keyboard may hold down in the computer during a takeover: modifiers,
+// navigation and editing keys, function keys. Characters travel as `char`, pasted text as `text`.
+export const TAKEOVER_KEYSYMS = [
+  "Shift_L",
+  "Shift_R",
+  "Control_L",
+  "Control_R",
+  "Alt_L",
+  "Alt_R",
+  "Super_L",
+  "Return",
+  "KP_Enter",
+  "Tab",
+  "ISO_Left_Tab",
+  "Escape",
+  "BackSpace",
+  "Delete",
+  "Insert",
+  "space",
+  "Home",
+  "End",
+  "Prior",
+  "Next",
+  "Left",
+  "Right",
+  "Up",
+  "Down",
+  "Menu",
+  "F1",
+  "F2",
+  "F3",
+  "F4",
+  "F5",
+  "F6",
+  "F7",
+  "F8",
+  "F9",
+  "F10",
+  "F11",
+  "F12",
+] as const;
+export const TakeoverKeysym = z.enum(TAKEOVER_KEYSYMS);
+export type TakeoverKeysym = z.infer<typeof TakeoverKeysym>;
+
+// Device pixels of the desktop (2560×1600 at 2×); the daemon clamps to the cell's real screen.
+const coord = z.number().int().min(0).max(8191);
+
+// One input from the user's own mouse or keyboard while they hold the computer (spec "Takeover").
+export const TakeoverEvent = z.discriminatedUnion("t", [
+  z.object({ t: z.literal("move"), x: coord, y: coord }),
+  z.object({
+    t: z.literal("button"),
+    x: coord,
+    y: coord,
+    button: z.union([z.literal(1), z.literal(2), z.literal(3)]),
+    down: z.boolean(),
+  }),
+  z.object({
+    t: z.literal("wheel"),
+    x: coord,
+    y: coord,
+    dx: z.number().int().min(-10).max(10),
+    dy: z.number().int().min(-10).max(10),
+  }),
+  z.object({ t: z.literal("key"), key: TakeoverKeysym, down: z.boolean() }),
+  // One printable character, typed with whatever modifiers it needs.
+  z.object({ t: z.literal("char"), ch: z.string().regex(/^[^\p{Cc}\p{Cs}]$/u) }),
+  // Pasted from the user's own clipboard (P6-R12): typed, never logged, never shown to the agent.
+  z.object({ t: z.literal("text"), text: z.string().min(1).max(4096) }),
+  // Let go of every key and button the user still holds.
+  z.object({ t: z.literal("release") }),
+]);
+export type TakeoverEvent = z.infer<typeof TakeoverEvent>;
+
+export const LEASE_ID_PATTERN = /^[A-Za-z0-9_-]{22}$/;
+
+// The UI's takeover socket (/api/cells/:id/takeover): a hello naming the lease, then batches.
+export const TakeoverSocketMessage = z.discriminatedUnion("t", [
+  z.object({ t: z.literal("hello"), leaseId: z.string().regex(LEASE_ID_PATTERN) }),
+  z.object({ t: z.literal("events"), events: z.array(TakeoverEvent).min(1).max(256) }),
+]);
+export type TakeoverSocketMessage = z.infer<typeof TakeoverSocketMessage>;
+
+// The daemon to desktopd: POST /takeover/input.
+export const TakeoverInputBatch = z.object({ events: z.array(TakeoverEvent).min(1).max(256) });
+export type TakeoverInputBatch = z.infer<typeof TakeoverInputBatch>;
+export const TakeoverInputReply = z.object({ applied: z.number().int().nonnegative() });
+export type TakeoverInputReply = z.infer<typeof TakeoverInputReply>;
+
+// desktopd's window lookups (POST /window-at, GET /windows): X's own view, milliseconds, no
+// accessibility tree. `cls` is the WM_CLASS class, lower-cased.
+export const DesktopWindow = z.object({
+  id: z.number().int().nonnegative(),
+  cls: z.string().max(128),
+  title: z.string().max(256),
+  active: z.boolean(),
+});
+export type DesktopWindow = z.infer<typeof DesktopWindow>;
+export const WindowAtRequest = z.object({ x: coord, y: coord });
+export const WindowAtReply = z.object({ window: DesktopWindow.nullable() });
+export type WindowAtReply = z.infer<typeof WindowAtReply>;
+export const WindowsReply = z.object({ windows: z.array(DesktopWindow).max(64) });
+export type WindowsReply = z.infer<typeof WindowsReply>;
