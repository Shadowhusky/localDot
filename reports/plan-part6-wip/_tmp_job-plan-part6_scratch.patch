+]);
+// Chromium's own settings pages change the browser for every later task.
+export const BROWSER_SETTINGS_URL = /^chrome:\/\/(settings|flags|extensions|policy|password-manager)\b/;
+// A file the user (or a page) downloaded and the agent would run.
+export const EXECUTABLE_FILE = /\.(sh|bash|zsh|run|bin|appimage|deb|rpm|py|pl|rb|jar|exe|msi|desktop)$/i;
