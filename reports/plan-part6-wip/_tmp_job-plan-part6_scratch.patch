+import type { SafetySession } from "../approvals.ts";
+
+export interface Logged {
+  type: string;
+  data: Record<string, unknown>;
+  step?: string;
+}
+
+// A session that records what it appends, in order, beside any other journal the test keeps.
+export function fakeSession(journal: string[] = [], cellId = "cell-1") {
+  const events: Logged[] = [];
+  const abort = new AbortController();
+  const session: SafetySession & { events: Logged[] } = {
+    id: "01J9ZQ3V8Y7X6W5T4S3R2Q1P0N",
+    cellId,
+    tainted: false,
+    abort,
+    events,
+    get stopped() {
+      return abort.signal.aborted;
+    },
+    append(type, data, step) {
+      events.push({ type, data, ...(step ? { step } : {}) });
+      journal.push(`event ${type}${type === "control.change" ? ` ${String(data.holder)}` : ""}`);
+    },
+  };
+  return session;
+}
+
+export function deferred<T = void>() {
+  let resolve!: (v: T) => void;
+  const promise = new Promise<T>((r) => {
+    resolve = r;
+  });
+  return { promise, resolve };
+}
+
+export const tick = () => new Promise((r) => setImmediate(r));
