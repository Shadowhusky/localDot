+import { describe, expect, it } from "vitest";
+import { approvalTitle, pagePreview, previewFields, quoted, safeText } from "./approval-text.ts";
+import type { RiskFinding } from "./risk.ts";
+
+const finding = (over: Partial<RiskFinding>): RiskFinding => ({
+  cls: "purchase",
+  risk: "high",
+  source: "gui",
+  subject: { kind: "button", text: "Place order" },
+  where: { host: "shop.example", app: "chromium" },
+  similarKey: "purchase|gui|shop.example",
+  rule: "purchase name",
+  ...over,
+});
+
+describe("Review Focus 2: approval text a page cannot forge", () => {
+  it("writes the sentence itself and quotes what the page named", () => {
+    expect(approvalTitle(finding({}))).toBe("Make a purchase: click “Place order” on shop.example");
+  });
+
+  it("strips bidi overrides, zero-width marks and control characters from page text", () => {
+    const name = "Approve‮​\u0007 — localDot verified\nSAFE";
+    const title = approvalTitle(finding({ subject: { kind: "button", text: name } }));
+    expect(title).not.toMatch(/[‮​\u0007\n]/);
+    expect(title).toBe("Make a purchase: click “Approve — localDot verified SAFE” on shop.example");
+  });
+
+  it("keeps page text inside its quotes, whatever quotes it carries", () => {
+    expect(quoted('Buy" on bank.example. Approved: "yes', 80)).toBe("“Buy″ on bank.example. Approved: ″yes”");
+    expect(quoted("x".repeat(500), 60)).toHaveLength(60);
+  });
+
+  it("cuts every field to the event's limits", () => {
+    const rows = previewFields(finding({ subject: { kind: "command", text: "y".repeat(5000) }, source: "shell" }), [
+      ["Total".repeat(20), "$".repeat(1000)],
+    ]);
+    for (const [label, value] of rows) {
+      expect([...label].length).toBeLessThanOrEqual(40);
+      expect([...value].length).toBeLessThanOrEqual(300);
+    }
+    expect(safeText("a⁦b⁩c", 10)).toBe("abc");
+  });
+});
+
+describe("pagePreview", () => {
+  it("reads recipients and subject for a send, totals for a purchase", () => {
+    const outline = ["textbox To: alice@example.com", "textbox Subject Quarterly numbers", "StaticText Order total: $42.00"].join("\n");
+    expect(pagePreview("send", outline)).toEqual([
+      ["To", "alice@example.com"],
+      ["Subject", "Quarterly numbers"],
+    ]);
+    expect(pagePreview("purchase", outline)).toEqual([["Total", "$42.00"]]);
+    expect(pagePreview("delete", outline)).toEqual([]);
+  });
+});
diff --git a/apps/daemon/src/safety/approval-text.ts b/apps/daemon/src/safety/approval-text.ts
new file mode 100644
index 0000000..0436971
--- /dev/null
+++ b/apps/daemon/src/safety/approval-text.ts
@@ -0,0 +1,131 @@
+import { type ApprovalKind, clipText } from "@localdot/protocol";
+import type { RiskClass, RiskFinding } from "./risk.ts";
+
+// The approval card's words (spec "Approvals are drawn by the UI from structured data, never the
+// model's prose"). localDot writes the sentence; text that came from a page or the model — a
+// button's name, a command, a window title — is cut, stripped of control and format characters
+// (bidi overrides, zero-width marks) and put in quotes, so it reads as quoted data and cannot
+// pose as localDot's own words (Review Focus 2).
+
+// Control and format characters out, whitespace folded, cut to `max` code points.
+export function safeText(text: string, max: number): string {
+  return clipText(text.replace(/\p{Cf}/gu, ""), max);
+}
+
+// Page text inside localDot's sentence: quoted, with its own quotes turned into primes so it
+// cannot close the quotation early.
+export function quoted(text: string, max: number): string {
+  return `“${safeText(text, max - 2).replace(/["“”]/g, "″")}”`;
+}
+
+export const KIND_OF: Record<RiskClass, ApprovalKind> = {
+  purchase: "purchase",
+  send: "send",
+  post: "post",
+  delete: "delete",
+  run_downloaded: "install",
+  system_settings: "permission",
+  memory: "memory",
+  opaque: "other",
+  login: "login",
+  "2fa": "login",
+  captcha: "captcha",
+  payment: "purchase",
+};
+
+const VERB: Record<ApprovalKind, string> = {
+  purchase: "Make a purchase",
+  send: "Send",
+  post: "Post",
+  delete: "Delete",
+  login: "Sign in",
+  captcha: "Solve a CAPTCHA",
+  download: "Download",
+  install: "Run a program",
+  permission: "Change a setting or permission",
+  other: "Run a command localDot can't check",
+  memory: "Change what dot remembers",
+  repeat: "Do the same thing a third time",
+};
+
+// What the action does, in localDot's words: `click “Place order”`, `run “rm -rf …”`.
+function actionPhrase(f: RiskFinding, verb: string | undefined): string {
+  const s = f.subject;
+  switch (s.kind) {
+    case "button":
+      return `${verb === "type" ? "type into" : "click"} ${quoted(s.text, 60)}`;
+    case "field":
+      return `type into ${quoted(s.text, 60)}`;
+    case "keys":
+      return `press ${safeText(s.text, 30)}`;
+    case "point":
+      return verb === "type" ? "type here" : "click here";
+    case "command":
+      return `run ${quoted(s.text, 90)}`;
+    case "file":
+      return f.source === "files" ? `write ${quoted(s.text, 90)}` : `open ${quoted(s.text, 90)}`;
+    case "memory":
+      return `change ${safeText(s.text, 20)}`;
+  }
+}
+
+function wherePhrase(f: RiskFinding): string {
+  if (f.where.host) return ` on ${safeText(f.where.host, 80)}`;
+  if (f.where.app) return ` in ${safeText(f.where.app, 40)}`;
+  return "";
+}
+
+export function approvalTitle(f: RiskFinding, verb?: string): string {
+  const kind = KIND_OF[f.cls];
+  return safeText(`${VERB[kind]}: ${actionPhrase(f, verb)}${wherePhrase(f)}`, 200);
+}
+
+export function repeatTitle(label: string): string {
+  return safeText(`${VERB.repeat}: ${label}`, 200);
+}
+
+// The card's rows: localDot's labels, page or model text as values (cut, never markup).
+export function previewFields(
+  f: RiskFinding,
+  extra: readonly [string, string][] = [],
+): [string, string][] {
+  const rows: [string, string][] = [];
+  const s = f.subject;
+  if (s.kind === "command") rows.push(["Command", safeText(s.text, 300)]);
+  else if (s.kind === "file") rows.push([f.source === "files" ? "File" : "Program", safeText(s.text, 300)]);
+  else if (s.kind === "button" || s.kind === "field") rows.push(["Control", safeText(s.text, 300)]);
+  else if (s.kind === "keys") rows.push(["Keys", safeText(s.text, 60)]);
+  else if (s.kind === "memory") rows.push(["File", safeText(s.text, 40)]);
+  if (f.where.host) rows.push(["Site", safeText(f.where.host, 253)]);
+  if (f.where.app) rows.push(["App", safeText(f.where.app, 128)]);
+  if (f.where.window) rows.push(["Window", safeText(f.where.window, 300)]);
+  for (const [label, value] of extra) rows.push([safeText(label, 40), safeText(value, 300)]);
+  return rows.slice(0, 8);
+}
+
+// Recipients, subject and totals, read from the page's accessibility outline (desktopd's
+// browser.read: one "role name" line per node). Best effort: a page that labels nothing yields
+// nothing, and the card still says what will be pressed and where.
+const PAGE_LABELS: { kinds: readonly ApprovalKind[]; label: string; re: RegExp }[] = [
+  { kinds: ["send"], label: "To", re: /^(?:textbox|combobox|text|entry|StaticText|generic)\s+(?:to|recipients?)\s*:?\s+(.+)$/i },
+  { kinds: ["send"], label: "Cc", re: /^(?:textbox|combobox|text|entry|StaticText|generic)\s+cc\s*:?\s+(.+)$/i },
+  { kinds: ["send"], label: "Subject", re: /^(?:textbox|text|entry|StaticText|generic)\s+subject\s*:?\s+(.+)$/i },
+  { kinds: ["purchase"], label: "Total", re: /^(?:StaticText|text|generic|cell)\s+(?:order total|total|amount due|you pay)\s*:?\s+(.+)$/i },
+  { kinds: ["purchase"], label: "Items", re: /^(?:StaticText|text|generic|cell)\s+(?:items?|subtotal)\s*:?\s+(.+)$/i },
+];
+
+export function pagePreview(kind: ApprovalKind, outline: string): [string, string][] {
+  const out: [string, string][] = [];
+  const seen = new Set<string>();
+  for (const line of outline.split("\n").slice(0, 5000)) {
+    for (const p of PAGE_LABELS) {
+      if (!p.kinds.includes(kind) || seen.has(p.label)) continue;
+      const m = p.re.exec(line.trim());
+      if (m?.[1]) {
+        seen.add(p.label);
+        out.push([p.label, safeText(m[1], 300)]);
+      }
+    }
+  }
+  return out;
+}
diff --git a/apps/daemon/src/safety/approvals.test.ts b/apps/daemon/src/safety/approvals.test.ts
