+import type { TakeoverEvent } from "@localdot/protocol";
+import { describe, expect, it } from "vitest";
+import { Approvals } from "./approvals.ts";
+import { ControlTower } from "./control.ts";
+import type { DesktopSnapshot } from "./handback.ts";
+import { TakeoverService } from "./takeover.ts";
+import { fakeSession, tick } from "./testing/fake-session.ts";
+
+function setup() {
+  const journal: string[] = [];
+  const session = fakeSession(journal);
+  const tower = new ControlTower();
+  const approvals = new Approvals();
+  const sent: TakeoverEvent[][] = [];
+  let now = 1_000;
+  const snapshots: DesktopSnapshot[] = [
+    {
+      windows: [{ id: 1, cls: "chromium", title: "Sign in – Chromium", active: true }],
+      page: { url: "https://accounts.example.com/signin?continue=x", title: "Sign in" },
+    },
+    {
+      windows: [
+        { id: 1, cls: "chromium", title: "Inbox – Chromium", active: true },
+        { id: 7, cls: "thunar", title: "Downloads", active: false },
+      ],
+      page: { url: "https://mail.example.com/u/0/?code=4/0AbCdEf#token=zzz", title: "Inbox" },
+    },
+  ];
+  const takeovers = new TakeoverService({
+    tower,
+    approvals,
+    snapshot: async () => snapshots.shift() ?? { windows: [] },
+    input: async (_cell, events) => {
+      journal.push(`desktopd ${events.map((e) => e.t).join(",")}`);
+      sent.push(events);
+    },
+    now: () => now,
+  });
+  return { journal, session, tower, approvals, takeovers, sent, advance: (ms: number) => (now += ms) };
+}
+
+describe("takeover and hand-back", () => {
+  it("runs a hand-off from the agent's request to the hand-back, in order", async () => {
+    const h = setup();
+    const outcome = h.takeovers.request(h.session, "login", "Please sign in", "st1");
+    await tick();
+    const req = h.takeovers.pendingRequest(h.session.id);
+    expect(req?.reason).toBe("login");
+    const { requestId, leaseId } = await h.takeovers.take(h.session, req?.requestId);
