+// Fields whose Enter sends or posts what was typed.
+export const SEND_FIELD = /\b(message|reply|chat|compose|email body|write a message|to)\b/;
+export const POST_FIELD = /\b(comment|post|tweet|what s happening|what s on your mind|status|caption)\b/;
+
+// Accessibility roles a user types into (AT-SPI and Chromium's names, normalized).
+export const EDITABLE_ROLES = new Set([
+  "entry",
+  "text",
+  "textbox",
+  "text box",
+  "searchbox",
+  "search box",
+  "password text",
