+import { describe, expect, it } from "vitest";
+import { parseEvent } from "./events.ts";
+import {
+  AutonomySettings,
+  DEFAULT_AUTONOMY,
+  effectiveLevels,
+  TakeoverEvent,
+  TakeoverSocketMessage,
+} from "./safety.ts";
+
+const base = { v: 1, id: "01J9ZQ3V8Y7X6W5T4S3R2Q1P0N", seq: 1, t: 10, agent: "main" } as const;
+const ID = "01J9ZQ3V8Y7X6W5T4S3R2Q1P0N";
+
+describe("autonomy settings", () => {
+  it("accepts only the levels each class allows", () => {
+    expect(AutonomySettings.safeParse({ v: 1, levels: { send: "act" } }).success).toBe(true);
+    for (const levels of [
+      { purchase: "act" },
+      { run_downloaded: "act" },
+      { system_settings: "act" },
+      { login: "ask" },
+      { payment: "act" },
+      { read: "ask" },
+    ]) {
+      expect(AutonomySettings.safeParse({ v: 1, levels }).success, JSON.stringify(levels)).toBe(
+        false,
+      );
+    }
+  });
+
+  it("refuses unknown classes and fields", () => {
+    expect(AutonomySettings.safeParse({ v: 1, levels: { shopping: "ask" } }).success).toBe(false);
+    expect(AutonomySettings.safeParse({ v: 1, levels: {}, extra: true }).success).toBe(false);
+    expect(AutonomySettings.safeParse({ v: 2, levels: {} }).success).toBe(false);
+  });
+
+  it("fills the classes the user left alone from the spec's defaults", () => {
+    const e = effectiveLevels({ v: 1, levels: { send: "act", purchase: "handoff" } });
+    expect(e).toEqual({ ...DEFAULT_AUTONOMY, send: "act", purchase: "handoff" });
+    expect(DEFAULT_AUTONOMY).toMatchObject({ read: "act", purchase: "ask", login: "handoff" });
+  });
+});
+
+describe("the takeover wire", () => {
+  it("takes one printable character per char event, and nothing else", () => {
+    for (const ch of ["a", "é", "€", "😀", "中"])
+      expect(TakeoverEvent.safeParse({ t: "char", ch }).success, ch).toBe(true);
+    for (const ch of ["", "ab", "\n", "\u0007", "\ud800"])
+      expect(TakeoverEvent.safeParse({ t: "char", ch }).success, JSON.stringify(ch)).toBe(false);
+  });
+
+  it("refuses keys outside the list, coordinates off any screen and oversized pastes", () => {
+    expect(TakeoverEvent.safeParse({ t: "key", key: "Return", down: true }).success).toBe(true);
+    expect(TakeoverEvent.safeParse({ t: "key", key: "Print", down: true }).success).toBe(false);
+    expect(TakeoverEvent.safeParse({ t: "key", key: "XF86LogOff", down: true }).success).toBe(
+      false,
+    );
+    expect(TakeoverEvent.safeParse({ t: "move", x: -1, y: 0 }).success).toBe(false);
+    expect(TakeoverEvent.safeParse({ t: "move", x: 1.5, y: 0 }).success).toBe(false);
+    expect(TakeoverEvent.safeParse({ t: "text", text: "x".repeat(4096) }).success).toBe(true);
+    expect(TakeoverEvent.safeParse({ t: "text", text: "x".repeat(4097) }).success).toBe(false);
+  });
+
+  it("opens a socket with a lease id and sends at most 256 events a batch", () => {
+    expect(
+      TakeoverSocketMessage.safeParse({ t: "hello", leaseId: "abcdefghijklmnopqrstuv" }).success,
+    ).toBe(true);
+    expect(TakeoverSocketMessage.safeParse({ t: "hello", leaseId: "short" }).success).toBe(false);
+    const move = { t: "move", x: 1, y: 1 };
+    expect(
+      TakeoverSocketMessage.safeParse({ t: "events", events: Array(257).fill(move) }).success,
+    ).toBe(false);
+  });
+});
+
+describe("the safety events", () => {
+  const request = {
+    approvalId: ID,
+    kind: "purchase",
+    title: 'Make a purchase: click "Place order"',
+    risk: "high",
+    source: "gui",
+    where: { host: "shop.example" },
+    preview: { fields: [["Total", "$42.00"]], frameId: ID, crop: { x: 0, y: 0, w: 10, h: 10 } },
+    similar: false,
+    timeoutMs: 600_000,
+  };
+
+  it("parses an approval request, and refuses one without its risk or timeout", () => {
+    expect(parseEvent({ ...base, type: "approval.request", data: request }).type).toBe(
+      "approval.request",
+    );
+    const { risk: _r, ...noRisk } = request;
+    expect(() => parseEvent({ ...base, type: "approval.request", data: noRisk })).toThrow();
+    const { timeoutMs: _t, ...noTimeout } = request;
+    expect(() => parseEvent({ ...base, type: "approval.request", data: noTimeout })).toThrow();
+    expect(() =>
+      parseEvent({ ...base, type: "approval.request", data: { ...request, title: "x".repeat(201) } }),
+    ).toThrow();
+  });
+
+  it("records who resolved an approval, Stop included", () => {
+    for (const by of ["user", "timeout", "stop"])
+      expect(
+        parseEvent({
+          ...base,
+          type: "approval.resolve",
+          data: { approvalId: ID, decision: "deny", by },
+        }).type,
+      ).toBe("approval.resolve");
+  });
+
+  it("keeps control.change's shape (Part 7's gate reads holder) and takes a request id", () => {
+    const e = parseEvent({
+      ...base,
+      type: "control.change",
+      data: { holder: "user", reason: "user_takeover", requestId: ID },
+    });
+    expect(e.type === "control.change" && e.data.holder).toBe("user");
+    expect(
+      parseEvent({ ...base, type: "control.change", data: { holder: "agent", reason: "resume" } })
+        .type,
+    ).toBe("control.change");
+  });
+});
diff --git a/packages/protocol/src/safety.ts b/packages/protocol/src/safety.ts
