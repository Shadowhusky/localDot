+import { describe, expect, it } from "vitest";
+import { ControlConflictError, ControlTower, UserHasControlError } from "./control.ts";
+import { deferred, tick } from "./testing/fake-session.ts";
+
+const CELL = "cell-1";
+const take = (tower: ControlTower, journal: string[]) =>
+  tower.take(CELL, { sessionId: "s", requestId: "r1", announce: () => journal.push("control.change user") });
+
+describe("Review Focus 4: a takeover racing an agent action", () => {
+  it("announces the user's control only after the agent's input in flight has finished, and no agent input starts after it", async () => {
+    const tower = new ControlTower();
+    const journal: string[] = [];
+    const press = deferred();
+    const pressing = tower.withAgentInput(CELL, async () => {
+      journal.push("agent input sent");
+      await press.promise;
+      journal.push("agent input done");
+    });
+    const taking = take(tower, journal);
+    await tick();
+    expect(tower.phase(CELL)).toBe("transferring");
+    expect(tower.agentSignal(CELL).aborted).toBe(true);
+    await expect(tower.withAgentInput(CELL, async () => journal.push("late agent input"))).rejects.toThrow(
+      UserHasControlError,
+    );
+    expect(journal).toEqual(["agent input sent"]);
+    press.resolve();
+    await pressing;
+    const { leaseId } = await taking;
+    expect(journal).toEqual(["agent input sent", "agent input done", "control.change user"]);
+    expect(leaseId).toMatch(/^[A-Za-z0-9_-]{22}$/);
+    expect(tower.canObserve(CELL)).toBe(false);
+  });
+
+  it("stops the agent's typing at its next key: the typing loop watches the agent signal", async () => {
+    const tower = new ControlTower();
+    const journal: string[] = [];
+    const typed: number[] = [];
+    const typing = tower.withAgentInput(CELL, async () => {
+      for (let k = 0; k < 1000; k++) {
+        if (tower.agentSignal(CELL).aborted) return;
+        typed.push(k);
+        await tick();
+      }
+    });
+    await tick();
+    await tick();
+    await take(tower, journal);
+    await typing;
+    const before = typed.length;
+    expect(before).toBeLessThan(10);
+    await tick();
+    expect(typed.length).toBe(before);
+  });
+
+  it("takes the user's input only with the lease, only while the user holds the screen", async () => {
+    const tower = new ControlTower();
+    const journal: string[] = [];
+    await expect(tower.withUserInput(CELL, "x".repeat(22), async () => {})).rejects.toThrow(ControlConflictError);
+    const { leaseId } = await take(tower, journal);
+    await expect(tower.withUserInput(CELL, "y".repeat(22), async () => {})).rejects.toThrow(ControlConflictError);
+    await tower.withUserInput(CELL, leaseId, async () => journal.push("user input"));
+    const renewed = tower.renewLease(CELL, "r1");
+    await expect(tower.withUserInput(CELL, leaseId, async () => {})).rejects.toThrow(ControlConflictError);
+    await tower.withUserInput(CELL, renewed, async () => journal.push("user input 2"));
+    expect(journal).toEqual(["control.change user", "user input", "user input 2"]);
+  });
+
+  it("hands back only after the user's input in flight has finished; the agent may act after the announcement", async () => {
+    const tower = new ControlTower();
+    const journal: string[] = [];
+    const { leaseId } = await take(tower, journal);
+    const key = deferred();
+    const typing = tower.withUserInput(CELL, leaseId, async () => {
+      journal.push("user key sent");
+      await key.promise;
+      journal.push("user key done");
+    });
+    const back = tower.giveBack(
+      CELL,
+      "r1",
+      async () => {
+        journal.push("release held keys");
+      },
+      () => journal.push("control.change agent"),
+    );
+    await tick();
+    await expect(tower.withUserInput(CELL, leaseId, async () => journal.push("late user key"))).rejects.toThrow(
+      ControlConflictError,
+    );
+    await expect(tower.withAgentInput(CELL, async () => {})).rejects.toThrow(UserHasControlError);
+    key.resolve();
+    await typing;
+    await back;
+    expect(journal).toEqual([
+      "control.change user",
+      "user key sent",
+      "user key done",
+      "release held keys",
+      "control.change agent",
+    ]);
+    expect(tower.agentSignal(CELL).aborted).toBe(false);
+    await tower.withAgentInput(CELL, async () => journal.push("agent input"));
+    expect(tower.epoch(CELL)).toBe(1);
+  });
+
+  it("refuses a second takeover and a hand-back of another request", async () => {
+    const tower = new ControlTower();
+    await take(tower, []);
+    await expect(take(tower, [])).rejects.toThrow(ControlConflictError);
+    await expect(tower.giveBack(CELL, "other", async () => {}, () => {})).rejects.toThrow(ControlConflictError);
+  });
+
+  it("wakes waiters when the agent gets the screen back", async () => {
+    const tower = new ControlTower();
+    await tower.whenAgent(CELL);
+    await take(tower, []);
+    let woke = false;
+    const w = tower.whenAgent(CELL).then(() => {
+      woke = true;
+    });
+    await tick();
+    expect(woke).toBe(false);
+    await tower.giveBack(CELL, "r1", async () => {}, () => {});
+    await w;
+    expect(woke).toBe(true);
+  });
+});
diff --git a/apps/daemon/src/safety/control.ts b/apps/daemon/src/safety/control.ts
new file mode 100644
index 0000000..437ec86
--- /dev/null
+++ b/apps/daemon/src/safety/control.ts
@@ -0,0 +1,206 @@
+import { randomBytes, timingSafeEqual } from "node:crypto";
+
+// One controller at a time (spec "Takeover"). Per computer, the screen is the agent's or the
+// user's, and every input path asks first:
+// - the gateway presses only inside withAgentInput, which refuses once a takeover has begun;
+// - the user's input goes in only inside withUserInput, with the lease the takeover opened.
+// Taking the screen cancels the agent's action in flight (its typing stops at the next key),
+// waits until no agent input is in flight, and only then announces control.change and opens the
+// lease. Giving it back closes the lease, waits until no user input is in flight, runs the
+// hand-back work, and only then announces (Part 7's recorder gate relies on both orders, P6-R9).
+
+export type ControlPhase = "agent" | "transferring" | "user" | "returning";
+
+export class UserHasControlError extends Error {
+  constructor() {
+    super("the user has control of the computer");
+    this.name = "UserHasControlError";
+  }
+}
+
+export class ControlConflictError extends Error {
+  constructor(message: string) {
+    super(message);
+    this.name = "ControlConflictError";
+  }
+}
+
+interface Lease {
+  id: string;
+  sessionId: string;
+  requestId: string;
+}
+
+interface CellControl {
+  phase: ControlPhase;
+  epoch: number;
+  agentAbort: AbortController;
+  agentInputs: number;
+  userInputs: number;
+  lease: Lease | undefined;
+  requestId: string | undefined;
+  waiters: Set<() => void>;
+}
+
+export class ControlTower {
+  readonly #cells = new Map<string, CellControl>();
+
+  #cell(cellId: string): CellControl {
+    let c = this.#cells.get(cellId);
+    if (!c) {
+      c = {
+        phase: "agent",
+        epoch: 0,
+        agentAbort: new AbortController(),
+        agentInputs: 0,
+        userInputs: 0,
+        lease: undefined,
+        requestId: undefined,
+        waiters: new Set(),
+      };
+      this.#cells.set(cellId, c);
+    }
+    return c;
+  }
+
+  phase(cellId: string): ControlPhase {
+    return this.#cell(cellId).phase;
+  }
+
+  holder(cellId: string): "agent" | "user" {
+    return this.#cell(cellId).phase === "agent" ? "agent" : "user";
+  }
+
+  // Bumped by every takeover: a tool call that started in another epoch spanned one.
+  epoch(cellId: string): number {
+    return this.#cell(cellId).epoch;
+  }
+
+  // The takeover that holds or is taking the screen.
+  requestId(cellId: string): string | undefined {
+    const c = this.#cell(cellId);
+    return c.phase === "agent" ? undefined : c.requestId;
+  }
+
+  // Aborted when the user takes the screen; fresh again after hand-back.
+  agentSignal(cellId: string): AbortSignal {
+    return this.#cell(cellId).agentAbort.signal;
+  }
+
+  // No screenshot reaches the model while the user has control (spec "Takeover").
+  canObserve(cellId: string): boolean {
+    return this.#cell(cellId).phase === "agent";
+  }
+
+  async withAgentInput<T>(cellId: string, fn: () => Promise<T>): Promise<T> {
+    const c = this.#cell(cellId);
+    if (c.phase !== "agent") throw new UserHasControlError();
+    c.agentInputs++;
+    try {
+      return await fn();
+    } finally {
+      c.agentInputs--;
+      this.#wake(c);
+    }
+  }
+
+  async withUserInput<T>(cellId: string, leaseId: string, fn: () => Promise<T>): Promise<T> {
+    const c = this.#cell(cellId);
+    if (c.phase !== "user" || !c.lease || !sameSecret(c.lease.id, leaseId))
+      throw new ControlConflictError("no takeover holds this lease");
+    c.userInputs++;
+    try {
+      return await fn();
+    } finally {
+      c.userInputs--;
+      this.#wake(c);
+    }
+  }
+
+  async take(
+    cellId: string,
+    opts: { sessionId: string; requestId: string; announce(): void },
+  ): Promise<{ leaseId: string }> {
+    const c = this.#cell(cellId);
+    if (c.phase !== "agent") throw new ControlConflictError("the user already has the screen");
+    c.phase = "transferring";
+    c.epoch++;
+    c.requestId = opts.requestId;
+    c.agentAbort.abort(new UserHasControlError());
+    await this.#until(c, () => c.agentInputs === 0);
+    opts.announce();
+    c.lease = { id: leaseId(), sessionId: opts.sessionId, requestId: opts.requestId };
+    c.phase = "user";
+    this.#wake(c);
+    return { leaseId: c.lease.id };
+  }
+
+  // A new lease for the same takeover (the user reopened the page): the old one stops working.
+  renewLease(cellId: string, requestId: string): string {
+    const c = this.#cell(cellId);
+    if (c.phase !== "user" || c.lease?.requestId !== requestId)
+      throw new ControlConflictError("that takeover does not hold the screen");
+    c.lease = { ...c.lease, id: leaseId() };
+    return c.lease.id;
+  }
+
+  // Hand-back: the lease closes first, the user's input in flight drains, `between` runs (release
+  // held keys, read the screen), then `announce` (control.change to the agent) and the agent may
+  // act again. `between` failing does not keep the screen from the agent.
+  async giveBack(
+    cellId: string,
+    requestId: string,
+    between: () => Promise<void>,
+    announce: () => void,
+  ): Promise<void> {
+    const c = this.#cell(cellId);
+    if (c.phase !== "user" || c.requestId !== requestId)
+      throw new ControlConflictError("that takeover does not hold the screen");
+    c.phase = "returning";
+    c.lease = undefined;
+    await this.#until(c, () => c.userInputs === 0);
+    try {
+      await between();
+    } finally {
+      announce();
+      c.phase = "agent";
+      c.requestId = undefined;
+      c.agentAbort = new AbortController();
+      this.#wake(c);
+    }
+  }
+
+  // Resolves once the agent has the screen (at once if it has), or when `signal` ends the wait.
+  whenAgent(cellId: string, signal?: AbortSignal): Promise<void> {
+    const c = this.#cell(cellId);
+    return this.#until(c, () => c.phase === "agent", signal);
+  }
+
+  #until(c: CellControl, ok: () => boolean, signal?: AbortSignal): Promise<void> {
+    if (ok() || signal?.aborted) return Promise.resolve();
+    return new Promise<void>((resolve) => {
+      const check = () => {
+        if (!ok() && !signal?.aborted) return;
+        c.waiters.delete(check);
+        signal?.removeEventListener("abort", check);
+        resolve();
+      };
+      c.waiters.add(check);
+      signal?.addEventListener("abort", check, { once: true });
+    });
+  }
+
+  #wake(c: CellControl): void {
+    for (const w of [...c.waiters]) w();
+  }
+}
+
+function leaseId(): string {
+  return randomBytes(16).toString("base64url");
+}
+
+function sameSecret(a: string, b: string): boolean {
+  const x = Buffer.from(a);
+  const y = Buffer.from(b);
+  return x.length === y.length && timingSafeEqual(x, y);
+}
diff --git a/apps/daemon/src/safety/gate.ts b/apps/daemon/src/safety/gate.ts
new file mode 100644
index 0000000..8289fe1
--- /dev/null
+++ b/apps/daemon/src/safety/gate.ts
@@ -0,0 +1,141 @@
+import type { SafetySession } from "./approvals.ts";
+import type { ControlTower } from "./control.ts";
+import type { HandBack, TakeoverService } from "./takeover.ts";
+
+// Pause and the takeover hold, at the step boundary of every tool call (P6-R10, P6-R13):
+// - before a call runs: a paused task waits for Continue; while the user holds the screen the call
+//   waits for the hand-back and is answered with it instead of running;
+// - after a call ran: while the user holds the screen its result waits, so the agent receives
+//   nothing during a takeover (spec); a call that spanned a takeover gets the hand-back too.
+// Pause takes effect when no call is in flight: never mid-typing (spec "Pause").
+
+export type Before =
+  | { kind: "run"; epoch: number }
+  | { kind: "handback"; handBack: HandBack }
+  | { kind: "stopped" };
+
+export type After = { kind: "deliver" } | { kind: "handback"; handBack: HandBack } | { kind: "stopped" };
+
+interface PauseState {
+  requested: boolean;
+  paused: boolean;
+  inFlight: number;
+  waiters: Set<() => void>;
+}
+
+export interface GateSession extends SafetySession {
+  setStatus?(status: "running" | "paused"): void;
+}
+
+export interface SafetyGateDeps {
+  tower: Pick<ControlTower, "phase" | "epoch">;
+  takeovers: Pick<TakeoverService, "waitForHandBack">;
+  // The brain's inbox: "pause" stops its next model call, "resume" lets it go on.
+  post(session: GateSession, kind: "pause" | "resume"): void;
+}
+
+export class SafetyGate {
+  readonly #pause = new Map<string, PauseState>();
+
+  constructor(private readonly deps: SafetyGateDeps) {}
+
+  #state(sessionId: string): PauseState {
+    let s = this.#pause.get(sessionId);
+    if (!s) {
+      s = { requested: false, paused: false, inFlight: 0, waiters: new Set() };
+      this.#pause.set(sessionId, s);
+    }
+    return s;
+  }
+
+  pauseState(sessionId: string): "running" | "pausing" | "paused" {
+    const s = this.#state(sessionId);
+    return s.paused ? "paused" : s.requested ? "pausing" : "running";
+  }
+
+  async before(session: GateSession, signal?: AbortSignal): Promise<Before> {
+    const p = this.#state(session.id);
+    while ((p.requested || p.paused) && !session.stopped && !signal?.aborted) await this.#wait(p, session, signal);
+    if (session.stopped || signal?.aborted) return { kind: "stopped" };
+    if (this.deps.tower.phase(session.cellId) !== "agent") {
+      const h = await this.deps.takeovers.waitForHandBack(session, signal);
+      return h && !session.stopped ? { kind: "handback", handBack: h } : { kind: "stopped" };
+    }
+    return { kind: "run", epoch: this.deps.tower.epoch(session.cellId) };
+  }
+
+  async after(session: GateSession, tool: string, epoch: number, signal?: AbortSignal): Promise<After> {
+    if (session.stopped) return { kind: "stopped" };
+    const { tower } = this.deps;
+    if (tool === "request_takeover") return { kind: "deliver" };
+    if (tower.epoch(session.cellId) === epoch && tower.phase(session.cellId) === "agent") return { kind: "deliver" };
+    const h = await this.deps.takeovers.waitForHandBack(session, signal);
+    return h && !session.stopped ? { kind: "handback", handBack: h } : { kind: "stopped" };
+  }
+
+  enter(session: GateSession): void {
+    this.#state(session.id).inFlight++;
+  }
+
+  exit(session: GateSession): void {
+    const p = this.#state(session.id);
+    p.inFlight = Math.max(0, p.inFlight - 1);
+    if (p.requested && !p.paused && p.inFlight === 0) this.#becomePaused(session, p);
+  }
+
+  pause(session: GateSession): "pausing" | "paused" | "already" {
+    const p = this.#state(session.id);
+    if (p.requested || p.paused) return "already";
+    p.requested = true;
+    this.deps.post(session, "pause");
+    if (p.inFlight === 0) {
+      this.#becomePaused(session, p);
+      return "paused";
+    }
+    return "pausing";
+  }
+
+  unpause(session: GateSession): boolean {
+    const p = this.#state(session.id);
+    if (!p.requested && !p.paused) return false;
+    const was = p.paused;
+    p.requested = false;
+    p.paused = false;
+    if (was) session.append("pause.change", { paused: false, atStepBoundary: true });
+    session.setStatus?.("running");
+    this.deps.post(session, "resume");
+    this.#wake(p);
+    return true;
+  }
+
+  end(sessionId: string): void {
+    const p = this.#pause.get(sessionId);
+    if (p) this.#wake(p);
+    this.#pause.delete(sessionId);
+  }
+
+  #becomePaused(session: GateSession, p: PauseState): void {
+    p.paused = true;
+    session.append("pause.change", { paused: true, atStepBoundary: true });
+    session.append("agent.state", { state: "paused", reason: "user" });
+    session.setStatus?.("paused");
+  }
+
+  #wait(p: PauseState, session: GateSession, signal?: AbortSignal): Promise<void> {
+    return new Promise((resolve) => {
+      const done = () => {
+        p.waiters.delete(done);
+        session.abort.signal.removeEventListener("abort", done);
+        signal?.removeEventListener("abort", done);
+        resolve();
+      };
+      p.waiters.add(done);
+      session.abort.signal.addEventListener("abort", done, { once: true });
+      signal?.addEventListener("abort", done, { once: true });
+    });
+  }
+
+  #wake(p: PauseState): void {
+    for (const w of [...p.waiters]) w();
+  }
+}
diff --git a/apps/daemon/src/safety/handback.ts b/apps/daemon/src/safety/handback.ts
new file mode 100644
index 0000000..c4cb696
--- /dev/null
+++ b/apps/daemon/src/safety/handback.ts
@@ -0,0 +1,96 @@
+import type { DesktopWindow, TakeoverEvent } from "@localdot/protocol";
+import { untrusted } from "../agent/untrusted.ts";
+import { safeText } from "./approval-text.ts";
+
+// What the agent learns when the user hands the screen back (spec "Hand-back takes an optional
+// note, and the agent receives the note, a before/after summary and a fresh screenshot"). The
+// summary is what X and Chromium say about the screen, never what the user typed: it counts
+// clicks and keys and nothing more. Window titles and pages are the screen's text, so they go
+// inside an untrusted block; a page's address keeps its origin and path only, because a query or
+// fragment can carry a login code (P6-R11).
+
+export interface DesktopSnapshot {
+  // Top-most first; the active window is flagged.
+  windows: DesktopWindow[];
+  // The desktop Chromium's current page, when Chromium runs.
+  page?: { url: string; title: string };
+}
+
+export interface UserActivity {
+  clicks: number;
+  keys: number;
+  pastes: number;
+}
+
+export function countInput(a: UserActivity, events: readonly TakeoverEvent[]): void {
+  for (const e of events) {
+    if (e.t === "button" && e.down) a.clicks++;
+    else if ((e.t === "key" && e.down) || e.t === "char") a.keys++;
+    else if (e.t === "text") a.pastes++;
+  }
+}
+
+export function pageRef(url: string): string {
+  try {
+    const u = new URL(url);
+    if (u.protocol !== "http:" && u.protocol !== "https:") return safeText(`${u.protocol}…`, 40);
+    return safeText(`${u.origin}${u.pathname}`, 200);
+  } catch {
+    return "an unreadable address";
+  }
+}
+
+export function formatDuration(ms: number): string {
+  const s = Math.round(ms / 1000);
+  if (s < 1) return "under a second";
+  if (s < 60) return `${s} s`;
+  const m = Math.floor(s / 60);
+  if (m < 60) return s % 60 ? `${m} min ${s % 60} s` : `${m} min`;
+  return `${Math.floor(m / 60)} h ${m % 60} min`;
+}
+
+const title = (w: DesktopWindow) => `“${safeText(w.title, 120).replace(/["“”]/g, "″")}”`;
+
+function screenLines(before: DesktopSnapshot | undefined, after: DesktopSnapshot | undefined): string[] {
+  const lines: string[] = [];
+  const describe = (label: string, s: DesktopSnapshot | undefined) => {
+    if (!s) return lines.push(`${label}: unknown`);
+    const active = s.windows.find((w) => w.active);
+    const parts = [active ? `window ${title(active)}` : "no active window"];
+    if (s.page) parts.push(`page ${pageRef(s.page.url)}`);
+    lines.push(`${label}: ${parts.join("; ")}`);
+  };
+  describe("Before", before);
+  describe("After", after);
+  if (before && after) {
+    const was = new Set(before.windows.map((w) => w.id));
+    const now = new Set(after.windows.map((w) => w.id));
+    const opened = after.windows.filter((w) => !was.has(w.id)).slice(0, 8);
+    const closed = before.windows.filter((w) => !now.has(w.id)).slice(0, 8);
+    if (opened.length) lines.push(`Opened: ${opened.map(title).join(", ")}`);
+    if (closed.length) lines.push(`Closed: ${closed.map(title).join(", ")}`);
+  }
+  return lines;
+}
+
+export function handBackText(o: {
+  userMs: number;
+  note?: string;
+  activity: UserActivity;
+  before?: DesktopSnapshot;
+  after?: DesktopSnapshot;
+}): string {
+  const { clicks, keys, pastes } = o.activity;
+  const did = [
+    `${clicks} click${clicks === 1 ? "" : "s"}`,
+    `${keys} key${keys === 1 ? "" : "s"}`,
+    ...(pastes ? [`${pastes} paste${pastes === 1 ? "" : "s"}`] : []),
+  ].join(", ");
+  return [
+    `The user had the screen for ${formatDuration(o.userMs)} and handed it back.`,
+    ...(o.note ? [`Their note: ${safeText(o.note, 1000)}`] : []),
+    `They made ${did}; what they typed is not shown to you.`,
+    untrusted("the screen around the user's turn", screenLines(o.before, o.after).join("\n")),
+    "Look at the new screenshot before you act.",
+  ].join("\n");
+}
diff --git a/apps/daemon/src/safety/repeat-guard.test.ts b/apps/daemon/src/safety/repeat-guard.test.ts
new file mode 100644
index 0000000..cbab631
--- /dev/null
+++ b/apps/daemon/src/safety/repeat-guard.test.ts
@@ -0,0 +1,42 @@
+import { describe, expect, it } from "vitest";
+import { fingerprintOf, REPEAT_LIMIT, RepeatGuard } from "./repeat-guard.ts";
+
+const S = "s1";
+const click = (x: number, y: number) => fingerprintOf("computer", { action: "click", point: { x, y } });
+
+describe("RepeatGuard", () => {
+  it("counts the third identical action in a row, within 12 px of the first", () => {
+    const g = new RepeatGuard();
+    expect(g.note(S, click(100, 100))).toBe(1);
+    expect(g.note(S, click(108, 104))).toBe(2);
+    expect(g.note(S, click(96, 103))).toBe(REPEAT_LIMIT);
+  });
+
+  it("does not count looking, and a different action starts a new run", () => {
+    const g = new RepeatGuard();
+    g.note(S, click(100, 100));
+    expect(g.note(S, fingerprintOf("computer", { action: "screenshot" }))).toBe(0);
+    expect(g.note(S, fingerprintOf("files", { op: "read", path: "a" }))).toBe(0);
+    expect(g.note(S, click(100, 100))).toBe(2);
+    expect(g.note(S, click(140, 100))).toBe(1);
+    expect(g.note(S, fingerprintOf("shell", { command: "ls" }))).toBe(1);
+    expect(g.note(S, fingerprintOf("shell", { command: "ls" }))).toBe(2);
+    expect(g.note(S, fingerprintOf("shell", { command: "ls -a" }))).toBe(1);
+  });
+
+  it("starts over after the user lets it through, and after a user message", () => {
+    const g = new RepeatGuard();
+    const fp = click(10, 10);
+    for (let k = 0; k < 3; k++) g.note(S, fp);
+    if (fp) g.restart(S, fp);
+    expect(g.note(S, fp)).toBe(2);
+    g.reset(S);
+    expect(g.note(S, fp)).toBe(1);
+  });
+
+  it("labels the card in localDot's words with the model's text quoted and cut", () => {
+    expect(click(640, 400)?.label).toBe("click at (640, 400)");
+    expect(fingerprintOf("shell", { command: `rm -rf ${"x".repeat(100)}` })?.label).toMatch(/^run “rm -rf x+…”$/);
+    expect(fingerprintOf("computer", { action: "type", text: "hello" })?.label).toBe("type “hello”");
+  });
+});
