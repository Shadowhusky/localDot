+import { DEFAULT_AUTONOMY, type Target } from "@localdot/protocol";
+import { describe, expect, it } from "vitest";
+import { classifyGui, classifyTool, levelFor, norm, type RiskFinding, strongest } from "./risk.ts";
+
+const target = (over: Partial<Target>): Target => ({ point: { x: 1, y: 1 }, source: "ax", ...over });
+const chromium = { id: 1, cls: "chromium", title: "Shop — Chromium", active: true };
+const thunar = { id: 2, cls: "thunar", title: "Downloads", active: true };
+const click = (name: string, url = "https://shop.example/cart", role = "button") =>
+  classifyGui({ verb: "click", target: target({ name, role, url }), window: chromium });
+const cls = (fs: RiskFinding[]) => fs.map((f) => `${f.cls}:${f.risk}`);
+
+describe("norm", () => {
+  it("folds width, case, format characters and punctuation", () => {
+    expect(norm("Ｂｕｙ​ NOW!")).toBe("buy now");
+    expect(norm("I'm not a robot")).toBe("i m not a robot");
+    expect(norm("‮redro ecalP")).toBe("redro ecalp");
+  });
+});
+
+describe("classifyGui", () => {
+  it("knows a purchase by its name, or by a confirmation on a checkout page", () => {
+    expect(cls(click("Place your order"))).toEqual(["purchase:high"]);
+    expect(cls(click("Buy now", undefined, "StaticText"))).toEqual(["purchase:high"]);
+    expect(cls(click("Ｂｕｙ​ now"))).toEqual(["purchase:high"]);
+    expect(cls(click("How to buy", "https://shop.example/help", "link"))).toEqual([]);
+    expect(cls(click("Continue", "https://shop.example/checkout/payment"))).toEqual(["purchase:high"]);
+    expect(cls(click("Continue", "https://docs.example/guide"))).toEqual([]);
+    expect(click("Place order")[0]).toMatchObject({
+      where: { host: "shop.example", app: "chromium" },
+      similarKey: "purchase|gui|shop.example",
+    });
+  });
+
+  it("knows sending, posting and deleting, and a web delete is high risk", () => {
+    expect(cls(click("Send", "https://mail.example/compose"))).toEqual(["send:medium"]);
+    expect(cls(click("Post comment", "https://forum.example/t/1"))).toEqual(["post:medium"]);
+    expect(cls(click("Delete account", "https://site.example/settings"))).toEqual(["delete:high"]);
+    const local = classifyGui({ verb: "click", target: target({ name: "Delete", role: "menu item" }), window: thunar });
+    expect(cls(local)).toEqual(["delete:medium"]);
+  });
+
+  it("hands credentials, codes, card details and CAPTCHAs to the user", () => {
+    const type = (t: Partial<Target>) =>
+      cls(classifyGui({ verb: "type", text: "x", target: target({ role: "entry", ...t }), window: chromium }));
+    expect(type({ name: "Password", secret: true })).toEqual(["login:high"]);
+    expect(type({ name: "Card number" })).toEqual(["payment:high"]);
+    expect(type({ name: "Enter verification code" })).toEqual(["2fa:high"]);
+    expect(type({ name: "Search" })).toEqual([]);
+    expect(cls(click("I'm not a robot", "https://www.google.com/recaptcha/api2/anchor", "checkbox"))).toEqual([
+      "captcha:high",
+    ]);
+  });
+
+  it("treats the settings tools and Chromium's settings pages as system settings", () => {
+    const settings = { id: 3, cls: "xfce4-settings-manager", title: "Settings", active: true };
+    expect(cls(classifyGui({ verb: "click", target: null, window: settings }))).toEqual(["system_settings:high"]);
+    expect(cls(click("Reset settings", "chrome://settings/reset"))).toContain("system_settings:high");
+    expect(cls(click("Allow"))).toEqual(["system_settings:high"]);
+  });
+
+  it("reads text typed into a terminal as a command", () => {
+    const term = { id: 4, cls: "xfce4-terminal", title: "Terminal", active: true };
+    const f = classifyGui({ verb: "type", text: "rm -rf ~\n", target: target({ role: "terminal" }), window: term });
+    expect(cls(f)).toEqual(["delete:medium"]);
+    expect(f[0]).toMatchObject({ source: "gui", similarKey: "delete|gui|xfce4-terminal" });
+  });
+
+  it("judges Enter by the field it lands in, and Delete in a file manager", () => {
+    const enter = (name: string, url = "https://chat.example/c/1") =>
+      cls(classifyGui({ verb: "key", combo: ["Return"], target: target({ name, role: "textbox", url }), window: chromium }));
+    expect(enter("Message")).toEqual(["send:medium"]);
+    expect(enter("Add a comment")).toEqual(["post:medium"]);
+    expect(enter("Search")).toEqual([]);
+    expect(enter("Promo code", "https://shop.example/checkout")).toEqual(["purchase:high"]);
+    expect(cls(classifyGui({ verb: "key", combo: ["Delete"], target: null, window: thunar }))).toEqual(["delete:medium"]);
+  });
+
+  it("knows opening a program file, and never a scroll", () => {
+    const open = (count: number) =>
+      cls(classifyGui({ verb: "click", count, target: target({ name: "setup.sh", role: "table cell" }), window: thunar }));
+    expect(open(2)).toEqual(["run_downloaded:high"]);
+    expect(open(1)).toEqual([]);
+    expect(classifyGui({ verb: "scroll", target: target({ name: "Buy" }), window: chromium })).toEqual([]);
+  });
+});
+
+describe("classifyTool", () => {
+  it("guards startup and system files, and every memory change", () => {
+    for (const path of ["~/.bashrc", "/config/.config/autostart/x.desktop", "$HOME/.ssh/authorized_keys", "/etc/hosts"])
+      expect(cls(classifyTool("files", { op: "write", path, content: "x" })), path).toEqual(["system_settings:high"]);
+    expect(classifyTool("files", { op: "write", path: "~/Documents/a.txt", content: "x" })).toEqual([]);
+    expect(classifyTool("files", { op: "read", path: "~/.bashrc" })).toEqual([]);
+    expect(cls(classifyTool("remember", { file: "MEMORY.md", op: "append", text: "x" }))).toEqual(["memory:medium"]);
+    expect(classifyTool("browser_read", {})).toEqual([]);
+  });
+});
+
+describe("levelFor and strongest", () => {
+  const f = (over: Partial<RiskFinding>): RiskFinding => ({
+    cls: "send",
+    risk: "medium",
+    source: "gui",
+    subject: { kind: "button", text: "Send" },
+    where: {},
+    similarKey: "k",
+    rule: "r",
+    ...over,
+  });
+  const levels = { ...DEFAULT_AUTONOMY, send: "act", delete: "act" } as const;
+
+  it("acts on a medium finding the user set to act only while the session is untainted", () => {
+    expect(levelFor(f({}), levels, false)).toBe("act");
+    expect(levelFor(f({}), levels, true)).toBe("ask");
+  });
+
+  it("never acts on a high-risk finding, and always hands off credentials", () => {
+    expect(levelFor(f({ cls: "delete", risk: "high" }), levels, false)).toBe("ask");
+    expect(levelFor(f({ cls: "login", risk: "high" }), levels, false)).toBe("handoff");
+    expect(levelFor(f({ cls: "purchase", risk: "high" }), DEFAULT_AUTONOMY, false)).toBe("ask");
+  });
+
+  it("asks about memory changes and unreadable commands only after untrusted input", () => {
+    expect(levelFor(f({ cls: "memory" }), DEFAULT_AUTONOMY, false)).toBe("act");
+    expect(levelFor(f({ cls: "memory" }), DEFAULT_AUTONOMY, true)).toBe("ask");
+    expect(levelFor(f({ cls: "opaque" }), DEFAULT_AUTONOMY, true)).toBe("ask");
+  });
+
+  it("puts hand-offs first, then high risk", () => {
+    expect(strongest([f({}), f({ cls: "delete", risk: "high" }), f({ cls: "payment", risk: "high" })])?.cls).toBe("payment");
+    expect(strongest([f({}), f({ cls: "delete", risk: "high" })])?.cls).toBe("delete");
+    expect(strongest([])).toBeUndefined();
+  });
+});
