diff --git a/apps/daemon/src/safety/takeover.ts b/apps/daemon/src/safety/takeover.ts
new file mode 100644
index 0000000..68d346b
--- /dev/null
+++ b/apps/daemon/src/safety/takeover.ts
@@ -0,0 +1,239 @@
+import {
+  type TakeoverEvent,
+  type TakeoverReason,
+  ulid,
+} from "@localdot/protocol";
+import type { Approvals, SafetySession } from "./approvals.ts";
+import { type ControlTower, ControlConflictError } from "./control.ts";
+import { countInput, type DesktopSnapshot, handBackText, type UserActivity } from "./handback.ts";
+
+export interface HandBack {
+  requestId: string;
+  note?: string;
+  text: string;
+}
+
+export type RequestOutcome =
+  | { kind: "handed_back"; handBack: HandBack }
+  | { kind: "declined" }
+  | { kind: "stopped" }
+  | { kind: "withdrawn" };
+
+export interface TakeoverDeps {
+  tower: ControlTower;
+  approvals: Pick<Approvals, "takeControl">;
+  // desktopd: the windows and Chromium's page, for the before/after summary.
+  snapshot(cellId: string): Promise<DesktopSnapshot>;
+  // desktopd's POST /takeover/input.
+  input(cellId: string, events: TakeoverEvent[]): Promise<void>;
+  now(): number;
+}
+
+interface Waiting {
+  requestId: string;
+  reason: TakeoverReason;
+  accept(): void;
+  decline(): void;
+}
+
+interface Active {
+  requestId: string;
+  since: number;
+  before?: DesktopSnapshot;
+  activity: UserActivity;
+  onStop?: () => void;
+}
+
+// Takeover and hand-back (spec "Takeover"). The agent asks (request_takeover, or a hand-off rule
+// for logins, 2FA, CAPTCHAs and payment fields), or the user takes the screen (Take over, or Take
+// control on an approval). While the user has it, their input goes to the computer through the
+// lease and the agent waits. Hand-back gives the agent the note, a before/after summary and,
+// through the caller, a fresh screenshot.
+export class TakeoverService {
+  readonly #waiting = new Map<string, Waiting>();
+  readonly #active = new Map<string, Active>();
+  readonly #last = new Map<string, HandBack>();
+  readonly #handBackWaiters = new Map<string, Set<(h: HandBack | undefined) => void>>();
+
+  constructor(private readonly deps: TakeoverDeps) {}
+
+  pendingRequest(sessionId: string): { requestId: string; reason: TakeoverReason } | undefined {
+    const w = this.#waiting.get(sessionId);
+    return w && { requestId: w.requestId, reason: w.reason };
+  }
+
+  activeRequest(sessionId: string): string | undefined {
+    return this.#active.get(sessionId)?.requestId;
+  }
+
+  lastHandBack(sessionId: string): HandBack | undefined {
+    return this.#last.get(sessionId);
+  }
+
+  // The agent asks for the screen and waits for the user's answer, then for the hand-back.
+  async request(
+    session: SafetySession,
+    reason: TakeoverReason,
+    note: string,
+    step?: string,
+    signal?: AbortSignal,
+  ): Promise<RequestOutcome> {
+    if (session.stopped) return { kind: "stopped" };
+    if (this.#waiting.has(session.id) || this.#active.has(session.id))
+      throw new ControlConflictError("a takeover is already open");
+    const requestId = ulid();
+    session.append("takeover.request", { requestId, reason, note }, step);
+    session.append("agent.state", { state: "waiting_user", reason: "takeover" });
+    const answered = await new Promise<RequestOutcome | "taken">((resolve) => {
+      const finish = (o: RequestOutcome | "taken") => {
+        session.abort.signal.removeEventListener("abort", onStop);
+        signal?.removeEventListener("abort", onWithdraw);
+        this.#waiting.delete(session.id);
+        resolve(o);
+      };
+      const onStop = () => {
+        session.append("takeover.end", { requestId, by: "stop" }, step);
+        finish({ kind: "stopped" });
+      };
+      // Only a request nobody has accepted is withdrawn: once the user holds the screen, losing
+      // the brain changes nothing for them (Part 5a review C1).
+      const onWithdraw = () => {
+        session.append("takeover.end", { requestId, by: "stop" }, step);
+        finish({ kind: "withdrawn" });
+      };
+      session.abort.signal.addEventListener("abort", onStop, { once: true });
+      signal?.addEventListener("abort", onWithdraw, { once: true });
+      this.#waiting.set(session.id, {
+        requestId,
+        reason,
+        accept: () => finish("taken"),
+        decline: () => finish({ kind: "declined" }),
+      });
+    });
+    if (answered !== "taken") return answered;
+    const h = await this.waitForHandBack(session);
+    return h ? { kind: "handed_back", handBack: h } : { kind: "stopped" };
+  }
+
+  // The user takes the screen: accepting the agent's request, or on their own (Take over, or
+  // Take control on an approval card, which this answers).
+  async take(session: SafetySession, requestId?: string): Promise<{ requestId: string; leaseId: string }> {
+    if (session.stopped) throw new ControlConflictError("the task has ended");
+    const waiting = this.#waiting.get(session.id);
+    if (requestId !== undefined && waiting?.requestId !== requestId)
+      throw new ControlConflictError("that takeover request is not waiting");
+    if (this.#active.has(session.id)) throw new ControlConflictError("the user already has the screen");
+    const id = waiting?.requestId ?? ulid();
+    const reason = waiting ? "handoff_request" : "user_takeover";
+    // Active first: whoever the card's answer wakes finds the takeover already open.
+    const active: Active = {
+      requestId: id,
+      since: this.deps.now(),
+      activity: { clicks: 0, keys: 0, pastes: 0 },
+    };
+    this.#active.set(session.id, active);
+    this.deps.approvals.takeControl(session.id);
+    try {
+      const before = await this.deps.snapshot(session.cellId).catch(() => undefined);
+      if (before) active.before = before;
+      const { leaseId } = await this.deps.tower.take(session.cellId, {
+        sessionId: session.id,
+        requestId: id,
+        announce: () => {
+          session.append("control.change", { holder: "user", reason, requestId: id });
+          if (!waiting) session.append("agent.state", { state: "waiting_user", reason: "takeover" });
+        },
+      });
+      waiting?.accept();
+      // Stop gives the screen back at once (the kill switch then freezes the computer).
+      active.onStop = () => void this.#end(session, id, undefined, "stop").catch(() => {});
+      session.abort.signal.addEventListener("abort", active.onStop, { once: true });
+      return { requestId: id, leaseId };
+    } catch (err) {
+      this.#active.delete(session.id);
+      throw err;
+    }
+  }
+
+  decline(session: SafetySession, requestId: string): boolean {
+    const w = this.#waiting.get(session.id);
+    if (!w || w.requestId !== requestId) return false;
+    session.append("takeover.end", { requestId, by: "user", declined: true });
+    w.decline();
+    return true;
+  }
+
+  async input(session: SafetySession, leaseId: string, events: TakeoverEvent[]): Promise<void> {
+    const active = this.#active.get(session.id);
+    await this.deps.tower.withUserInput(session.cellId, leaseId, async () => {
+      if (active) countInput(active.activity, events);
+      await this.deps.input(session.cellId, events);
+    });
+  }
+
+  handBack(session: SafetySession, requestId: string, note?: string): Promise<HandBack> {
+    return this.#end(session, requestId, note, "user");
+  }
+
+  async #end(
+    session: SafetySession,
+    requestId: string,
+    note: string | undefined,
+    by: "user" | "stop",
+  ): Promise<HandBack> {
+    const active = this.#active.get(session.id);
+    if (!active || active.requestId !== requestId)
+      throw new ControlConflictError("that takeover does not hold the screen");
+    if (active.onStop) session.abort.signal.removeEventListener("abort", active.onStop);
+    let after: DesktopSnapshot | undefined;
+    await this.deps.tower.giveBack(
+      session.cellId,
+      requestId,
+      async () => {
+        // Nothing the user still holds down stays down for the agent.
+        await this.deps.input(session.cellId, [{ t: "release" }]).catch(() => {});
+        after = await this.deps.snapshot(session.cellId).catch(() => undefined);
+      },
+      () => {
+        session.append("takeover.end", { requestId, by, ...(note ? { note } : {}) });
+        session.append("control.change", { holder: "agent", reason: "resume", requestId });
+      },
+    );
+    this.#active.delete(session.id);
+    const h: HandBack = {
+      requestId,
+      ...(note ? { note } : {}),
+      text: handBackText({
+        userMs: this.deps.now() - active.since,
+        ...(note ? { note } : {}),
+        activity: active.activity,
+        ...(active.before ? { before: active.before } : {}),
+        ...(after ? { after } : {}),
+      }),
+    };
+    this.#last.set(session.id, h);
+    for (const w of this.#handBackWaiters.get(session.id) ?? []) w(by === "stop" ? undefined : h);
+    this.#handBackWaiters.delete(session.id);
+    return h;
+  }
+
+  // Resolves with the hand-back once the user gives the screen back, or undefined on Stop.
+  waitForHandBack(session: SafetySession, signal?: AbortSignal): Promise<HandBack | undefined> {
+    if (session.stopped) return Promise.resolve(undefined);
+    if (!this.#active.has(session.id) && !this.#waiting.has(session.id))
+      return Promise.resolve(this.#last.get(session.id));
+    return new Promise((resolve) => {
+      const set = this.#handBackWaiters.get(session.id) ?? new Set();
+      const done = (h: HandBack | undefined) => {
+        set.delete(done);
+        signal?.removeEventListener("abort", aborted);
+        resolve(h);
+      };
+      const aborted = () => done(undefined);
+      set.add(done);
+      this.#handBackWaiters.set(session.id, set);
+      signal?.addEventListener("abort", aborted, { once: true });
+      session.abort.signal.addEventListener("abort", aborted, { once: true });
+    });
+  }
+}
