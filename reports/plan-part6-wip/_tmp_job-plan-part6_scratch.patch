index 0000000..eec9a83
--- /dev/null
+++ b/apps/daemon/src/safety/approvals.test.ts
@@ -0,0 +1,111 @@
+import { afterEach, describe, expect, it, vi } from "vitest";
+import { type ApprovalAsk, Approvals } from "./approvals.ts";
+import { fakeSession, tick } from "./testing/fake-session.ts";
+
+const ask = (session: ReturnType<typeof fakeSession>, over: Partial<ApprovalAsk> = {}): ApprovalAsk => ({
+  session,
+  kind: "send",
+  title: "Send: click “Send” on mail.example",
+  risk: "medium",
+  source: "gui",
+  where: { host: "mail.example" },
+  similarKey: "send|gui|mail.example",
+  ...over,
+});
+const idOf = (s: ReturnType<typeof fakeSession>) =>
+  String(s.events.findLast((e) => e.type === "approval.request")?.data.approvalId);
+
+afterEach(() => {
+  vi.useRealTimers();
+});
+
+describe("Approvals", () => {
+  it("asks once, waits, and records the answer", async () => {
+    const a = new Approvals();
+    const s = fakeSession();
+    const waiting = a.ask(ask(s, { step: "st1" }));
+    await tick();
+    expect(s.events.map((e) => e.type)).toEqual(["approval.request", "agent.state"]);
+    expect(s.events[0]).toMatchObject({ step: "st1", data: { kind: "send", similar: true, timeoutMs: 600_000 } });
+    expect(a.resolve(s.id, idOf(s), "approve")).toBe("ok");
+    expect(await waiting).toEqual({ decision: "approve", scope: "once" });
+    expect(s.events.slice(2)).toMatchObject([
+      { type: "approval.resolve", data: { decision: "approve", by: "user", scope: "once" } },
+      { type: "agent.state", data: { state: "acting" } },
+    ]);
+    expect(a.granted(s.id, "send|gui|mail.example")).toBe(false);
+  });
+
+  it("grants approve-similar for medium risk only, and never for a high-risk card", async () => {
+    const a = new Approvals();
+    const s = fakeSession();
+    const high = a.ask(ask(s, { kind: "purchase", risk: "high", similarKey: "purchase|gui|shop.example" }));
+    await tick();
+    expect(s.events[0]?.data.similar).toBe(false);
+    expect(a.resolve(s.id, idOf(s), "approve", "similar")).toBe("similar-refused");
+    expect(a.pending(s.id)).toBeDefined();
+    a.resolve(s.id, idOf(s), "deny");
+    expect(await high).toEqual({ decision: "deny", by: "user" });
+    const medium = a.ask(ask(s));
+    await tick();
+    a.resolve(s.id, idOf(s), "approve", "similar");
+    await medium;
+    expect(a.granted(s.id, "send|gui|mail.example")).toBe(true);
+    a.end(s.id);
+    expect(a.granted(s.id, "send|gui|mail.example")).toBe(false);
+  });
+
+  it("denies after 10 minutes unanswered", async () => {
+    vi.useFakeTimers();
+    const a = new Approvals();
+    const s = fakeSession();
+    const waiting = a.ask(ask(s));
+    await vi.advanceTimersByTimeAsync(600_000 - 1);
+    expect(a.pending(s.id)).toBeDefined();
+    await vi.advanceTimersByTimeAsync(1);
+    expect(await waiting).toEqual({ decision: "deny", by: "timeout" });
+    expect(s.events.find((e) => e.type === "approval.resolve")?.data).toMatchObject({ decision: "deny", by: "timeout" });
+  });
+
+  it("Review Focus 3: Stop denies a waiting card at once, and a later answer changes nothing", async () => {
+    const a = new Approvals();
+    const s = fakeSession();
+    const waiting = a.ask(ask(s));
+    await tick();
+    const id = idOf(s);
+    s.abort.abort();
+    expect(await waiting).toEqual({ decision: "deny", by: "stop" });
+    expect(a.resolve(s.id, id, "approve")).toBe("not-pending");
+    expect(s.events.filter((e) => e.type === "approval.resolve")).toHaveLength(1);
+    expect(s.events.at(-1)?.type).toBe("approval.resolve");
+    expect(await a.ask(ask(s))).toEqual({ decision: "deny", by: "stop" });
+  });
+
+  it("withdraws the card when the call that asked ends first", async () => {
+    const a = new Approvals();
+    const s = fakeSession();
+    const call = new AbortController();
+    const waiting = a.ask(ask(s, { signal: call.signal }));
+    await tick();
+    call.abort();
+    expect(await waiting).toEqual({ decision: "deny", by: "withdrawn" });
+  });
+
+  it("answers only the card that is waiting, and shows one card at a time", async () => {
+    const a = new Approvals();
+    const s = fakeSession();
+    const first = a.ask(ask(s));
+    const second = a.ask(ask(s, { title: "second" }));
+    await tick();
+    expect(s.events.filter((e) => e.type === "approval.request")).toHaveLength(1);
+    expect(a.resolve(s.id, "01J9ZQ3V8Y7X6W5T4S3R2Q1P0N", "approve")).toBe("not-pending");
+    const firstId = idOf(s);
+    a.resolve(s.id, firstId, "deny");
+    await first;
+    await tick();
+    expect(s.events.filter((e) => e.type === "approval.request")).toHaveLength(2);
+    expect(a.resolve(s.id, firstId, "approve")).toBe("not-pending");
+    expect(a.takeControl(s.id)).toBe(true);
+    expect(await second).toEqual({ decision: "take_control" });
+  });
+});
diff --git a/apps/daemon/src/safety/approvals.ts b/apps/daemon/src/safety/approvals.ts
new file mode 100644
index 0000000..b11e6bb
--- /dev/null
+++ b/apps/daemon/src/safety/approvals.ts
@@ -0,0 +1,176 @@
+import {
+  APPROVAL_TIMEOUT_MS,
+  type ApprovalKind,
+  type ApprovalSource,
+  type Rect,
+  type Target,
+  ulid,
+} from "@localdot/protocol";
+
+// What an approval needs from the agent's session (Part 5a's AgentSession has all of it).
+export interface SafetySession {
+  readonly id: string;
+  readonly cellId: string;
+  readonly stopped: boolean;
+  readonly abort: AbortController;
+  tainted: boolean;
+  append(type: string, data: Record<string, unknown>, step?: string): void;
+}
+
+export interface ApprovalAsk {
+  session: SafetySession;
+  step?: string;
+  kind: ApprovalKind;
+  title: string;
+  risk: "medium" | "high";
+  source: ApprovalSource;
+  where?: { host?: string; app?: string; window?: string };
+  preview?: { fields: [string, string][]; frameId?: string; crop?: Rect };
+  target?: Target;
+  // What "approve similar" grants for the rest of the task (medium risk only).
+  similarKey: string;
+  // The call that asked; when it ends first (its brain was lost), the approval is withdrawn.
+  signal?: AbortSignal;
+}
+
+export type ApprovalOutcome =
+  | { decision: "approve"; scope: "once" | "similar" }
+  | { decision: "deny"; by: "user" | "timeout" | "stop" | "withdrawn" }
+  | { decision: "take_control" };
+
+export type ResolveResult = "ok" | "not-pending" | "similar-refused";
+
+interface Pending {
+  approvalId: string;
+  ask: ApprovalAsk;
+  finish(o: ApprovalOutcome): void;
+}
+
+// Approvals (spec "Approvals"): one card at a time per task, drawn from the event's structured
+// fields; Approve once, Deny, Take control, and Approve similar for medium risk only. Unanswered
+// for 10 minutes means denied; Stop denies at once. A grant lasts until the task ends.
+export class Approvals {
+  readonly #pending = new Map<string, Pending>();
+  readonly #grants = new Map<string, Set<string>>();
+  readonly #queue = new Map<string, Promise<unknown>>();
+  readonly #timeoutMs: number;
+
+  constructor(opts: { timeoutMs?: number } = {}) {
+    this.#timeoutMs = opts.timeoutMs ?? APPROVAL_TIMEOUT_MS;
+  }
+
+  granted(sessionId: string, similarKey: string): boolean {
+    return this.#grants.get(sessionId)?.has(similarKey) === true;
+  }
+
+  pending(sessionId: string): { approvalId: string; similar: boolean } | undefined {
+    const p = this.#pending.get(sessionId);
+    return p && { approvalId: p.approvalId, similar: p.ask.risk === "medium" };
+  }
+
+  // Asks the user and waits. Calls from one task wait their turn: the card shows one at a time.
+  ask(a: ApprovalAsk): Promise<ApprovalOutcome> {
+    const id = a.session.id;
+    const run = (this.#queue.get(id) ?? Promise.resolve()).then(() => this.#ask(a));
+    this.#queue.set(
+      id,
+      run.catch(() => {}),
+    );
+    return run;
+  }
+
+  #ask(a: ApprovalAsk): Promise<ApprovalOutcome> {
+    const { session } = a;
+    if (session.stopped) return Promise.resolve({ decision: "deny", by: "stop" });
+    if (a.signal?.aborted) return Promise.resolve({ decision: "deny", by: "withdrawn" });
+    const approvalId = ulid();
+    const similar = a.risk === "medium";
+    session.append(
+      "approval.request",
+      {
+        approvalId,
+        kind: a.kind,
+        title: a.title,
+        risk: a.risk,
+        source: a.source,
+        ...(a.where && Object.keys(a.where).length ? { where: a.where } : {}),
+        ...(a.preview ? { preview: a.preview } : {}),
+        ...(a.target ? { target: a.target } : {}),
+        similar,
+        timeoutMs: this.#timeoutMs,
+      },
+      a.step,
+    );
+    session.append("agent.state", { state: "waiting_user", reason: "approval" });
+    return new Promise<ApprovalOutcome>((resolve) => {
+      let done = false;
+      const finish = (o: ApprovalOutcome) => {
+        if (done) return;
+        done = true;
+        clearTimeout(timer);
+        session.abort.signal.removeEventListener("abort", onStop);
+        a.signal?.removeEventListener("abort", onWithdraw);
+        this.#pending.delete(session.id);
+        const by = o.decision === "deny" ? o.by : "user";
+        session.append(
+          "approval.resolve",
+          {
+            approvalId,
+            decision: o.decision,
+            by,
+            ...(o.decision === "approve" ? { scope: o.scope } : {}),
+          },
+          a.step,
+        );
+        if (o.decision === "approve" && o.scope === "similar") {
+          const set = this.#grants.get(session.id) ?? new Set<string>();
+          set.add(a.similarKey);
+          this.#grants.set(session.id, set);
+        }
+        if (!session.stopped && o.decision !== "take_control")
+          session.append("agent.state", { state: "acting" });
+        resolve(o);
+      };
+      const onStop = () => finish({ decision: "deny", by: "stop" });
+      const onWithdraw = () => finish({ decision: "deny", by: "withdrawn" });
+      const timer = setTimeout(() => finish({ decision: "deny", by: "timeout" }), this.#timeoutMs);
+      timer.unref?.();
+      session.abort.signal.addEventListener("abort", onStop, { once: true });
+      a.signal?.addEventListener("abort", onWithdraw, { once: true });
+      this.#pending.set(session.id, { approvalId, ask: a, finish });
+    });
+  }
+
+  // The user's answer (the approvals route). Only the card that is waiting can be answered, and
+  // "similar" only where the card offered it.
+  resolve(
+    sessionId: string,
+    approvalId: string,
+    decision: "approve" | "deny" | "take_control",
+    scope: "once" | "similar" = "once",
+  ): ResolveResult {
+    const p = this.#pending.get(sessionId);
+    if (!p || p.approvalId !== approvalId) return "not-pending";
+    if (decision === "approve" && scope === "similar" && p.ask.risk !== "medium")
+      return "similar-refused";
+    if (decision === "approve") p.finish({ decision, scope });
+    else if (decision === "deny") p.finish({ decision, by: "user" });
+    else p.finish({ decision });
+    return "ok";
+  }
+
+  // The user pressed Take over while a card was waiting: the card is answered "Take control".
+  takeControl(sessionId: string): boolean {
+    const p = this.#pending.get(sessionId);
+    if (!p) return false;
+    p.finish({ decision: "take_control" });
+    return true;
+  }
+
+  // The task ended: its grants go with it.
+  end(sessionId: string): void {
+    this.#pending.get(sessionId)?.finish({ decision: "deny", by: "stop" });
+    this.#grants.delete(sessionId);
+    this.#queue.delete(sessionId);
+  }
+}
