+// The words and places localDot's risk rules recognise (spec "Risk rules": the action kind, the
+// target's role and name, the page URL and shell patterns). English only in v1 (P6-R26). A
+// one-word phrase must be a name's first word; a longer phrase may appear anywhere in it, so
+// "Buy now" and "Place your order" match but "How to buy" does not.
+
+export interface Phrases {
+  first: readonly string[];
+  anywhere: readonly string[];
+}
+
+export const PURCHASE: Phrases = {
+  first: [
+    "buy",
+    "purchase",
+    "checkout",
+    "pay",
+    "subscribe",
+    "upgrade",
+    "donate",
+    "renew",
+    "rent",
+    "preorder",
+  ],
+  anywhere: [
+    "check out",
+    "place order",
+    "place your order",
+    "complete order",
+    "complete your order",
+    "complete purchase",
+    "confirm purchase",
+    "confirm order",
+    "confirm your order",
+    "confirm and pay",
+    "submit order",
+    "order now",
+    "pay now",
+    "proceed to checkout",
+    "proceed to payment",
+    "start trial",
