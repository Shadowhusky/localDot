+import { createHash } from "node:crypto";
+import type { ToolName } from "@localdot/protocol";
+import { safeText } from "./approval-text.ts";
+
+// The guard (spec "Guards"): the same action on the same target three times in a row pauses the
+// task and asks the user. "Same target" for a pointer action is a point within 12 model pixels of
+// the run's first; looking (screenshots, zooms, waits, page reads, file reads, the plan, questions)
+// neither counts nor breaks a run. A user message starts over (P6-R17).
+
+export const REPEAT_LIMIT = 3;
+export const SAME_POINT_PX = 12;
+
+export interface Fingerprint {
+  key: string;
+  point?: { x: number; y: number };
+  // For the approval card: "click at (640, 400)", "run “ls”".
+  label: string;
+}
+
+const hash = (v: unknown) => createHash("sha256").update(JSON.stringify(v)).digest("hex").slice(0, 16);
+
+export function fingerprintOf(tool: ToolName, input: unknown): Fingerprint | null {
+  const i = input as Record<string, unknown>;
+  switch (tool) {
+    case "computer": {
+      const a = String(i.action);
+      const point = i.point as { x: number; y: number } | undefined;
+      if (a === "click" && point)
+        return {
+          key: `click|${String(i.button ?? "left")}|${String(i.count ?? 1)}`,
+          point,
+          label: `click at (${point.x}, ${point.y})`,
+        };
+      if (a === "scroll" && point)
+        return { key: `scroll|${String(i.dx ?? 0)}|${String(i.dy ?? 0)}`, point, label: `scroll at (${point.x}, ${point.y})` };
+      if (a === "type")
+        return { key: `type|${hash(i.text)}`, label: `type “${safeText(String(i.text ?? ""), 40)}”` };
+      if (a === "key") {
+        const keys = (i.keys as string[] | undefined) ?? [];
+        return { key: `key|${keys.join("+")}|${String(i.repeat ?? 1)}`, label: `press ${safeText(keys.join("+"), 40)}` };
+      }
+      return null;
+    }
+    case "shell":
+      return { key: `shell|${hash([i.command, i.cwd ?? ""])}`, label: `run “${safeText(String(i.command ?? ""), 60)}”` };
+    case "files":
+      if (i.op === "write" || i.op === "edit")
+        return {
+          key: `files|${String(i.op)}|${hash([i.path, i.content, i.old_text, i.new_text])}`,
+          label: `${String(i.op)} “${safeText(String(i.path ?? ""), 60)}”`,
+        };
+      return null;
+    case "browser_navigate":
+      return { key: `navigate|${hash(i.url)}`, label: `open “${safeText(String(i.url ?? ""), 60)}”` };
+    default:
+      return null;
+  }
+}
+
+interface Run {
+  anchor: Fingerprint;
+  count: number;
+}
+
+export class RepeatGuard {
+  readonly #runs = new Map<string, Run>();
+
+  // Records the call; returns how many times in a row it has now been made (0 for a look).
+  note(sessionId: string, fp: Fingerprint | null): number {
+    if (!fp) return 0;
+    const run = this.#runs.get(sessionId);
+    if (run && same(run.anchor, fp)) {
+      run.count++;
+      return run.count;
+    }
+    this.#runs.set(sessionId, { anchor: fp, count: 1 });
+    return 1;
+  }
+
+  // The user let the repetition through: the run starts again from this call.
+  restart(sessionId: string, fp: Fingerprint): void {
+    this.#runs.set(sessionId, { anchor: fp, count: 1 });
+  }
+
+  // The user spoke, or the task ended.
+  reset(sessionId: string): void {
+    this.#runs.delete(sessionId);
+  }
+}
+
+function same(a: Fingerprint, b: Fingerprint): boolean {
+  if (a.key !== b.key) return false;
+  if (!a.point || !b.point) return !a.point && !b.point;
+  return Math.hypot(a.point.x - b.point.x, a.point.y - b.point.y) <= SAME_POINT_PX;
+}
