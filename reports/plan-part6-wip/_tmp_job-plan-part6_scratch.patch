+import type { RiskClass, RiskFinding } from "./risk.ts";
+
+// The shell rules (spec "Risk rules": shell patterns). A command is split into simple commands
+// (`;`, `&&`, `||`, `|`, `&`, newlines), command substitutions are read as commands of their own,
+// and each simple command is judged by its program after wrappers (sudo, env, nohup, timeout,
+// xargs…). What localDot cannot read — eval, inline interpreter code, stdin fed to an
+// interpreter, unbalanced quotes — is `opaque`, which asks once the session is tainted. These
+// rules are a tripwire for an injected command, not a sandbox: the cell, keyd and the rest of
+// this policy are the boundary (P6-R19).
+
+const MAX_DEPTH = 3;
+const SEPARATORS = new Set([";", "&&", "||", "|", "|&", "&", "\n"]);
+const INTERPRETERS = new Set([
+  "sh",
+  "bash",
+  "zsh",
+  "dash",
+  "ksh",
+  "fish",
+  "python",
+  "python2",
+  "python3",
+  "node",
+  "nodejs",
+  "deno",
+  "bun",
+  "perl",
+  "ruby",
+  "php",
+  "lua",
+]);
+const SHELLS = new Set(["sh", "bash", "zsh", "dash", "ksh", "fish"]);
+const FETCHERS = new Set(["curl", "wget", "nc", "ncat", "netcat", "fetch", "aria2c", "http", "xh"]);
+const WRAPPERS_WITH_ARG: Record<string, readonly string[]> = {
+  sudo: ["-u", "-g", "-C", "-h", "-p", "-r", "-t", "-U"],
+  doas: ["-u", "-C"],
+  nice: ["-n"],
+  ionice: ["-c", "-n", "-p"],
+  timeout: ["-s", "-k", "--signal", "--kill-after"],
+  stdbuf: ["-i", "-o", "-e"],
+  watch: ["-n", "-d"],
+  xargs: ["-I", "-L", "-n", "-P", "-d", "-a", "-E", "-s"],
+  env: ["-u", "-C", "-S"],
+  chroot: [],
+  setsid: [],
+  nohup: [],
+  time: [],
+  command: [],
+  exec: [],
+  builtin: [],
+  unbuffer: [],
+};
+const SYSTEM_DIRS = /^\/(usr|bin|sbin|lib|lib64|snap|opt\/localdot)\//;
+const DOWNLOAD_DIRS = /^(~|\/config|\$HOME)\/Downloads\/|^\/(tmp|var\/tmp|dev\/shm)\//;
+const PACKAGE_FILE = /\.(deb|rpm|appimage|run|bin|exe|msi|pkg|snap|flatpak)$/i;
+const SYSTEM_TARGET = /^\/(etc|usr|boot|bin|sbin|lib|lib64|opt|var\/lib|var\/spool)\//;
+const PERSIST_TARGET =
+  /^(~|\/config|\$HOME)\/(\.(bashrc|bash_profile|bash_login|profile|zshrc|zprofile|zshenv|xprofile|xinitrc|xsessionrc|pam_environment)$|\.config\/(autostart|systemd|environment\.d|xfce4)\/|\.local\/share\/applications\/|\.ssh\/)/;
+
+export interface SimpleCommand {
+  argv: string[];
+  sudo: boolean;
+  // Output redirection targets (`>`, `>>`, `&>`, `2>`), as written.
+  redirects: string[];
+  // Fed by the previous command's output (`|`).
+  piped: boolean;
+  // Index of the pipeline this command belongs to.
+  pipeline: number;
+  // Reads a here-document or here-string.
+  heredoc: boolean;
+}
+
+export interface ParsedShell {
+  commands: SimpleCommand[];
+  opaque: string | null;
+}
+
+interface Scan {
+  words: string[][];
+  seps: string[];
+  redirects: string[][];
+  heredoc: boolean[];
+  inner: string[];
+  error: string | null;
+}
+
+// Splits one command line. Quotes and escapes follow POSIX sh; `$(…)`, backticks and process
+// substitutions are lifted out as inner commands.
+function scan(src: string): Scan {
+  const s: Scan = { words: [[]], seps: [], redirects: [[]], heredoc: [false], inner: [], error: null };
+  let word = "";
+  let inWord = false;
+  let pendingRedirect = false;
+  const here: { delim: string; tabs: boolean }[] = [];
+  const pushWord = () => {
+    if (!inWord) return;
+    if (pendingRedirect) {
+      (s.redirects.at(-1) as string[]).push(word);
+      pendingRedirect = false;
+    } else (s.words.at(-1) as string[]).push(word);
+    word = "";
+    inWord = false;
+  };
+  const endCommand = (sep: string) => {
+    pushWord();
+    s.seps.push(sep);
+    s.words.push([]);
+    s.redirects.push([]);
+    s.heredoc.push(false);
+  };
+  // Returns the index after the matching close paren of a `$(` or `<(` opened at i (i points at "(").
+  const balanced = (i: number): number => {
+    let depth = 0;
+    let q: string | null = null;
+    for (let j = i; j < src.length; j++) {
+      const c = src[j];
+      if (q) {
+        if (c === "\\" && q === '"') j++;
+        else if (c === q) q = null;
+        continue;
+      }
+      if (c === "\\") {
+        j++;
+        continue;
+      }
+      if (c === "'" || c === '"') q = c;
+      else if (c === "(") depth++;
+      else if (c === ")" && --depth === 0) return j + 1;
+    }
+    return -1;
+  };
+  let i = 0;
+  while (i < src.length) {
+    const c = src[i] as string;
+    if (c === "\\") {
+      if (src[i + 1] === "\n") {
+        i += 2;
+        continue;
+      }
+      word += src[i + 1] ?? "";
+      inWord = true;
+      i += 2;
+      continue;
+    }
+    if (c === "'") {
+      const end = src.indexOf("'", i + 1);
+      if (end < 0) return { ...s, error: "an unclosed quote" };
+      word += src.slice(i + 1, end);
+      inWord = true;
+      i = end + 1;
+      continue;
+    }
+    if (c === '"') {
+      let j = i + 1;
+      while (j < src.length && src[j] !== '"') {
+        if (src[j] === "\\") {
+          word += src[j + 1] ?? "";
+          j += 2;
+          continue;
+        }
+        if (src[j] === "$" && src[j + 1] === "(") {
+          const end = balanced(j + 1);
+          if (end < 0) return { ...s, error: "an unclosed $(" };
+          s.inner.push(src.slice(j + 2, end - 1));
+          word += "$(…)";
+          j = end;
+          continue;
+        }
+        if (src[j] === "`") {
+          const end = src.indexOf("`", j + 1);
+          if (end < 0) return { ...s, error: "an unclosed backquote" };
+          s.inner.push(src.slice(j + 1, end));
+          word += "`…`";
+          j = end + 1;
+          continue;
+        }
+        word += src[j];
+        j++;
+      }
+      if (j >= src.length) return { ...s, error: "an unclosed quote" };
+      inWord = true;
+      i = j + 1;
+      continue;
+    }
+    if ((c === "$" || c === "<" || c === ">") && src[i + 1] === "(") {
+      const end = balanced(i + 1);
+      if (end < 0) return { ...s, error: "an unclosed (" };
+      s.inner.push(src.slice(i + 2, end - 1));
+      word += "$(…)";
+      inWord = true;
+      i = end;
+      continue;
+    }
+    if (c === "`") {
+      const end = src.indexOf("`", i + 1);
+      if (end < 0) return { ...s, error: "an unclosed backquote" };
+      s.inner.push(src.slice(i + 1, end));
+      word += "`…`";
+      inWord = true;
+      i = end + 1;
+      continue;
+    }
+    if (c === "#" && !inWord) {
+      while (i < src.length && src[i] !== "\n") i++;
+      continue;
+    }
+    if (c === "\n" && here.length > 0) {
+      endCommand(c);
+      i++;
+      // Skip each pending here-document's body, in order, up to its delimiter line.
+      for (const h of here.splice(0)) {
+        for (;;) {
+          if (i >= src.length) return { ...s, error: "an unterminated here-document" };
+          const nl = src.indexOf("\n", i);
+          const line = src.slice(i, nl < 0 ? src.length : nl);
+          i = nl < 0 ? src.length : nl + 1;
+          if ((h.tabs ? line.replace(/^\t+/, "") : line) === h.delim) break;
+        }
+      }
+      continue;
+    }
+    if (c === "\n" || c === ";") {
+      endCommand(c);
+      i++;
+      continue;
+    }
+    if (c === "&" || c === "|") {
+      const two = src.slice(i, i + 2);
+      if (two === "&&" || two === "||" || two === "|&") {
+        endCommand(two);
+        i += 2;
+        continue;
+      }
+      if (c === "&" && src[i + 1] === ">") {
+        pushWord();
+        pendingRedirect = true;
+        i += src[i + 2] === ">" ? 3 : 2;
+        continue;
+      }
+      endCommand(c);
+      i++;
+      continue;
+    }
+    if (c === "<" && src[i + 1] === "<") {
+      // A here-document or here-string feeds the command data; a here-document's body (the lines
+      // after this one, up to its delimiter) is skipped at the end of the line.
+      pushWord();
+      s.heredoc[s.heredoc.length - 1] = true;
+      const herestring = src[i + 2] === "<";
+      i += herestring ? 3 : 2;
+      const tabs = !herestring && src[i] === "-";
+      if (tabs) i++;
+      while (i < src.length && /[ \t]/.test(src[i] as string)) i++;
+      let delim = "";
+      if (src[i] === "'" || src[i] === '"') {
+        const q = src[i] as string;
+        const end = src.indexOf(q, i + 1);
+        if (end < 0) return { ...s, error: "an unclosed quote" };
+        delim = src.slice(i + 1, end);
+        i = end + 1;
+      } else {
+        const start = i;
+        while (i < src.length && !/[\s;&|<>]/.test(src[i] as string)) i++;
+        delim = src.slice(start, i).replace(/\\/g, "");
+      }
+      if (!herestring) {
+        if (!delim) return { ...s, error: "a here-document without a delimiter" };
+        here.push({ delim, tabs });
+      }
+      continue;
+    }
+    if (c === ">" || (/[0-9]/.test(c) && src[i + 1] === ">" && !inWord)) {
+      pushWord();
+      let j = c === ">" ? i + 1 : i + 2;
+      if (src[j] === ">") j++;
+      if (src[j] === "&") {
+        // 2>&1 duplicates a descriptor: no file.
+        j++;
+        while (j < src.length && /[0-9-]/.test(src[j] as string)) j++;
+        i = j;
+        continue;
+      }
+      pendingRedirect = true;
+      i = j;
+      continue;
+    }
+    if (c === "<") {
+      pushWord();
+      i++;
+      // An input file is read, not run; skip its name.
+      while (i < src.length && /\s/.test(src[i] as string)) i++;
+      while (i < src.length && !/[\s;&|]/.test(src[i] as string)) i++;
+      continue;
+    }
+    if (/\s/.test(c)) {
+      pushWord();
+      i++;
+      continue;
+    }
+    word += c;
+    inWord = true;
+    i++;
+  }
+  pushWord();
+  if (here.length > 0) return { ...s, error: "an unterminated here-document" };
+  return s;
+}
+
+export function parseShell(src: string, depth = 0): ParsedShell {
+  if (depth > MAX_DEPTH) return { commands: [], opaque: "commands nested too deeply" };
+  const s = scan(src);
+  if (s.error) return { commands: [], opaque: s.error };
+  const commands: SimpleCommand[] = [];
+  let pipeline = 0;
+  for (let k = 0; k < s.words.length; k++) {
+    const argv = s.words[k] as string[];
+    const sepBefore = k > 0 ? s.seps[k - 1] : undefined;
+    const piped = sepBefore === "|" || sepBefore === "|&";
+    if (!piped && k > 0) pipeline++;
+    // Leading assignments (FOO=bar cmd) set the environment; they run nothing.
+    let a = 0;
+    while (a < argv.length && /^[A-Za-z_][A-Za-z0-9_]*=/.test(argv[a] as string)) a++;
+    const rest = argv.slice(a);
+    if (rest.length === 0 && (s.redirects[k] as string[]).length === 0) continue;
+    commands.push({
+      argv: rest,
+      sudo: false,
+      redirects: s.redirects[k] as string[],
+      piped,
+      pipeline,
+      heredoc: s.heredoc[k] as boolean,
+    });
+  }
+  let opaque: string | null = null;
+  for (const inner of s.inner) {
+    const p = parseShell(inner, depth + 1);
+    opaque ??= p.opaque;
+    for (const c of p.commands) commands.push({ ...c, pipeline: c.pipeline + 1000 * (depth + 1) });
+  }
+  return { commands, opaque };
+}
+
+const base = (p: string) => p.split("/").at(-1) ?? p;
+
+// Peels sudo, env, nohup, timeout, xargs and the like off a command; returns the real program.
+export function unwrap(argv: readonly string[]): { argv: string[]; sudo: boolean; viaXargs: boolean } {
+  let rest = [...argv];
+  let sudo = false;
+  let viaXargs = false;
+  for (let guard = 0; guard < 8 && rest.length > 0; guard++) {
+    const prog = base(rest[0] as string);
+    const withArg = WRAPPERS_WITH_ARG[prog];
+    if (!withArg) break;
+    if (prog === "sudo" || prog === "doas") sudo = true;
+    if (prog === "xargs") viaXargs = true;
+    let k = 1;
+    while (k < rest.length) {
+      const w = rest[k] as string;
+      if (w === "--") {
+        k++;
+        break;
+      }
+      if (prog === "env" && /^[A-Za-z_][A-Za-z0-9_]*=/.test(w)) {
+        k++;
+        continue;
+      }
+      if (!w.startsWith("-")) break;
+      k += withArg.includes(w) ? 2 : 1;
+    }
+    // timeout and watch take a duration or interval before the command.
+    if ((prog === "timeout" || prog === "nice") && /^[0-9.]+[smhd]?$/.test(rest[k] ?? "")) k++;
+    rest = rest.slice(k);
+  }
+  return { argv: rest, sudo, viaXargs };
+}
+
+interface Rule {
+  cls: RiskClass;
+  risk: "medium" | "high";
+  why: string;
+  // What "approve similar" covers.
+  key: string;
+}
+
+const hasFlag = (argv: readonly string[], ...flags: string[]) =>
+  argv.some((w) => flags.includes(w) || flags.some((f) => f.startsWith("--") && w.startsWith(`${f}=`)));
+
+function curlSends(argv: readonly string[]): boolean {
+  for (let k = 1; k < argv.length; k++) {
+    const w = argv[k] as string;
+    if (
+      /^--(data|data-raw|data-binary|data-urlencode|data-ascii|form|form-string|upload-file|json)(=|$)/.test(
+        w,
+      )
+    )
+      return true;
+    if (/^--request(=|$)/.test(w) || w === "-X") {
+      const m = (w.includes("=") ? w.split("=")[1] : argv[k + 1]) ?? "";
+      if (/^(post|put|patch|delete)$/i.test(m)) return true;
+    }
+    if (/^-[A-Za-z]+/.test(w) && !w.startsWith("--")) {
+      const flags = w.slice(1);
+      if (/[dFT]/.test(flags)) return true;
+      const x = flags.indexOf("X");
+      if (x >= 0) {
+        const m = flags.slice(x + 1) || (argv[k + 1] ?? "");
+        if (/^(post|put|patch|delete)$/i.test(m)) return true;
+      }
+    }
+  }
+  return false;
+}
+
+function wgetSends(argv: readonly string[]): boolean {
+  return argv.some(
+    (w, k) =>
+      /^--(post-data|post-file|body-data|body-file)(=|$)/.test(w) ||
+      /^--method=(post|put|patch|delete)$/i.test(w) ||
+      (w === "--method" && /^(post|put|patch|delete)$/i.test(argv[k + 1] ?? "")),
+  );
+}
+
+function httpieSends(argv: readonly string[]): boolean {
+  const args = argv.slice(1).filter((w) => !w.startsWith("-"));
+  if (/^(post|put|patch|delete)$/i.test(args[0] ?? "")) return true;
+  // Request items: field=value, field:=json, field@file.
+  return args.slice(1).some((w) => /^[^=:@\s/]+(:=|=|@)/.test(w));
+}
+
+const isPathLike = (w: string) => w.includes("/") || w.startsWith("~");
+const isRemoteSpec = (w: string) => /^[^/\s]*[A-Za-z0-9_.-]+:/.test(w) && !w.startsWith("/");
+
+// One simple command's findings, by its program.
+function rulesFor(cmd: SimpleCommand, pipelineHasFetch: boolean): Rule[] {
+  const { argv, sudo } = unwrap(cmd.argv);
+  const rules: Rule[] = [];
+  for (const target of cmd.redirects) {
+    if (SYSTEM_TARGET.test(target))
+      rules.push({ cls: "system_settings", risk: "high", why: `write to ${target}`, key: target });
+    else if (PERSIST_TARGET.test(target))
+      rules.push({ cls: "system_settings", risk: "high", why: `write to ${target}`, key: target });
+  }
+  if (argv.length === 0) return rules;
+  const prog0 = argv[0] as string;
+  const prog = base(prog0);
+  const sub = argv[1] ?? "";
+  const args = argv.slice(1);
+
+  // Code fed to an interpreter that localDot cannot read.
+  if (INTERPRETERS.has(prog)) {
+    const inline = args.findIndex((w) => /^-(c|e|r|E)$/.test(w) || /^--(eval|command)(=|$)/.test(w));
+    if (inline >= 0) {
+      if (SHELLS.has(prog)) {
+        const code = args[inline + 1] ?? "";
+        const inner = parseShell(code, 1);
+        if (inner.opaque) rules.push({ cls: "opaque", risk: "medium", why: inner.opaque, key: prog });
+        for (const c of inner.commands) rules.push(...rulesFor(c, false));
+        return rules;
+      }
+      rules.push({ cls: "opaque", risk: "medium", why: `inline ${prog} code`, key: prog });
+      return rules;
+    }
+    const script = args.find((w) => !w.startsWith("-"));
+    if (!script || cmd.heredoc) {
+      if (cmd.piped && pipelineHasFetch)
+        rules.push({ cls: "run_downloaded", risk: "high", why: "downloaded code piped into a program", key: prog });
+      else if (cmd.piped || cmd.heredoc)
+        rules.push({ cls: "opaque", risk: "medium", why: `code fed to ${prog}`, key: prog });
+      return rules;
+    }
+    if (DOWNLOAD_DIRS.test(script) || PACKAGE_FILE.test(script))
+      rules.push({ cls: "run_downloaded", risk: "high", why: `run ${script}`, key: script });
+    else rules.push({ cls: "run_downloaded", risk: "medium", why: `run ${script}`, key: script });
+    return rules;
+  }
+  if (prog === "eval" || prog === "source" || prog === ".") {
+    if (prog !== "eval" && sub && isPathLike(sub) && !DOWNLOAD_DIRS.test(sub))
+      rules.push({ cls: "run_downloaded", risk: "medium", why: `run ${sub}`, key: sub });
+    else rules.push({ cls: "opaque", risk: "medium", why: `${prog} runs text as commands`, key: prog });
+    return rules;
+  }
+
+  // A program run by its path, outside the system's own folders.
+  if (prog0.includes("/") && !SYSTEM_DIRS.test(prog0)) {
+    const high = DOWNLOAD_DIRS.test(prog0) || PACKAGE_FILE.test(prog0);
+    rules.push({ cls: "run_downloaded", risk: high ? "high" : "medium", why: `run ${prog0}`, key: prog0 });
+  }
+
+  // Packages: installs from the registries act (the spec lets the agent install through the
+  // proxy); a package file, a URL or a git source is a downloaded program.
+  if (prog === "dpkg" && hasFlag(args, "-i", "--install"))
+    rules.push({ cls: "run_downloaded", risk: "high", why: "install a package file", key: "dpkg" });
+  if ((prog === "apt" || prog === "apt-get") && /^(install|reinstall)$/.test(sub)) {
+    if (args.slice(1).some((w) => isPathLike(w) || PACKAGE_FILE.test(w)))
+      rules.push({ cls: "run_downloaded", risk: "high", why: "install a package file", key: prog });
+  } else if ((prog === "apt" || prog === "apt-get") && /^(remove|purge|autoremove)$/.test(sub))
+    rules.push({ cls: "delete", risk: "medium", why: `${prog} ${sub}`, key: `${prog} ${sub}` });
+  if (/^(pip|pip3|uv|pipx)$/.test(prog) && /^(install|add)$/.test(sub)) {
+    if (args.slice(1).some((w) => isPathLike(w) || /^(git\+|https?:)/.test(w) || PACKAGE_FILE.test(w)))
+      rules.push({ cls: "run_downloaded", risk: "high", why: "install from a file or URL", key: prog });
+  }
+  if (/^(npm|pnpm|yarn|bun)$/.test(prog) && /^(install|i|add)$/.test(sub)) {
+    if (args.slice(1).some((w) => isPathLike(w) || /^(git\+|https?:|github:)/.test(w)))
+      rules.push({ cls: "run_downloaded", risk: "high", why: "install from a file or URL", key: prog });
+  }
+  if (/^(npx|bunx|uvx)$/.test(prog) || (prog === "pipx" && sub === "run") || (/^(pnpm|yarn)$/.test(prog) && sub === "dlx"))
+    rules.push({ cls: "run_downloaded", risk: "medium", why: `${prog} runs a package`, key: `${prog} ${args.find((w) => !w.startsWith("-") && w !== "run" && w !== "dlx") ?? ""}` });
+
+  // Deleting.
+  if (/^(rm|rmdir|unlink|shred|srm|wipe|trash|trash-put|trash-empty|truncate)$/.test(prog))
+    rules.push({ cls: "delete", risk: "medium", why: prog, key: prog });
+  if (prog === "gio" && /^(trash|remove)$/.test(sub))
+    rules.push({ cls: "delete", risk: "medium", why: `gio ${sub}`, key: "gio" });
+  if (prog === "find" && args.some((w, k) => w === "-delete" || ((w === "-exec" || w === "-execdir") && /^(rm|shred|unlink)$/.test(base(args[k + 1] ?? "")))))
+    rules.push({ cls: "delete", risk: "medium", why: "find deletes", key: "find" });
+  if (prog === "git" && ((sub === "clean" && args.some((w) => /^-[a-zA-Z]*f/.test(w))) || (sub === "reset" && args.includes("--hard"))))
+    rules.push({ cls: "delete", risk: "medium", why: `git ${sub}`, key: `git ${sub}` });
+  if (prog === "mv" && args.at(-1) === "/dev/null")
+    rules.push({ cls: "delete", risk: "medium", why: "mv to /dev/null", key: "mv" });
+
+  // Sending and posting.
+  if (prog === "curl" && curlSends(argv)) rules.push({ cls: "send", risk: "medium", why: "curl sends data", key: "curl" });
+  if (prog === "wget" && wgetSends(argv)) rules.push({ cls: "send", risk: "medium", why: "wget sends data", key: "wget" });
+  if (/^(http|https|xh|xhs)$/.test(prog) && httpieSends(argv))
+    rules.push({ cls: "send", risk: "medium", why: `${prog} sends data`, key: prog });
+  if (/^(scp|sftp|ftp|ssh|sshpass|nc|ncat|netcat|socat|telnet|mail|mailx|sendmail|mutt|msmtp|swaks|s3cmd)$/.test(prog))
+    rules.push({ cls: "send", risk: "medium", why: prog, key: prog });
+  if (prog === "rsync" && args.some((w) => !w.startsWith("-") && (isRemoteSpec(w) || w.startsWith("rsync://"))))
+    rules.push({ cls: "send", risk: "medium", why: "rsync to another computer", key: "rsync" });
+  if (prog === "rclone" && /^(copy|copyto|sync|move|moveto)$/.test(sub))
+    rules.push({ cls: "send", risk: "medium", why: `rclone ${sub}`, key: "rclone" });
+  if (prog === "aws" && sub === "s3" && /^(cp|sync|mv)$/.test(argv[2] ?? ""))
+    rules.push({ cls: "send", risk: "medium", why: "aws s3", key: "aws s3" });
+  if (prog === "git" && /^(push|send-email)$/.test(sub))
+    rules.push({ cls: "post", risk: "medium", why: `git ${sub}`, key: `git ${sub}` });
+  if (
+    prog === "gh" &&
+    (args.some((w) => /^(create|comment|edit|delete|merge|close|review|upload|reopen)$/.test(w)) ||
+      (sub === "api" && args.some((w, k) => (w === "-X" || w === "--method") && /^(post|put|patch|delete)$/i.test(args[k + 1] ?? ""))) ||
+      (sub === "api" && hasFlag(args, "-f", "-F", "--field", "--raw-field", "--input")))
+  )
+    rules.push({ cls: "post", risk: "medium", why: "gh changes GitHub", key: "gh" });
+
+  // The computer's own settings.
+  const SETTINGS_PROGRAMS =
+    /^(su|passwd|chpasswd|chsh|usermod|useradd|userdel|groupadd|groupmod|visudo|systemctl|service|update-alternatives|update-rc\.d|iptables|ip6tables|nft|ufw|mount|umount|modprobe|insmod|rmmod|timedatectl|hostnamectl|localectl|chattr|setcap|at)$/;
+  if (SETTINGS_PROGRAMS.test(prog)) rules.push({ cls: "system_settings", risk: "high", why: prog, key: prog });
+  if (prog === "crontab" && !args.includes("-l"))
+    rules.push({ cls: "system_settings", risk: "high", why: "crontab", key: "crontab" });
+  if (prog === "xfconf-query" && hasFlag(args, "-s", "--set", "-r", "--reset", "-n", "--create"))
+    rules.push({ cls: "system_settings", risk: "high", why: "xfconf-query changes a setting", key: "xfconf-query" });
+  if (prog === "gsettings" && /^(set|reset|reset-recursively)$/.test(sub))
+    rules.push({ cls: "system_settings", risk: "high", why: "gsettings", key: "gsettings" });
+  if (prog === "dconf" && /^(write|reset|load)$/.test(sub))
+    rules.push({ cls: "system_settings", risk: "high", why: "dconf", key: "dconf" });
+  if (prog === "sysctl" && args.some((w) => w === "-w" || w.includes("=")))
+    rules.push({ cls: "system_settings", risk: "high", why: "sysctl", key: "sysctl" });
+  if (prog === "xdg-settings" && sub === "set")
+    rules.push({ cls: "system_settings", risk: "high", why: "xdg-settings", key: "xdg-settings" });
+  if (/^(chmod|chown|chgrp)$/.test(prog) && args.some((w) => !w.startsWith("-") && w.startsWith("/") && !/^\/(config|tmp)(\/|$)/.test(w)))
+    rules.push({ cls: "system_settings", risk: "high", why: `${prog} outside home`, key: prog });
+  if (prog === "tee" && args.some((w) => SYSTEM_TARGET.test(w) || PERSIST_TARGET.test(w)))
+    rules.push({ cls: "system_settings", risk: "high", why: "tee into a system file", key: "tee" });
+  if (prog === "cp" || prog === "mv" || prog === "ln" || prog === "install") {
+    const dest = args.filter((w) => !w.startsWith("-")).at(-1) ?? "";
+    if (SYSTEM_TARGET.test(dest) || PERSIST_TARGET.test(dest))
+      rules.push({ cls: "system_settings", risk: "high", why: `${prog} into ${dest}`, key: `${prog} ${dest}` });
+  }
+  // sudo itself: anything run as root but a registry install changes the system.
+  const registryInstall =
+    (prog === "apt" || prog === "apt-get") && /^(install|update|upgrade|full-upgrade)$/.test(sub);
+  if (sudo && !registryInstall && !rules.some((r) => r.cls === "system_settings"))
+    rules.push({ cls: "system_settings", risk: "high", why: `sudo ${prog}`, key: `sudo ${prog}` });
+  return rules;
+}
+
+export function classifyShell(command: string): RiskFinding[] {
+  const parsed = parseShell(command);
+  const out: RiskFinding[] = [];
+  const finding = (r: Rule): RiskFinding => ({
+    cls: r.cls,
+    risk: r.risk,
+    source: "shell",
+    subject: { kind: "command", text: command },
+    where: {},
+    similarKey: `${r.cls}|shell|${r.key}`,
+    rule: r.why,
+  });
+  if (parsed.opaque)
+    out.push(finding({ cls: "opaque", risk: "medium", why: parsed.opaque, key: "unreadable" }));
+  const fetchIn = new Set<number>();
+  for (const c of parsed.commands) {
+    const prog = base(unwrap(c.argv).argv[0] ?? "");
+    if (FETCHERS.has(prog) || (prog === "base64" && c.argv.some((w) => w === "-d" || w === "--decode")))
+      fetchIn.add(c.pipeline);
+  }
+  for (const c of parsed.commands) {
+    for (const r of rulesFor(c, fetchIn.has(c.pipeline))) out.push(finding(r));
+  }
+  return out;
+}
