+]);
+export const BROWSER_APPS = new Set(["chromium", "chromium-browser", "google-chrome"]);
+export const FILE_MANAGERS = new Set(["thunar", "nautilus", "pcmanfm", "nemo"]);
+export const TERMINAL_APPS = new Set([
+  "xfce4-terminal",
+  "xterm",
+  "uxterm",
+  "gnome-terminal-server",
+  "terminator",
+  "kitty",
+  "alacritty",
+  "konsole",
