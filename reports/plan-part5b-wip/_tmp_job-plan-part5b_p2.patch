@@ -0,0 +1,39 @@
+// What the chat says instead of sending a key (Review Focus 1). It names the kind of key and never
+// shows it; the buttons act on the text where it sits.
+export interface KeyFoundProps {
+  label: string | null;
+  onSave(): void;
+  onRemove?(): void;
+  onSendAnyway?(): void;
+  onEdit(): void;
+}
+
+export function KeyFound({ label, onSave, onRemove, onSendAnyway, onEdit }: KeyFoundProps) {
+  return (
+    <div className="key-found" role="alert">
+      <p>
+        {label
+          ? `That looks like ${label}. dot never gets keys: they stay in keyd on this Mac, and the computer gets a stand-in.`
+          : "This might be a key or a password. dot never needs one: keys stay in keyd, under Keys."}
+      </p>
+      <div className="key-found-acts">
+        <button type="button" className="card-btn" onClick={onSave}>
+          Save it in Keys
+        </button>
+        {onRemove && (
+          <button type="button" className="card-btn quiet" onClick={onRemove}>
+            Remove it and send
+          </button>
+        )}
+        {onSendAnyway && (
+          <button type="button" className="card-btn quiet" onClick={onSendAnyway}>
+            Send anyway
+          </button>
+        )}
+        <button type="button" className="card-btn quiet" onClick={onEdit}>
+          Keep editing
+        </button>
+      </div>
+    </div>
+  );
+}
diff --git a/apps/web/src/agent/key-guard.ts b/apps/web/src/agent/key-guard.ts
new file mode 100644
index 0000000..7d215e1
--- /dev/null
+++ b/apps/web/src/agent/key-guard.ts
@@ -0,0 +1,100 @@
+import { findKeyLike, type KeyLikeKind, type KeyLikeMatch } from "@localdot/protocol";
+import { providerById } from "@localdot/providers";
+import type { Provider } from "../keys/binding.ts";
+
+// Text the user is about to send dot, checked for keys (Review Focus 1). A known key shape is
+// refused outright (the daemon refuses it too); a long random-looking token is asked about, since
+// some providers' keys (Mistral's, Cohere's, Azure's) have no prefix to tell them by.
+export type GuardResult =
+  | { kind: "clear" }
+  | { kind: "key"; matches: KeyLikeMatch[] }
+  | { kind: "maybe"; spans: { start: number; end: number }[] };
+
+// A run of 32 to 512 key characters that is not a hex digest, a UUID or a path, has letters and
+// digits, and is about as random as base62 text (Shannon entropy of at least 4.2 bits a character;
+// English identifiers and words stay well below).
+const TOKEN = /(?<![A-Za-z0-9_\-/.=+])[A-Za-z0-9_\-+/=]{32,512}(?![A-Za-z0-9_\-+/=])/g;
+const HEX = /^[0-9a-fA-F-]+$/;
+
+function entropy(s: string): number {
+  const counts = new Map<string, number>();
+  for (const c of s) counts.set(c, (counts.get(c) ?? 0) + 1);
+  let h = 0;
+  for (const n of counts.values()) {
+    const p = n / s.length;
+    h -= p * Math.log2(p);
+  }
+  return h;
+}
+
+export function findMaybeKey(text: string): { start: number; end: number }[] {
+  const spans: { start: number; end: number }[] = [];
+  TOKEN.lastIndex = 0;
+  for (let m = TOKEN.exec(text); m; m = TOKEN.exec(text)) {
+    const t = m[0];
+    if (HEX.test(t) || t.includes("/") || !/[0-9]/.test(t) || !/[A-Za-z]/.test(t)) continue;
+    if (entropy(t) >= 4.2) spans.push({ start: m.index, end: m.index + t.length });
+  }
+  return spans;
+}
+
+export function guardText(text: string): GuardResult {
+  const matches = findKeyLike(text);
+  if (matches.length > 0) return { kind: "key", matches };
+  const spans = findMaybeKey(text);
+  return spans.length > 0 ? { kind: "maybe", spans } : { kind: "clear" };
+}
+
+// The text with the spans cut out and the gaps closed, for the message the user keeps.
+export function withoutSpans(text: string, spans: readonly { start: number; end: number }[]): string {
+  let out = "";
+  let at = 0;
+  for (const s of [...spans].sort((a, b) => a.start - b.start)) {
+    out += text.slice(at, s.start);
+    at = s.end;
+  }
+  return (out + text.slice(at)).replace(/[ \t]{2,}/g, " ").replace(/ +\n/g, "\n").trim();
+}
+
+// What the Keys sheet is opened with when the user saves a key from the chat. The value goes
+// into the key field's DOM value only (KeyForm.prefill), never into React state.
+export interface KeyPreset {
+  kind: "llm" | "http";
+  provider?: Provider;
+  baseURL?: string;
+  id?: string;
+  value: string;
+}
+
+const LLM: Partial<Record<KeyLikeKind, string>> = {
+  anthropic: "anthropic",
+  openrouter: "openrouter",
+  "openai-style": "openai",
+  google: "google",
+  xai: "xai",
+  groq: "groq",
+  perplexity: "perplexity",
+  fireworks: "fireworks-ai",
+  cerebras: "cerebras",
+};
+
+export function presetFor(match: KeyLikeMatch | undefined, value: string): KeyPreset {
+  const registryId = match ? LLM[match.kind] : undefined;
+  const spec = registryId ? providerById(registryId) : undefined;
+  if (!spec) return { kind: match ? "http" : "llm", value };
+  const keyd = spec.keyd as Provider;
+  return {
+    kind: "llm",
+    provider: keyd,
+    id: spec.id === "fireworks-ai" ? "fireworks" : spec.id,
+    ...(keyd === "openai-compatible" && spec.baseURL ? { baseURL: spec.baseURL } : {}),
+    value,
+  };
+}
+
+// The first free name like "anthropic", "anthropic-2", … among the stored keys.
+export function freeKeyId(base: string, taken: readonly { id: string }[]): string {
+  const ids = new Set(taken.map((k) => k.id));
+  if (!ids.has(base)) return base;
+  for (let n = 2; ; n++) if (!ids.has(`${base}-${n}`)) return `${base}-${n}`;
+}
diff --git a/apps/web/src/agent/useKeyGuard.ts b/apps/web/src/agent/useKeyGuard.ts
new file mode 100644
index 0000000..665c860
--- /dev/null
+++ b/apps/web/src/agent/useKeyGuard.ts
@@ -0,0 +1,70 @@
+import { withoutKeyLike } from "@localdot/protocol";
+import { useCallback, useRef, useState } from "react";
+import { guardText, type KeyPreset, presetFor, withoutSpans } from "./key-guard.ts";
+
+type Field = HTMLInputElement | HTMLTextAreaElement;
+
+export interface KeyGuard {
+  // What was found in the text last checked: a key's label, or null for a "maybe".
+  found: { label: string | null; sure: boolean } | null;
+  // True when the field's text may go to dot; otherwise `found` says why.
+  check(field: Field): boolean;
+  // Moves the first key out of the field into the Keys sheet, and leaves the rest of the text.
+  save(): void;
+  // Removes every key from the field's text (the caller sends what is left).
+  removeKeys(): void;
+  // Lets the next check pass a "maybe" the user confirmed.
+  allowOnce(): void;
+  dismiss(): void;
+}
+
+// Review Focus 1. The key never enters React state: it is read from the field's DOM value when
+// the user acts, handed to the Keys sheet's key field (also DOM only), and cut out of the field.
+export function useKeyGuard(onSaveKey: (preset: KeyPreset) => void): KeyGuard {
+  const [found, setFound] = useState<KeyGuard["found"]>(null);
+  const field = useRef<Field | null>(null);
+  const passOnce = useRef(false);
+
+  const check = useCallback((el: Field) => {
+    field.current = el;
+    const g = guardText(el.value);
+    if (g.kind === "clear" || (g.kind === "maybe" && passOnce.current)) {
+      passOnce.current = false;
+      setFound(null);
+      return true;
+    }
+    setFound(g.kind === "key" ? { label: g.matches[0]?.label ?? null, sure: true } : { label: null, sure: false });
+    return false;
+  }, []);
+
+  const save = useCallback(() => {
+    const el = field.current;
+    if (!el) return;
+    const text = el.value;
+    const g = guardText(text);
+    const span = g.kind === "key" ? g.matches[0] : g.kind === "maybe" ? g.spans[0] : undefined;
+    setFound(null);
+    if (!span) return;
+    const preset = presetFor(g.kind === "key" ? g.matches[0] : undefined, text.slice(span.start, span.end));
+    el.value = withoutSpans(text, [span]);
+    onSaveKey(preset);
+  }, [onSaveKey]);
+
+  const removeKeys = useCallback(() => {
+    const el = field.current;
+    if (el) el.value = withoutKeyLike(el.value);
+    setFound(null);
+  }, []);
+
+  const allowOnce = useCallback(() => {
+    passOnce.current = true;
+    setFound(null);
+  }, []);
+
+  const dismiss = useCallback(() => {
+    setFound(null);
+    field.current?.focus();
+  }, []);
+
+  return { found, check, save, removeKeys, allowOnce, dismiss };
+}
