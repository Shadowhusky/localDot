diff --git a/scripts/check-pack.mjs b/scripts/check-pack.mjs
new file mode 100644
index 0000000..17a1258
--- /dev/null
+++ b/scripts/check-pack.mjs
@@ -0,0 +1,75 @@
+import { execFileSync } from "node:child_process";
+import { readFileSync, realpathSync } from "node:fs";
+import { join, resolve } from "node:path";
+import { fileURLToPath } from "node:url";
+import { RULES } from "./check-hygiene.mjs";
+
+// The published tarball holds exactly these files, by pattern. Anything else (sources, source maps,
+// tests, dotfiles, a stray build folder) fails the release before `npm publish` runs.
+export const PACK_ALLOWLIST = [
+  /^package\.json$/,
+  /^README\.md$/,
+  /^LICENSE$/,
+  /^THIRD-PARTY\.md$/,
+  /^release\.json$/,
+  /^npm-shrinkwrap\.json$/,
+  /^bin\/localdot\.mjs$/,
+  /^dist\/(cli|daemon)\.mjs$/,
+  /^dist\/canary-scan\.py$/,
+  /^web\/dist\/index\.html$/,
+  /^web\/dist\/assets\/[A-Za-z0-9_.-]+\.(js|css|woff2|svg|png|webp)$/,
+  /^web\/dist\/assets\/licenses\/[A-Za-z0-9_.@-]+\.txt$/,
+  /^web\/vendor\/selkies\/(index\.html|icon\.png|icon-512\.png|LICENSE|NOTICE\.md)$/,
+  /^web\/vendor\/selkies\/assets\/[A-Za-z0-9_.-]+\.(js|css)$/,
+];
+
+export const MAX_FILE_BYTES = 16 * 1024 * 1024;
+
+// Beyond the repository's hygiene rules: a developer's absolute path (a bundler that inlined
+// import.meta.url, a source map) and an unreplaced build constant.
+export const PACK_RULES = [
+  { name: "developer path", pattern: /\/Volumes\/|\/Users\/[A-Za-z0-9._-]+\// },
+  { name: "unset build constant", pattern: /__LOCALDOT_[A-Z_]+__/ },
+];
+
+export function packFiles(dir) {
+  const out = execFileSync("npm", ["pack", "--dry-run", "--json", "--ignore-scripts"], {
+    cwd: dir,
+    encoding: "utf8",
+    stdio: ["ignore", "pipe", "pipe"],
+  });
+  const [entry] = JSON.parse(out);
+  return entry.files.map((f) => ({ path: f.path, size: f.size }));
+}
+
+export function checkPack(dir, { rules = [...RULES, ...PACK_RULES], files = packFiles(dir) } = {}) {
+  const problems = [];
+  for (const { path, size } of files) {
+    if (!PACK_ALLOWLIST.some((p) => p.test(path))) {
+      problems.push(`${path}: not in the allowlist`);
+      continue;
+    }
+    if (size > MAX_FILE_BYTES) problems.push(`${path}: ${size} bytes is over ${MAX_FILE_BYTES}`);
+    const bytes = readFileSync(join(dir, path));
+    if (bytes.subarray(0, 8000).includes(0)) continue;
+    const text = bytes.toString("utf8");
+    for (const rule of rules) {
+      if (rule.pattern.test(text) || rule.pattern.test(path))
+        problems.push(`${path}: ${rule.name}`);
+    }
+  }
+  for (const required of ["release.json", "npm-shrinkwrap.json"]) {
+    if (!files.some((f) => f.path === required)) problems.push(`${required}: missing`);
+  }
+  return problems;
+}
+
+if (
+  process.argv[1] &&
+  realpathSync(process.argv[1]) === realpathSync(fileURLToPath(import.meta.url))
+) {
+  const dir = resolve(process.argv[2] ?? "apps/cli/pkg");
+  const problems = checkPack(dir);
+  for (const p of problems) console.error(`pack: ${p}`);
+  process.exit(problems.length > 0 ? 1 : 0);
+}
diff --git a/scripts/check-pack.test.mjs b/scripts/check-pack.test.mjs
new file mode 100644
index 0000000..0bf75bc
--- /dev/null
+++ b/scripts/check-pack.test.mjs
@@ -0,0 +1,108 @@
+import { mkdirSync, mkdtempSync, writeFileSync } from "node:fs";
+import { tmpdir } from "node:os";
+import { dirname, join } from "node:path";
+import { describe, expect, it } from "vitest";
+import { checkPack, packFiles } from "./check-pack.mjs";
+
+const FILES = {
+  "package.json": JSON.stringify({
+    name: "localdot",
+    version: "1.0.0",
+    files: ["bin/", "dist/", "web/", "release.json", "THIRD-PARTY.md", "npm-shrinkwrap.json"],
+  }),
+  "README.md": "# localDot\n",
+  LICENSE: "MIT\n",
+  "THIRD-PARTY.md": "# Third-party\n",
+  "release.json": "{}\n",
+  "npm-shrinkwrap.json": "{}\n",
+  "bin/localdot.mjs": "#!/usr/bin/env node\n",
+  "dist/cli.mjs": 'export const teamId = "TESTTEAM01";\n',
+  "dist/daemon.mjs": "export {};\n",
+  "web/dist/index.html": "<!doctype html>\n",
+  "web/dist/assets/index-Ab12.js": "console.log(1);\n",
+  "web/dist/assets/licenses/mediabunny-1.61.0.txt": "Mozilla Public License Version 2.0\n",
+  "web/vendor/selkies/LICENSE": "Mozilla Public License Version 2.0\n",
+  "web/vendor/selkies/NOTICE.md": "# Selkies\n",
+  "web/vendor/selkies/assets/selkies-core-X1.js": "export {};\n",
+};
+
+function pkg(extra = {}, files = FILES) {
+  const dir = mkdtempSync(join(tmpdir(), "local dot's pack-"));
+  for (const [path, text] of Object.entries({ ...files, ...extra })) {
+    mkdirSync(dirname(join(dir, path)), { recursive: true });
+    writeFileSync(join(dir, path), text);
+  }
+  return dir;
+}
+
+describe("the published tarball (Review Focus 4: anything outside the allowlist)", () => {
+  it("passes a package that holds only allowlisted, clean files", () => {
+    const dir = pkg();
+    expect(
+      packFiles(dir)
+        .map((f) => f.path)
+        .sort(),
+    ).toEqual(Object.keys(FILES).sort());
+    expect(checkPack(dir)).toEqual([]);
+  });
+
+  it.each([
+    ["a TypeScript source", "dist/main.ts", "export {};"],
+    ["a source map", "dist/cli.mjs.map", "{}"],
+    ["a test", "dist/cli.test.mjs", ""],
+    ["an env file", "dist/.env", "KEY=1"],
+    ["a stray folder", "web/src/App.tsx", ""],
+    ["a nested dependency", "web/node_modules/x/index.js", ""],
+  ])("fails on %s that npm would pack", (_label, path, text) => {
+    const dir = pkg(
+      { [path]: text },
+      { ...FILES, "package.json": JSON.stringify({ name: "localdot", version: "1.0.0" }) },
+    );
+    const problems = checkPack(dir);
+    expect(
+      packFiles(dir).some((f) => f.path === path),
+      `npm packs ${path}`,
+    ).toBe(true);
+    expect(problems).toContain(`${path}: not in the allowlist`);
+  });
+
+  it("fails on a key-shaped secret, a developer path or an unset build constant in a packed file", () => {
+    const key = ["sk", "proj", "y".repeat(40)].join("-");
+    const dir = pkg({
+      "dist/daemon.mjs": `const k = "${key}";\nconst p = "/Volumes/Disk/Projects/x";\n`,
+      "dist/cli.mjs": `const team = ${["__LOCALDOT", "TEAM_ID__"].join("_")};\n`,
+    });
+    expect(checkPack(dir)).toEqual(
+      expect.arrayContaining([
+        "dist/daemon.mjs: OpenAI-style key",
+        "dist/daemon.mjs: developer path",
+        "dist/cli.mjs: unset build constant",
+      ]),
+    );
+  });
+
+  it("applies the private-name rule to content and paths", () => {
+    const rules = [{ name: "private theme name", pattern: /zzprivatezz/i }];
+    const dir = pkg({
+      "web/dist/assets/zzprivatezz.png": "x",
+      "web/dist/assets/a.js": "ZZPRIVATEZZ",
+    });
+    expect(checkPack(dir, { rules })).toEqual(
+      expect.arrayContaining([
+        "web/dist/assets/zzprivatezz.png: private theme name",
+        "web/dist/assets/a.js: private theme name",
+      ]),
+    );
+  });
+
+  it("fails when release.json or the shrinkwrap is missing, or a file is too large", () => {
+    const { "release.json": _r, "npm-shrinkwrap.json": _s, ...rest } = FILES;
+    expect(checkPack(pkg({}, rest))).toEqual(
+      expect.arrayContaining(["release.json: missing", "npm-shrinkwrap.json: missing"]),
+    );
+    const files = [{ path: "dist/daemon.mjs", size: 17 * 1024 * 1024 }];
+    expect(checkPack(pkg(), { files, rules: [] })[0]).toMatch(
+      /dist\/daemon.mjs: \d+ bytes is over/,
+    );
+  });
+});
diff --git a/scripts/release/verify-tag.sh b/scripts/release/verify-tag.sh
new file mode 100755
index 0000000..4a98655
--- /dev/null
+++ b/scripts/release/verify-tag.sh
@@ -0,0 +1,24 @@
+#!/usr/bin/env bash
+# verify-tag.sh <tag>: refuses to release unless <tag> is an annotated tag of the form vX.Y.Z or
+# vX.Y.Z-rc.N, signed with a key listed in .github/allowed_signers, pointing at the checked-out
+# commit, whose version is apps/cli/package.json's. Run from the repository root.
+set -euo pipefail
+
+fail() {
+  echo "release: $*" >&2
+  exit 1
+}
+
+tag="${1:-}"
+[[ "$tag" =~ ^v(0|[1-9][0-9]*)\.(0|[1-9][0-9]*)\.(0|[1-9][0-9]*)(-rc\.(0|[1-9][0-9]*))?$ ]] ||
+  fail "'$tag' is not vX.Y.Z or vX.Y.Z-rc.N"
+[ "$(git cat-file -t "refs/tags/$tag" 2>/dev/null)" = "tag" ] ||
+  fail "$tag is not an annotated tag (a lightweight tag cannot be signed)"
+[ -s .github/allowed_signers ] || fail ".github/allowed_signers is missing"
+git -c gpg.format=ssh -c gpg.ssh.program=ssh-keygen -c gpg.ssh.allowedSignersFile=.github/allowed_signers verify-tag "$tag" >/dev/null 2>&1 ||
+  fail "$tag is not signed by a key in .github/allowed_signers"
+[ "$(git rev-parse "refs/tags/$tag^{commit}")" = "$(git rev-parse HEAD)" ] ||
+  fail "$tag does not point at the checked-out commit"
+version="$(node -p 'require("./apps/cli/package.json").version')"
+[ "v$version" = "$tag" ] || fail "$tag does not match apps/cli/package.json's version $version"
+echo "release: $tag is signed and matches $version"
diff --git a/scripts/release/verify-tag.test.mjs b/scripts/release/verify-tag.test.mjs
new file mode 100644
index 0000000..13e76e6
--- /dev/null
+++ b/scripts/release/verify-tag.test.mjs
@@ -0,0 +1,106 @@
+import { execFileSync, spawnSync } from "node:child_process";
+import { mkdirSync, mkdtempSync, readFileSync, writeFileSync } from "node:fs";
+import { tmpdir } from "node:os";
+import { join } from "node:path";
+import { fileURLToPath } from "node:url";
+import { beforeAll, describe, expect, it } from "vitest";
+
+const SCRIPT = fileURLToPath(new URL("./verify-tag.sh", import.meta.url));
+const run = (cwd, cmd, args, env = {}) =>
+  execFileSync(cmd, args, {
+    cwd,
+    encoding: "utf8",
+    env: { ...process.env, ...env },
+    stdio: ["ignore", "pipe", "pipe"],
+  });
+
+function key(dir, name) {
+  const path = join(dir, name);
+  run(dir, "ssh-keygen", ["-q", "-t", "ed25519", "-N", "", "-C", name, "-f", path]);
+  return { path, pub: readFileSync(`${path}.pub`, "utf8").trim() };
+}
+
+// A repository at version 1.2.3 whose allowed_signers lists the maintainer's key only.
+function repo(version = "1.2.3") {
+  const dir = mkdtempSync(join(tmpdir(), "local dot's release-"));
+  const git = (...args) => run(dir, "git", args);
+  git("init", "-q", "-b", "main");
+  git("config", "user.name", "Release Test");
+  git("config", "user.email", "release@test.invalid");
+  git("config", "gpg.format", "ssh");
+  git("config", "gpg.ssh.program", "ssh-keygen");
+  git("config", "commit.gpgsign", "false");
+  git("config", "tag.gpgsign", "false");
+  mkdirSync(join(dir, "apps", "cli"), { recursive: true });
+  mkdirSync(join(dir, ".github"));
+  writeFileSync(join(dir, "apps", "cli", "package.json"), JSON.stringify({ version }));
+  writeFileSync(
+    join(dir, ".github", "allowed_signers"),
+    `release@test.invalid namespaces="git" ${maintainer.pub}\n`,
+  );
+  git("add", ".");
+  git("commit", "-q", "-m", "chore: release");
+  return { dir, git };
+}
+
+const verify = (dir, tag) => spawnSync("bash", [SCRIPT, tag], { cwd: dir, encoding: "utf8" });
+let maintainer;
+let stranger;
+
+beforeAll(() => {
+  const keys = mkdtempSync(join(tmpdir(), "local dot's keys-"));
+  maintainer = key(keys, "maintainer");
+  stranger = key(keys, "stranger");
+});
+
+describe("verify-tag.sh (signed tags)", () => {
+  it("accepts an annotated tag signed by an allowed key, at HEAD, matching the version", () => {
+    const { dir, git } = repo();
+    git("-c", `user.signingkey=${maintainer.path}`, "tag", "-s", "-m", "v1.2.3", "v1.2.3");
+    const r = verify(dir, "v1.2.3");
+    expect(r.stderr).toBe("");
+    expect(r.status).toBe(0);
+  });
+
+  it.each([
+    [
+      "an unsigned annotated tag",
+      (git) => git("tag", "-a", "-m", "v1.2.3", "v1.2.3"),
+      /not signed/,
+    ],
+    ["a lightweight tag", (git) => git("tag", "v1.2.3"), /not an annotated tag/],
+    [
+      "a tag signed by a stranger",
+      (git) => git("-c", `user.signingkey=${stranger.path}`, "tag", "-s", "-m", "v1.2.3", "v1.2.3"),
+      /not signed by a key/,
+    ],
+  ])("refuses %s", (_label, make, message) => {
+    const { dir, git } = repo();
+    make(git);
+    const r = verify(dir, "v1.2.3");
+    expect(r.status).toBe(1);
+    expect(r.stderr).toMatch(message);
+  });
+
+  it("refuses a signed tag on another commit, or for another version", () => {
+    const { dir, git } = repo();
+    git("-c", `user.signingkey=${maintainer.path}`, "tag", "-s", "-m", "v1.2.3", "v1.2.3");
+    writeFileSync(join(dir, "x"), "x");
+    git("add", "x");
+    git("commit", "-q", "-m", "chore: later");
+    expect(verify(dir, "v1.2.3").stderr).toMatch(/does not point at the checked-out commit/);
+    const other = repo("1.2.4");
+    other.git("-c", `user.signingkey=${maintainer.path}`, "tag", "-s", "-m", "v1.2.3", "v1.2.3");
+    expect(verify(other.dir, "v1.2.3").stderr).toMatch(
+      /does not match apps\/cli\/package.json's version 1.2.4/,
+    );
+  });
+
+  it.each(["1.2.3", "v1.2", "v01.2.3", "v1.2.3-beta", "v1.2.3;rm"])(
+    "refuses the tag name %j",
+    (tag) => {
+      const { dir } = repo();
+      expect(verify(dir, tag).stderr).toMatch(/is not vX.Y.Z/);
+    },
+  );
+});
