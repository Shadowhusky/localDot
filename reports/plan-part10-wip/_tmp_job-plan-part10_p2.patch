@@ -0,0 +1,116 @@
+import { mkdtempSync } from "node:fs";
+import { tmpdir } from "node:os";
+import { join } from "node:path";
+import { describe, expect, it } from "vitest";
+import { createApp } from "../app.ts";
+import { EventLog } from "../event-log.ts";
+import { CODE_TTL_MS, InstallCodes } from "./install-codes.ts";
+
+const PORT = 4750;
+const TOKEN = "t".repeat(43);
+const ORIGIN = `http://127.0.0.1:${PORT}`;
+const eventLog = new EventLog(mkdtempSync(join(tmpdir(), "local dot's auth-")));
+
+function setup(now = () => 1_000_000) {
+  const codes = new InstallCodes({ now });
+  const app = createApp({ token: TOKEN, port: PORT, eventLog, codes });
+  const mint = async () => {
+    const res = await app.request(`${ORIGIN}/api/install-codes`, {
+      method: "POST",
+      headers: { authorization: `Bearer ${TOKEN}` },
+    });
+    expect(res.status).toBe(201);
+    expect(res.headers.get("cache-control")).toBe("no-store");
+    return ((await res.json()) as { code: string }).code;
+  };
+  const exchange = (body: unknown, headers: Record<string, string> = {}) =>
+    app.request(`${ORIGIN}/auth/exchange`, {
+      method: "POST",
+      headers: { origin: ORIGIN, "content-type": "application/json", ...headers },
+      body: typeof body === "string" ? body : JSON.stringify(body),
+    });
+  return { app, codes, mint, exchange };
+}
+
+describe("one-time install links (Review Focus 3: an install link replayed or leaked)", () => {
+  it("mints only for the token holder", async () => {
+    const { app } = setup();
+    const res = await app.request(`${ORIGIN}/api/install-codes`, { method: "POST" });
+    expect(res.status).toBe(401);
+  });
+
+  it("exchanges a fresh code for the token once, and refuses the replay", async () => {
+    const { mint, exchange } = setup();
+    const code = await mint();
+    const first = await exchange({ code });
+    expect(first.status).toBe(200);
+    expect(first.headers.get("cache-control")).toBe("no-store");
+    expect(await first.json()).toEqual({ token: TOKEN });
+    const replay = await exchange({ code });
+    expect(replay.status).toBe(401);
+    expect(await replay.json()).toEqual({ error: "invalid-code" });
+  });
+
+  it("refuses a code leaked from history after it expired, with the same answer as an unknown one", async () => {
+    let t = 1_000_000;
+    const { mint, exchange } = setup(() => t);
+    const code = await mint();
+    t += CODE_TTL_MS;
+    const expired = await exchange({ code });
+    const unknown = await exchange({ code: "B".repeat(43) });
+    expect(expired.status).toBe(401);
+    expect(unknown.status).toBe(401);
+    expect(await expired.text()).toBe(await unknown.text());
+  });
+
+  it("answers only a same-origin page", async () => {
+    const { app, mint, exchange } = setup();
+    const code = await mint();
+    const noOrigin = await app.request(`${ORIGIN}/auth/exchange`, {
+      method: "POST",
+      headers: { "content-type": "application/json" },
+      body: JSON.stringify({ code }),
+    });
+    expect(noOrigin.status).toBe(403);
+    for (const origin of ["http://evil.example", "null", `http://127.0.0.1:${PORT + 1}`]) {
+      expect((await exchange({ code }, { origin })).status).toBe(403);
+    }
+    expect((await exchange({ code }, { origin: `http://localhost:${PORT}` })).status).toBe(200);
+  });
+
+  it("does not spend a code on a request refused before the redeem", async () => {
+    const { mint, exchange } = setup();
+    const code = await mint();
+    expect((await exchange({ code }, { origin: "http://evil.example" })).status).toBe(403);
+    expect((await exchange({ code }, { "content-type": "text/plain" })).status).toBe(415);
+    expect((await exchange(`{"code":"${code}","pad":"${"x".repeat(2000)}"}`)).status).toBe(413);
+    expect((await exchange({ code })).status).toBe(200);
+  });
+
+  it("refuses malformed bodies with the same 401", async () => {
+    const { exchange } = setup();
+    for (const body of ["not json", "null", "[]", "{}", JSON.stringify({ code: 7 })]) {
+      const res = await exchange(body);
+      expect(res.status).toBe(401);
+      expect(await res.json()).toEqual({ error: "invalid-code" });
+    }
+  });
+
+  it("keeps the Host guard in front of the exchange", async () => {
+    const { mint, app } = setup();
+    const code = await mint();
+    const res = await app.request(`${ORIGIN}/auth/exchange`, {
+      method: "POST",
+      headers: { host: "evil.example", origin: ORIGIN, "content-type": "application/json" },
+      body: JSON.stringify({ code }),
+    });
+    expect(res.status).toBe(403);
+  });
+
+  it("a GET or the token route never hands out the token", async () => {
+    const { app } = setup();
+    expect((await app.request(`${ORIGIN}/auth/exchange`)).status).toBe(404);
+    const res = await app.request(`${ORIGIN}/api/whoami`);
+    expect(res.status).toBe(401);
+  });
+});
diff --git a/apps/daemon/src/auth/routes.ts b/apps/daemon/src/auth/routes.ts
new file mode 100644
index 0000000..560e0e4
--- /dev/null
+++ b/apps/daemon/src/auth/routes.ts
@@ -0,0 +1,48 @@
+import type { Hono } from "hono";
+import { isAllowedOrigin } from "../guard.ts";
+import type { InstallCodes } from "./install-codes.ts";
+
+export interface AuthRouteDeps {
+  token: string;
+  port: number;
+  codes: InstallCodes;
+}
+
+const NO_STORE = { "cache-control": "no-store" };
+const MAX_EXCHANGE_BODY = 1024;
+const REFUSED = { error: "invalid-code" } as const;
+
+// POST /api/install-codes sits behind the token middleware: only a holder of the token (the CLI,
+// which reads the 0600 token file) can mint a link. Register it after that middleware.
+export function installCodeRoute(app: Hono, { codes }: Pick<AuthRouteDeps, "codes">): void {
+  app.post("/api/install-codes", (c) => {
+    const { code, expiresAt } = codes.mint();
+    return c.json({ code, expiresAt }, 201, NO_STORE);
+  });
+}
+
+// POST /auth/exchange is the one route that hands out the token without it. It answers only a
+// same-origin page (a browser always sends Origin on a POST; the global guard has already checked
+// Host and any Origin against this port), and every refusal is the same 401, so it is no oracle
+// for which codes were used, expired or never minted. Register it before the token middleware.
+export function exchangeRoute(app: Hono, { token, port, codes }: AuthRouteDeps): void {
+  app.post("/auth/exchange", async (c) => {
+    const origin = c.req.header("origin");
+    if (origin === undefined || !isAllowedOrigin(origin, port)) {
+      return c.json(REFUSED, 403, NO_STORE);
+    }
+    if (!(c.req.header("content-type") ?? "").startsWith("application/json")) {
+      return c.json(REFUSED, 415, NO_STORE);
+    }
+    const text = await c.req.text();
+    if (text.length > MAX_EXCHANGE_BODY) return c.json(REFUSED, 413, NO_STORE);
+    let code: unknown;
+    try {
+      code = (JSON.parse(text) as { code?: unknown } | null)?.code;
+    } catch {
+      code = undefined;
+    }
+    if (!codes.redeem(code)) return c.json(REFUSED, 401, NO_STORE);
+    return c.json({ token }, 200, NO_STORE);
+  });
+}
