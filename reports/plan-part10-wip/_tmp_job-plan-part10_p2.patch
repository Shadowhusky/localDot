new file mode 100644
index 0000000..f6e120f
--- /dev/null
+++ b/apps/cli/src/verify/files.ts
@@ -0,0 +1,34 @@
+import { createHash } from "node:crypto";
+import { createReadStream, lstatSync, readdirSync } from "node:fs";
+import { join } from "node:path";
+import { ReleaseVerificationError } from "./errors.ts";
+
+export function sha256File(path: string): Promise<string> {
+  return new Promise((resolve, reject) => {
+    const hash = createHash("sha256");
+    createReadStream(path)
+      .on("data", (chunk) => hash.update(chunk))
+      .on("error", reject)
+      .on("end", () => resolve(hash.digest("hex")));
+  });
+}
+
+// Every regular file under root, as sorted forward-slash paths, leaving out a top-level
+// node_modules: the package's own dependencies, which npm installed from its npm-shrinkwrap.json and
+// checked against the integrity recorded there. A symlink, socket or device in a package is
+// refused: none is ever published, and a link could point a check at another file.
+export function listFiles(root: string, check: ReleaseVerificationError["check"]): string[] {
+  const out: string[] = [];
+  const walk = (rel: string) => {
+    for (const name of readdirSync(join(root, rel)).sort()) {
+      if (rel === "" && name === "node_modules") continue;
+      const path = rel ? `${rel}/${name}` : name;
+      const st = lstatSync(join(root, path));
+      if (st.isDirectory()) walk(path);
+      else if (st.isFile()) out.push(path);
+      else throw new ReleaseVerificationError(check, `${path} is not a regular file`);
+    }
+  };
+  walk("");
+  return out.sort();
+}
