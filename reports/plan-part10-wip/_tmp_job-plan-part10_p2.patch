@@ -0,0 +1,73 @@
+import { describe, expect, it } from "vitest";
+import { CODE_PATTERN, CODE_TTL_MS, InstallCodes, MAX_LIVE_CODES } from "./install-codes.ts";
+
+function clock(start = 1_000_000) {
+  let t = start;
+  return { now: () => t, advance: (ms: number) => (t += ms) };
+}
+
+describe("install codes", () => {
+  it("mints 43-character base64url codes that are all different", () => {
+    const codes = new InstallCodes();
+    const seen = new Set<string>();
+    for (let i = 0; i < 50; i++) {
+      const { code } = codes.mint();
+      expect(code).toMatch(CODE_PATTERN);
+      seen.add(code);
+      codes.redeem(code);
+    }
+    expect(seen.size).toBe(50);
+  });
+
+  it("redeems a code once: a replay is refused", () => {
+    const codes = new InstallCodes();
+    const { code } = codes.mint();
+    expect(codes.redeem(code)).toBe(true);
+    expect(codes.redeem(code)).toBe(false);
+  });
+
+  it("refuses a code at its expiry and spends it", () => {
+    const c = clock();
+    const codes = new InstallCodes({ now: c.now });
+    const { code, expiresAt } = codes.mint();
+    expect(expiresAt).toBe(c.now() + CODE_TTL_MS);
+    c.advance(CODE_TTL_MS - 1);
+    const early = codes.mint();
+    c.advance(1);
+    expect(codes.redeem(code)).toBe(false);
+    expect(codes.redeem(early.code)).toBe(true);
+  });
+
+  it("refuses unknown, malformed and non-string codes without spending a live one", () => {
+    const codes = new InstallCodes();
+    const { code } = codes.mint();
+    for (const bad of [
+      undefined,
+      null,
+      42,
+      {},
+      "",
+      "short",
+      `${code}x`,
+      code.slice(1),
+      code.replace(/./, "+"),
+    ]) {
+      expect(codes.redeem(bad)).toBe(false);
+    }
+    expect(codes.redeem("A".repeat(43))).toBe(false);
+    expect(codes.redeem(code)).toBe(true);
+  });
+
+  it("keeps at most four live codes, dropping the oldest", () => {
+    const codes = new InstallCodes();
+    const minted = Array.from({ length: MAX_LIVE_CODES + 1 }, () => codes.mint().code);
+    expect(codes.size).toBe(MAX_LIVE_CODES);
+    expect(codes.redeem(minted[0])).toBe(false);
+    for (const code of minted.slice(1)) expect(codes.redeem(code)).toBe(true);
+  });
+
+  it("refuses to mint from a short random source", () => {
+    const codes = new InstallCodes({ random: () => Buffer.alloc(16) });
+    expect(() => codes.mint()).toThrow(/too few bytes/);
+  });
+});
diff --git a/apps/daemon/src/auth/install-codes.ts b/apps/daemon/src/auth/install-codes.ts
new file mode 100644
index 0000000..6691698
--- /dev/null
+++ b/apps/daemon/src/auth/install-codes.ts
@@ -0,0 +1,72 @@
+import { createHash, randomBytes } from "node:crypto";
+
+// A one-time install link (`#code=`) is exchanged once, within CODE_TTL_MS, for the install token.
+// The browser's history then keeps only a dead code (spec, "Risks": later hardening, M9).
+export const CODE_TTL_MS = 60_000;
+export const MAX_LIVE_CODES = 4;
+// randomBytes(32) in base64url: exactly 43 characters, like the install token.
+export const CODE_PATTERN = /^[A-Za-z0-9_-]{43}$/;
+
+export interface MintedCode {
+  code: string;
+  expiresAt: number;
+}
+
+export interface InstallCodesOptions {
+  now?: () => number;
+  random?: (bytes: number) => Buffer;
+}
+
+// Codes live in memory only, as SHA-256 digests, so a heap dump or a log line never holds a live
+// one, and a daemon restart kills every outstanding link. A code is spent by its first redeem
+// attempt, whatever the outcome, and the oldest live code is dropped when a fifth is minted.
+export class InstallCodes {
+  readonly #live = new Map<string, number>();
+  readonly #now: () => number;
+  readonly #random: (bytes: number) => Buffer;
+
+  constructor({ now = Date.now, random = randomBytes }: InstallCodesOptions = {}) {
+    this.#now = now;
+    this.#random = random;
+  }
+
+  mint(): MintedCode {
+    this.#sweep();
+    while (this.#live.size >= MAX_LIVE_CODES) {
+      const oldest = this.#live.keys().next().value;
+      if (oldest === undefined) break;
+      this.#live.delete(oldest);
+    }
+    const code = this.#random(32).toString("base64url");
+    if (!CODE_PATTERN.test(code))
+      throw new Error("install code: the random source gave too few bytes");
+    const expiresAt = this.#now() + CODE_TTL_MS;
+    this.#live.set(digest(code), expiresAt);
+    return { code, expiresAt };
+  }
+
+  redeem(code: unknown): boolean {
+    this.#sweep();
+    if (typeof code !== "string" || !CODE_PATTERN.test(code)) return false;
+    const key = digest(code);
+    const expiresAt = this.#live.get(key);
+    this.#live.delete(key);
+    return expiresAt !== undefined && this.#now() < expiresAt;
+  }
+
+  get size(): number {
+    this.#sweep();
+    return this.#live.size;
+  }
+
+  #sweep(): void {
+    const now = this.#now();
+    for (const [key, expiresAt] of this.#live) {
+      if (now >= expiresAt) this.#live.delete(key);
+    }
+  }
+}
+
+function digest(code: string): string {
+  return createHash("sha256").update(code).digest("hex");
+}
