+import { chmodSync, mkdtempSync, writeFileSync } from "node:fs";
+import { tmpdir } from "node:os";
+import { join } from "node:path";
+import { describe, expect, it, vi } from "vitest";
+import { OpenLinkError, openInstallLink } from "./open-link.ts";
+
+const TOKEN = "t".repeat(43);
+const CODE = "c".repeat(43);
+
+function home(mode = 0o600) {
+  const dir = mkdtempSync(join(tmpdir(), "local dot's home-"));
+  writeFileSync(join(dir, "daemon-token"), `${TOKEN}\n`);
+  chmodSync(join(dir, "daemon-token"), mode);
+  return dir;
+}
+const answer = (status: number, body: unknown) =>
+  vi.fn(async () => new Response(JSON.stringify(body), { status }));
+
+describe("openInstallLink", () => {
+  it("mints a code with the token file and opens a #code= link that carries no token", async () => {
+    const fetchImpl = answer(201, { code: CODE, expiresAt: 1 });
+    const openUrl = vi.fn(async () => {});
+    const r = await openInstallLink({
+      home: home(),
+      port: 4750,
+      fetchImpl: fetchImpl as unknown as typeof fetch,
+      openUrl,
+    });
+    expect(r).toEqual({ url: `http://127.0.0.1:4750/#code=${CODE}`, opened: true });
+    expect(openUrl).toHaveBeenCalledWith(r.url);
+    expect(r.url).not.toContain(TOKEN);
+    const [url, init] = fetchImpl.mock.calls[0] as unknown as [string, RequestInit];
+    expect(url).toBe("http://127.0.0.1:4750/api/install-codes");
+    expect(init.headers).toEqual({ authorization: `Bearer ${TOKEN}` });
+  });
+
+  it("returns the link to print when the browser cannot be opened", async () => {
+    const r = await openInstallLink({
+      home: home(),
+      port: 4750,
+      fetchImpl: answer(201, { code: CODE }) as unknown as typeof fetch,
+      openUrl: async () => {
+        throw new Error("no GUI");
+      },
+    });
+    expect(r.opened).toBe(false);
+  });
+
+  it("refuses a token file others can read", async () => {
+    await expect(
+      openInstallLink({ home: home(0o644), port: 4750, openUrl: async () => {} }),
+    ).rejects.toThrow(/must be yours and private/);
+  });
+
+  it("says when the daemon is down or belongs to another home", async () => {
+    const down = vi.fn(async () => {
+      throw new TypeError("fetch failed");
+    });
+    await expect(
+      openInstallLink({
+        home: home(),
+        port: 4750,
+        fetchImpl: down as unknown as typeof fetch,
+        openUrl: async () => {},
+      }),
+    ).rejects.toBeInstanceOf(OpenLinkError);
+    await expect(
+      openInstallLink({
+        home: home(),
+        port: 4750,
+        fetchImpl: answer(401, "unauthorized") as unknown as typeof fetch,
+        openUrl: async () => {},
+      }),
+    ).rejects.toThrow(/another localdot home/);
+  });
+
+  it("never opens a link the daemon did not mint", async () => {
+    const openUrl = vi.fn(async () => {});
+    await expect(
+      openInstallLink({
+        home: home(),
+        port: 4750,
+        fetchImpl: answer(201, { code: "../../evil" }) as unknown as typeof fetch,
+        openUrl,
+      }),
+    ).rejects.toThrow(/no code/);
+    expect(openUrl).not.toHaveBeenCalled();
+  });
+});
diff --git a/apps/cli/src/open-link.ts b/apps/cli/src/open-link.ts
