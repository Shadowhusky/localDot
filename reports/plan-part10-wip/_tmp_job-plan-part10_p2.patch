index 0000000..1da18c2
--- /dev/null
+++ b/apps/cli/src/open-link.ts
@@ -0,0 +1,64 @@
+import { readFileSync, statSync } from "node:fs";
+import { join } from "node:path";
+
+export interface OpenLinkDeps {
+  home: string;
+  port: number;
+  fetchImpl?: typeof fetch;
+  // /usr/bin/open <url>; the code in it is spent on first use and dies in 60 s.
+  openUrl(url: string): Promise<void>;
+}
+
+export class OpenLinkError extends Error {
+  override name = "OpenLinkError";
+}
+
+// Mints a one-time link with the token file (which only this user can read) and opens it. The
+// token itself never leaves this process: not in the URL, not in output, not in an argument.
+export async function openInstallLink({
+  home,
+  port,
+  fetchImpl = fetch,
+  openUrl,
+}: OpenLinkDeps): Promise<{ url: string; opened: boolean }> {
+  const file = join(home, "daemon-token");
+  let st: ReturnType<typeof statSync>;
+  try {
+    st = statSync(file);
+  } catch {
+    throw new OpenLinkError(`no ${file}: is the daemon installed? Run: npx localdot`);
+  }
+  if ((st.mode & 0o077) !== 0 || (process.getuid && st.uid !== process.getuid())) {
+    throw new OpenLinkError(`${file} must be yours and private (chmod 600 ${file})`);
+  }
+  const token = readFileSync(file, "utf8").trim();
+  let res: Response;
+  try {
+    res = await fetchImpl(`http://127.0.0.1:${port}/api/install-codes`, {
+      method: "POST",
+      headers: { authorization: `Bearer ${token}` },
+      signal: AbortSignal.timeout(5000),
+    });
+  } catch {
+    throw new OpenLinkError(
+      `the daemon does not answer on 127.0.0.1:${port}: run localdot up, then localdot doctor`,
+    );
+  }
+  if (res.status === 401) {
+    throw new OpenLinkError(
+      `the daemon on port ${port} refused this home's token: another localdot home may be running there`,
+    );
+  }
+  if (res.status !== 201)
+    throw new OpenLinkError(`the daemon could not make a link (HTTP ${res.status})`);
+  const { code } = (await res.json()) as { code?: unknown };
+  if (typeof code !== "string" || !/^[A-Za-z0-9_-]{43}$/.test(code))
+    throw new OpenLinkError("the daemon answered with no code");
+  const url = `http://127.0.0.1:${port}/#code=${code}`;
+  try {
+    await openUrl(url);
+    return { url, opened: true };
+  } catch {
+    return { url, opened: false };
+  }
+}
