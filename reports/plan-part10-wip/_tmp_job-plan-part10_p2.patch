diff --git a/apps/cli/src/doctor/canary.test.ts b/apps/cli/src/doctor/canary.test.ts
new file mode 100644
index 0000000..fdf7441
--- /dev/null
+++ b/apps/cli/src/doctor/canary.test.ts
@@ -0,0 +1,128 @@
+import { describe, expect, it, vi } from "vitest";
+import { type CanaryDeps, MIN_BYTES, runCanary, type ScanResult } from "./canary.ts";
+
+const SURROGATE = "ld_http_surrogatefortests_ab12";
+const FULL: Omit<ScanResult, "hits"> = { processes: 40, bytes: MIN_BYTES * 2, files: 500 };
+
+function deps(over: Partial<CanaryDeps> = {}, scan?: (needles: string[]) => ScanResult) {
+  const keys = new Map<string, unknown>();
+  const d: CanaryDeps = {
+    keydSealKey: vi.fn(async () => "seal-key"),
+    putKey: vi.fn(async (b: { id: string }, sealed: unknown) => void keys.set(b.id, sealed)),
+    deleteKey: vi.fn(async (id: string) => void keys.delete(id)),
+    seal: vi.fn(async (_k: string, _b: unknown, value: string) => ({
+      sealedValueLength: value.length,
+    })),
+    readyDesktops: vi.fn(async () => [{ cellId: "c1", container: "localdot-desktop-c1" }]),
+    readSurrogate: vi.fn(async () => SURROGATE),
+    scan: vi.fn(async (_c: string, needles: string[]) =>
+      scan
+        ? scan(needles)
+        : { ...FULL, hits: [`${needles[1]}|raw|file /etc/localdot/cell/surrogates.sh`] },
+    ),
+    envName: (id: string) => `LOCALDOT_KEY_${id.toUpperCase().replaceAll("-", "_")}`,
+    sleep: async () => {},
+    ...over,
+  };
+  return { d, keys };
+}
+
+describe("doctor --canary", () => {
+  it("passes when the stand-in is found and the value is not, and removes the canary", async () => {
+    const { d, keys } = deps();
+    const v = await runCanary(d);
+    expect(v.level).toBe("ok");
+    expect(v.detail).toMatch(/no computer holds the canary \(1 computer, 40 processes, 200 MiB/);
+    const [binding] = vi.mocked(d.putKey).mock.calls[0] as unknown as [
+      { id: string; hosts: string[] },
+    ];
+    expect(binding.hosts).toEqual(["canary.localdot.example"]);
+    expect(d.deleteKey).toHaveBeenCalledWith(binding.id);
+    expect(keys.size).toBe(0);
+    const [, needles] = vi.mocked(d.scan).mock.calls[0] as unknown as [string, string[]];
+    expect(needles[0]).toMatch(/^canary-[A-Za-z0-9_-]{32}$/);
+    expect(needles[1]).toBe(SURROGATE);
+    expect(d.seal).toHaveBeenCalledWith("seal-key", binding, needles[0]);
+  });
+
+  it("fails on the real value anywhere in a computer, without printing it", async () => {
+    const { d } = deps({}, (n) => ({
+      ...FULL,
+      hits: [`${n[1]}|raw|file /etc/localdot/cell/surrogates.sh`, `${n[0]}|base64|memory pid 812`],
+    }));
+    const v = await runCanary(d);
+    expect(v.level).toBe("fail");
+    expect(v.detail).toMatch(
+      /^LEAK: computer c1 holds the canary's real value \(base64\|memory pid 812\)/,
+    );
+    const needles = (vi.mocked(d.scan).mock.calls[0] as unknown as [string, string[]])[1];
+    expect(v.detail).not.toContain(needles[0]);
+    expect(d.deleteKey).toHaveBeenCalledOnce();
+  });
+
+  it("fails closed when the scan cannot see the stand-in", async () => {
+    const { d } = deps({}, () => ({ ...FULL, hits: [] }));
+    expect((await runCanary(d)).detail).toMatch(
+      /did not find the canary's stand-in, so it is blind/,
+    );
+  });
+
+  it("fails closed when the scan covered too little", async () => {
+    const { d } = deps({}, (n) => ({
+      processes: 3,
+      bytes: 10,
+      files: 2,
+      hits: [`${n[1]}|raw|env pid 1`],
+    }));
+    expect((await runCanary(d)).detail).toMatch(/covered too little/);
+  });
+
+  it("fails closed when the computer never gets the stand-in", async () => {
+    const { d } = deps({ readSurrogate: vi.fn(async () => null) });
+    const v = await runCanary(d);
+    expect(v).toMatchObject({ level: "fail" });
+    expect(v.detail).toMatch(/never got the canary's stand-in/);
+    expect(d.scan).not.toHaveBeenCalled();
+    expect(d.deleteKey).toHaveBeenCalledOnce();
+  });
+
+  it("removes the canary when the scan throws, and keeps the value out of the error", async () => {
+    let value = "";
+    const { d } = deps({
+      scan: vi.fn(async (_c: string, needles: string[]) => {
+        value = needles[0] as string;
+        throw new Error(`python3 died near ${needles[0]}`);
+      }),
+    });
+    const v = await runCanary(d);
+    expect(v.detail).toMatch(/the canary failed: python3 died near <canary>/);
+    expect(v.detail).not.toContain(value);
+    expect(d.deleteKey).toHaveBeenCalledOnce();
+  });
+
+  it("says when the canary key could not be removed", async () => {
+    const { d } = deps({ deleteKey: vi.fn(async () => Promise.reject(new Error("offline"))) });
+    const v = await runCanary(d);
+    expect(v.level).toBe("fail");
+    expect(v.detail).toMatch(/could not be removed: remove it under Keys/);
+  });
+
+  it("plants nothing when keyd is offline or no computer runs", async () => {
+    const offline = deps({ keydSealKey: vi.fn(async () => null) }).d;
+    expect((await runCanary(offline)).level).toBe("fail");
+    const idle = deps({ readyDesktops: vi.fn(async () => []) }).d;
+    expect(await runCanary(idle)).toMatchObject({ level: "warn" });
+    expect(offline.putKey).not.toHaveBeenCalled();
+    expect(idle.putKey).not.toHaveBeenCalled();
+  });
+
+  it("uses a fresh canary every run", async () => {
+    const a = deps().d;
+    const b = deps().d;
+    await runCanary(a);
+    await runCanary(b);
+    const id = (x: typeof a) =>
+      (vi.mocked(x.putKey).mock.calls[0] as unknown as [{ id: string }])[0].id;
+    expect(id(a)).not.toBe(id(b));
+  });
+});
diff --git a/apps/cli/src/doctor/canary.ts b/apps/cli/src/doctor/canary.ts
new file mode 100644
index 0000000..3f55576
--- /dev/null
+++ b/apps/cli/src/doctor/canary.ts
@@ -0,0 +1,151 @@
+import { randomBytes } from "node:crypto";
+
+// What canary-scan.py prints (Part 4b, Task 15): the processes whose memory it read, the bytes of
+// memory it read, the files it read, and "needle|form|where" for every find.
+export interface ScanResult {
+  processes: number;
+  bytes: number;
+  files: number;
+  hits: string[];
+}
+
+export interface CanaryBinding {
+  id: string;
+  kind: "http";
+  hosts: string[];
+  header: string;
+  format: "bearer";
+}
+
+export interface CanaryDeps {
+  keydSealKey(): Promise<string | null>;
+  // POST /api/keys through the daemon, which refreshes every running computer's stand-ins.
+  putKey(binding: CanaryBinding, sealed: unknown): Promise<void>;
+  // DELETE /api/keys/:id; resolves on 204 and on 404 (already gone).
+  deleteKey(id: string): Promise<void>;
+  seal(publicKey: string, binding: CanaryBinding, value: string): Promise<unknown>;
+  readyDesktops(): Promise<{ cellId: string; container: string }[]>;
+  // The value of LOCALDOT_KEY_<NAME> in the container's /etc/localdot/cell/surrogates.sh, or null.
+  readSurrogate(container: string, envName: string): Promise<string | null>;
+  scan(container: string, needles: string[], roots: string[]): Promise<ScanResult>;
+  envName(id: string): string;
+  random?: (bytes: number) => Buffer;
+  sleep?: (ms: number) => Promise<void>;
+}
+
+export type CanaryVerdict = { level: "ok" | "warn" | "fail"; detail: string };
+
+// Part 4b's coverage floor: a scan that saw less proves nothing.
+export const MIN_PROCESSES = 20;
+export const MIN_BYTES = 100 * 1024 * 1024;
+export const MIN_FILES = 100;
+export const SCAN_ROOTS = ["/etc/localdot/cell", "/config", "/tmp", "/root"];
+const SURROGATE_WAIT_MS = 15_000;
+
+// `localdot doctor --canary` (spec "Setup and operations": doctor "runs the canary test"): plants a
+// fresh random key in keyd, lets every running computer get its stand-in, and scans each computer's
+// processes, memory and files for the real value. The stand-in must be found (the scan can see
+// where a key would be); the value must not. The canary is removed whatever happens. It is bound
+// to a reserved name (RFC 2606), so it is never sent anywhere, and its value is never printed.
+export async function runCanary(deps: CanaryDeps): Promise<CanaryVerdict> {
+  const random = deps.random ?? randomBytes;
+  const sleep = deps.sleep ?? ((ms: number) => new Promise((r) => setTimeout(r, ms)));
+  const sealKey = await deps.keydSealKey();
+  if (!sealKey)
+    return {
+      level: "fail",
+      detail: "keyd is offline: start it (localdot up) and run the canary again",
+    };
+  const cells = await deps.readyDesktops();
+  if (cells.length === 0)
+    return {
+      level: "warn",
+      detail: "skipped: no computer is running (start one, then run doctor --canary)",
+    };
+  const id = `doctor-canary-${random(4).toString("hex")}`;
+  const value = `canary-${random(24).toString("base64url")}`;
+  const binding: CanaryBinding = {
+    id,
+    kind: "http",
+    hosts: ["canary.localdot.example"],
+    header: "Authorization",
+    format: "bearer",
+  };
+  // Planted before the put returns: a put that fails after keyd stored the key still gets removed.
+  let planted = false;
+  let verdict: CanaryVerdict;
+  try {
+    const sealed = await deps.seal(sealKey, binding, value);
+    planted = true;
+    await deps.putKey(binding, sealed);
+    verdict = await scanAll(deps, cells, id, value, sleep);
+  } catch (err) {
+    const message =
+      err instanceof Error ? err.message.replaceAll(value, "<canary>") : "unknown error";
+    verdict = { level: "fail", detail: `the canary failed: ${message}` };
+  }
+  if (planted) {
+    try {
+      await deps.deleteKey(id);
+    } catch {
+      verdict = {
+        level: "fail",
+        detail: `${verdict.detail}; and the canary key ${id} could not be removed: remove it under Keys`,
+      };
+    }
+  }
+  return verdict;
+}
+
+async function scanAll(
+  deps: CanaryDeps,
+  cells: { cellId: string; container: string }[],
+  id: string,
+  value: string,
+  sleep: (ms: number) => Promise<void>,
+): Promise<CanaryVerdict> {
+  const seen = { processes: 0, bytes: 0, files: 0 };
+  for (const { cellId, container } of cells) {
+    let surrogate: string | null = null;
+    for (let waited = 0; surrogate === null && waited <= SURROGATE_WAIT_MS; waited += 500) {
+      surrogate = await deps.readSurrogate(container, deps.envName(id));
+      if (surrogate === null) await sleep(500);
+    }
+    if (surrogate === null) {
+      return {
+        level: "fail",
+        detail: `computer ${cellId} never got the canary's stand-in, so the scan cannot be trusted`,
+      };
+    }
+    const result = await deps.scan(container, [value, surrogate], SCAN_ROOTS);
+    const where = (needle: string) =>
+      result.hits.filter((h) => h.startsWith(`${needle}|`)).map((h) => h.slice(needle.length + 1));
+    const leaks = where(value);
+    if (leaks.length > 0) {
+      return {
+        level: "fail",
+        detail: `LEAK: computer ${cellId} holds the canary's real value (${leaks.slice(0, 3).join("; ")})`,
+      };
+    }
+    if (where(surrogate).length === 0) {
+      return {
+        level: "fail",
+        detail: `the scan of computer ${cellId} did not find the canary's stand-in, so it is blind`,
+      };
+    }
+    if (result.processes < MIN_PROCESSES || result.bytes < MIN_BYTES || result.files < MIN_FILES) {
+      return {
+        level: "fail",
+        detail: `the scan of computer ${cellId} covered too little (${result.processes} processes, ${result.bytes} bytes, ${result.files} files)`,
+      };
+    }
+    seen.processes += result.processes;
+    seen.bytes += result.bytes;
+    seen.files += result.files;
+  }
+  const n = cells.length;
+  return {
+    level: "ok",
+    detail: `no computer holds the canary (${n} computer${n === 1 ? "" : "s"}, ${seen.processes} processes, ${Math.round(seen.bytes / 2 ** 20)} MiB of memory, ${seen.files} files)`,
+  };
+}
