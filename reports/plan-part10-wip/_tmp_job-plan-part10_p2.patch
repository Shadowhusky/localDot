@@ -0,0 +1,51 @@
+import { describe, expect, it } from "vitest";
+import { imageRef, PackagePath, ReleaseManifest } from "./release.ts";
+import { type SampleManifest, sampleManifest } from "./testing/sample-release.ts";
+
+const hex = (c: string) => c.repeat(64);
+
+describe("release manifest", () => {
+  it("accepts a complete manifest and builds digest references", () => {
+    const m = ReleaseManifest.parse(sampleManifest());
+    expect(imageRef(m.images.desktop)).toBe(
+      `ghcr.io/shadowhusky/localdot-desktop@sha256:${hex("a")}`,
+    );
+  });
+
+  it.each([
+    ["a tag instead of a digest", (m: SampleManifest) => (m.images.gate.digest = "latest")],
+    ["an image without arm64", (m: SampleManifest) => (m.images.brain.platforms = ["linux/amd64"])],
+    [
+      "an image outside ghcr.io",
+      (m: SampleManifest) => (m.images.desktop.repository = "docker.io/evil/localdot-desktop"),
+    ],
+    ["a range version", (m: SampleManifest) => (m.version = "^1.0.0")],
+    [
+      "an unknown field",
+      (m: SampleManifest) => ((m as unknown as Record<string, unknown>).postinstall = "x"),
+    ],
+    ["a short keyd hash", (m: SampleManifest) => (m.keyd.sha256 = "abc")],
+    ["another keyd identifier", (m: SampleManifest) => (m.keyd.identifier = "com.evil.keyd")],
+    ["an empty file list", (m: SampleManifest) => (m.files = {})],
+  ])("refuses %s", (_label, mutate) => {
+    const m = sampleManifest();
+    mutate(m);
+    expect(ReleaseManifest.safeParse(m).success).toBe(false);
+  });
+
+  it.each(["../etc/passwd", "/abs", "a//b", "a/./b", "a/../b", "a\\b", "", ".hidden/x", "dist/"])(
+    "refuses the package path %j",
+    (p) => {
+      expect(PackagePath.safeParse(p).success).toBe(false);
+    },
+  );
+
+  it.each([
+    "dist/cli.mjs",
+    "web/assets/index-Ab1.js",
+    "web/vendor/selkies/LICENSE",
+    "THIRD-PARTY.md",
+  ])("accepts the package path %j", (p) => {
+    expect(PackagePath.safeParse(p).success).toBe(true);
+  });
+});
diff --git a/packages/protocol/src/release.ts b/packages/protocol/src/release.ts
new file mode 100644
index 0000000..fc17642
--- /dev/null
+++ b/packages/protocol/src/release.ts
@@ -0,0 +1,60 @@
+import { z } from "zod";
+
+// release.json: what one localdot version is made of. The release workflow writes it into the npm
+// package; the installer and `localdot update` verify a staged copy against it before anything runs
+// (apps/cli/src/verify/release.ts). Every field is exact: nothing here is a range or a tag.
+
+export const RELEASE_VERSION = /^(0|[1-9]\d*)\.(0|[1-9]\d*)\.(0|[1-9]\d*)(-rc\.(0|[1-9]\d*))?$/;
+export const SHA256_HEX = /^[0-9a-f]{64}$/;
+export const IMAGE_DIGEST = /^sha256:[0-9a-f]{64}$/;
+export const IMAGE_ROLES = ["desktop", "gate", "brain", "browser"] as const;
+export const KEYD_PACKAGE = "@localdot/keyd-darwin-arm64";
+export const KEYD_IDENTIFIER = "dev.localdot.keyd";
+
+// A path inside the package: relative, forward slashes, no empty, "." or ".." segment.
+export const PackagePath = z
+  .string()
+  .max(512)
+  .regex(/^[A-Za-z0-9_@+-][A-Za-z0-9._@+-]*(\/[A-Za-z0-9_@+-][A-Za-z0-9._@+-]*)*$/)
+  .refine((p) => !p.split("/").some((s) => s === "." || s === ".."), "no . or .. segments");
+
+export const ImagePin = z.strictObject({
+  repository: z.string().regex(/^ghcr\.io\/[a-z0-9-]+\/localdot-(desktop|gate|brain|browser)$/),
+  digest: z.string().regex(IMAGE_DIGEST),
+  platforms: z
+    .array(z.enum(["linux/arm64", "linux/amd64"]))
+    .min(1)
+    .refine((p) => p.includes("linux/arm64"), "every image must have linux/arm64")
+    .refine((p) => new Set(p).size === p.length, "no repeated platform"),
+});
+export type ImagePin = z.infer<typeof ImagePin>;
+
+export const ReleaseManifest = z.strictObject({
+  v: z.literal(1),
+  name: z.literal("localdot"),
+  version: z.string().regex(RELEASE_VERSION),
+  commit: z.string().regex(/^[0-9a-f]{40}$/),
+  // Every file of the localdot package but package.json and release.json, with its SHA-256.
+  files: z
+    .record(PackagePath, z.string().regex(SHA256_HEX))
+    .refine((f) => Object.keys(f).length > 0),
+  keyd: z.strictObject({
+    package: z.literal(KEYD_PACKAGE),
+    path: z.literal("bin/keyd"),
+    sha256: z.string().regex(SHA256_HEX),
+    identifier: z.literal(KEYD_IDENTIFIER),
+    teamId: z.string().regex(/^[A-Z0-9]{10}$/),
+  }),
+  images: z.strictObject({
+    desktop: ImagePin,
+    gate: ImagePin,
+    brain: ImagePin,
+    browser: ImagePin,
+  }),
+});
+export type ReleaseManifest = z.infer<typeof ReleaseManifest>;
+
+// The reference a cell is created from: never a tag.
+export function imageRef(pin: ImagePin): string {
+  return `${pin.repository}@${pin.digest}`;
+}
