+// Every refusal names the check that failed; the CLI prints it and changes nothing.
+export class ReleaseVerificationError extends Error {
+  constructor(
+    readonly check: "package" | "manifest" | "files" | "keyd" | "provenance" | "images",
+    message: string,
+  ) {
+    super(`${check}: ${message}`);
+    this.name = "ReleaseVerificationError";
+  }
+}
