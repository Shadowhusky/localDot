@@ -0,0 +1,187 @@
+import { createHash } from "node:crypto";
+import { chmodSync, mkdirSync, mkdtempSync, writeFileSync } from "node:fs";
+import { tmpdir } from "node:os";
+import { dirname, join } from "node:path";
+import { sampleManifest } from "@localdot/protocol/testing";
+import { type BundleVerifier, GITHUB_WORKFLOW_BUILD, purl, SLSA_V1 } from "../verify/provenance.ts";
+import type { TrustPins } from "../verify/trust.ts";
+
+export const TEST_PINS: TrustPins = {
+  repository: "https://github.com/Shadowhusky/localdot",
+  workflow: ".github/workflows/release.yml",
+  issuer: "https://token.actions.githubusercontent.com",
+  teamId: "TESTTEAM01",
+  imageRepositories: {
+    desktop: "ghcr.io/shadowhusky/localdot-desktop",
+    gate: "ghcr.io/shadowhusky/localdot-gate",
+    brain: "ghcr.io/shadowhusky/localdot-brain",
+    browser: "ghcr.io/shadowhusky/localdot-browser",
+  },
+};
+
+const sha256 = (data: string | Buffer) => createHash("sha256").update(data).digest("hex");
+const sha512b64 = (data: string) => `sha512-${createHash("sha512").update(data).digest("base64")}`;
+
+export interface StagedRelease {
+  root: string;
+  version: string;
+  packageDir: string;
+  keydPath: string;
+  // The tarball stand-ins whose sha512 the lockfile records, by package name.
+  tarballs: Record<string, string>;
+}
+
+// A staged install as `npm install --prefix root localdot@version` leaves it, with a manifest that
+// matches every file. Tests then break one thing.
+export function stageRelease(
+  version = "1.0.0",
+  root = mkdtempSync(join(tmpdir(), "local dot's stage-")),
+  { nested = false } = {},
+): StagedRelease {
+  const packageDir = join(root, "node_modules", "localdot");
+  // npm puts a shrinkwrapped package's dependencies under it; a plain install hoists them.
+  const keydKey = nested
+    ? "node_modules/localdot/node_modules/@localdot/keyd-darwin-arm64"
+    : "node_modules/@localdot/keyd-darwin-arm64";
+  const keydDir = join(root, keydKey);
+  const payload: Record<string, string> = {
+    "bin/localdot.mjs": "#!/usr/bin/env node\nimport '../dist/cli.mjs';\n",
+    "dist/cli.mjs": "export {};\n",
+    "dist/daemon.mjs": "export {};\n",
+    "web/dist/index.html": "<!doctype html>\n",
+    "web/vendor/selkies/LICENSE": "Mozilla Public License Version 2.0\n",
+    "THIRD-PARTY.md": "# Third-party\n",
+    LICENSE: "MIT\n",
+  };
+  const files: Record<string, string> = {};
+  for (const [path, text] of Object.entries(payload)) {
+    write(join(packageDir, path), text);
+    files[path] = sha256(text);
+  }
+  const keyd = Buffer.from("\xCF\xFA\xED\xFEkeyd");
+  write(join(keydDir, "bin", "keyd"), keyd);
+  chmodSync(join(keydDir, "bin", "keyd"), 0o755);
+  write(
+    join(keydDir, "package.json"),
+    JSON.stringify({
+      name: "@localdot/keyd-darwin-arm64",
+      version,
+      os: ["darwin"],
+      cpu: ["arm64"],
+    }),
+  );
+  write(join(keydDir, "LICENSE"), "MIT\n");
+  const manifest = {
+    ...sampleManifest(),
+    version,
+    files,
+    keyd: { ...sampleManifest().keyd, sha256: sha256(keyd) },
+  };
+  write(join(packageDir, "release.json"), JSON.stringify(manifest));
+  write(
+    join(packageDir, "package.json"),
+    JSON.stringify({
+      name: "localdot",
+      version,
+      bin: { localdot: "bin/localdot.mjs" },
+      optionalDependencies: { "@localdot/keyd-darwin-arm64": version },
+    }),
+  );
+  const tarballs = {
+    localdot: `localdot-${version}.tgz`,
+    "@localdot/keyd-darwin-arm64": `keyd-darwin-arm64-${version}.tgz`,
+  };
+  write(
+    join(root, "package-lock.json"),
+    JSON.stringify({
+      lockfileVersion: 3,
+      packages: {
+        "node_modules/localdot": { version, integrity: sha512b64(tarballs.localdot) },
+        [keydKey]: {
+          version,
+          integrity: sha512b64(tarballs["@localdot/keyd-darwin-arm64"]),
+        },
+      },
+    }),
+  );
+  return { root, version, packageDir, keydPath: join(keydDir, "bin", "keyd"), tarballs };
+}
+
+export interface FakeProvenanceOptions {
+  repository?: string;
+  path?: string;
+  ref?: string;
+  subjectName?: string;
+  digestOf?: string;
+  // The identity the fake "certificate" carries; sigstore refuses any other policy.
+  signedIdentity?: string;
+  predicateType?: string;
+  extra?: number;
+}
+
+// The registry's attestation document for one package, in npm's real shape (checked against
+// @sigstore/core@3.2.1's on 2026-10-02), signed by a stand-in for sigstore.
+export function fakeAttestations(
+  name: string,
+  version: string,
+  tarball: string,
+  o: FakeProvenanceOptions = {},
+) {
+  const ref = o.ref ?? `refs/tags/v${version}`;
+  const statement = {
+    _type: "https://in-toto.io/Statement/v1",
+    subject: [
+      {
+        name: o.subjectName ?? purl(name, version),
+        digest: {
+          sha512: createHash("sha512")
+            .update(o.digestOf ?? tarball)
+            .digest("hex"),
+        },
+      },
+    ],
+    predicateType: SLSA_V1,
+    predicate: {
+      buildDefinition: {
+        buildType: GITHUB_WORKFLOW_BUILD,
+        externalParameters: {
+          workflow: {
+            ref,
+            repository: o.repository ?? TEST_PINS.repository,
+            path: o.path ?? TEST_PINS.workflow,
+          },
+        },
+      },
+    },
+  };
+  const slsa = {
+    predicateType: o.predicateType ?? SLSA_V1,
+    bundle: {
+      fakeIdentity:
+        o.signedIdentity ??
+        `${o.repository ?? TEST_PINS.repository}/${o.path ?? TEST_PINS.workflow}@${ref}`,
+      dsseEnvelope: {
+        payloadType: "application/vnd.in-toto+json",
+        payload: Buffer.from(JSON.stringify(statement)).toString("base64"),
+        signatures: [],
+      },
+    },
+  };
+  const publish = {
+    predicateType: "https://github.com/npm/attestation/tree/main/specs/publish/v0.1",
+    bundle: {},
+  };
+  return { attestations: [publish, slsa, ...Array.from({ length: o.extra ?? 0 }, () => slsa)] };
+}
+
+export const fakeSigstore: BundleVerifier = async (bundle, policy) => {
+  const identity = (bundle as { fakeIdentity?: string }).fakeIdentity;
+  if (policy.certificateIssuer !== TEST_PINS.issuer || identity !== policy.certificateIdentityURI) {
+    throw new Error(`certificate identity ${String(identity)} does not match`);
+  }
+};
+
+function write(path: string, data: string | Buffer) {
+  mkdirSync(dirname(path), { recursive: true });
+  writeFileSync(path, data);
+}
diff --git a/apps/cli/src/update/layout.ts b/apps/cli/src/update/layout.ts
new file mode 100644
index 0000000..3c10d3d
--- /dev/null
+++ b/apps/cli/src/update/layout.ts
@@ -0,0 +1,128 @@
+import { randomBytes } from "node:crypto";
+import {
+  existsSync,
+  lstatSync,
+  mkdirSync,
+  readdirSync,
+  readFileSync,
+  readlinkSync,
+  renameSync,
+  rmSync,
+  symlinkSync,
+  writeFileSync,
+} from "node:fs";
+import { basename, join } from "node:path";
+import { RELEASE_VERSION } from "@localdot/protocol";
+
+// <home>/app/
+//   versions/<v>/      a release that passed verifyStagedRelease, renamed into place whole
+//   current            symlink -> versions/<v>; the LaunchAgents run through it
+//   staging-<v>-<hex>/ npm's working folder; never run, removed by every recovery
+//   update.json        the journal of an update in flight
+export interface AppLayout {
+  root: string;
+  versions: string;
+  current: string;
+  journal: string;
+}
+
+export function appLayout(home: string): AppLayout {
+  const root = join(home, "app");
+  return {
+    root,
+    versions: join(root, "versions"),
+    current: join(root, "current"),
+    journal: join(root, "update.json"),
+  };
+}
+
+export function versionDir(layout: AppLayout, version: string): string {
+  if (!RELEASE_VERSION.test(version)) throw new RangeError(`not a release version: ${version}`);
+  return join(layout.versions, version);
+}
+
+export function newStagingDir(layout: AppLayout, version: string): string {
+  mkdirSync(layout.root, { recursive: true, mode: 0o700 });
+  return join(layout.root, `staging-${version}-${randomBytes(6).toString("hex")}`);
+}
+
+// The version `current` points at, or null before the first install.
+export function currentVersion(layout: AppLayout): string | null {
+  const st = lstatSync(layout.current, { throwIfNoEntry: false });
+  if (!st?.isSymbolicLink()) return null;
+  const version = basename(readlinkSync(layout.current));
+  return RELEASE_VERSION.test(version) && existsSync(join(layout.versions, version))
+    ? version
+    : null;
+}
+
+// One rename replaces the link, so `current` always names a whole version: the old one or the new.
+export function switchCurrent(layout: AppLayout, version: string): void {
+  const target = join("versions", version);
+  if (!existsSync(join(layout.root, target))) throw new Error(`no installed version ${version}`);
+  const temp = `${layout.current}.tmp-${randomBytes(6).toString("hex")}`;
+  symlinkSync(target, temp);
+  renameSync(temp, layout.current);
+}
+
+// Moves a verified staging folder into versions/. A folder already there (an interrupted update
+// renamed it but never switched to it) is replaced: the staging copy was verified just now.
+export function promote(layout: AppLayout, staging: string, version: string): string {
+  const dir = versionDir(layout, version);
+  mkdirSync(layout.versions, { recursive: true, mode: 0o700 });
+  if (existsSync(dir)) {
+    if (currentVersion(layout) === version) throw new Error(`${version} is the running version`);
+    // Aside first: a kill during the removal leaves a staging-* folder, never half a version.
+    const aside = join(layout.root, `staging-old-${version}-${randomBytes(6).toString("hex")}`);
+    renameSync(dir, aside);
+    rmSync(aside, { recursive: true, force: true });
+  }
+  renameSync(staging, dir);
+  return dir;
+}
+
+// Staging folders and half-made links belong to no version; every recovery removes them.
+export function sweepLeftovers(layout: AppLayout): void {
+  if (!existsSync(layout.root)) return;
+  for (const name of readdirSync(layout.root)) {
+    if (/^staging-/.test(name) || /^current\.tmp-/.test(name))
+      rmSync(join(layout.root, name), { recursive: true, force: true });
+  }
+}
+
+// Keeps the running version and the one before it (for `localdot update --rollback`).
+export function pruneVersions(layout: AppLayout, keep: string[]): void {
+  if (!existsSync(layout.versions)) return;
+  for (const name of readdirSync(layout.versions)) {
+    if (!keep.includes(name)) rmSync(join(layout.versions, name), { recursive: true, force: true });
+  }
+}
+
+export type UpdatePhase = "staging" | "verified" | "images" | "stopped" | "switched";
+
+export interface UpdateJournal {
+  v: 1;
+  from: string | null;
+  to: string;
+  phase: UpdatePhase;
+}
+
+export function readJournal(layout: AppLayout): UpdateJournal | null {
+  try {
+    const j = JSON.parse(readFileSync(layout.journal, "utf8")) as UpdateJournal;
+    return j.v === 1 && typeof j.to === "string" ? j : null;
+  } catch {
+    return null;
+  }
+}
+
+export function writeJournal(layout: AppLayout, journal: UpdateJournal): void {
+  mkdirSync(layout.root, { recursive: true, mode: 0o700 });
+  const temp = `${layout.journal}.${randomBytes(6).toString("hex")}.tmp`;
+  writeFileSync(temp, `${JSON.stringify(journal)}\n`, { mode: 0o600 });
+  renameSync(temp, layout.journal);
+}
+
+export function clearJournal(layout: AppLayout): void {
+  rmSync(layout.journal, { force: true });
+}
diff --git a/apps/cli/src/update/run.test.ts b/apps/cli/src/update/run.test.ts
new file mode 100644
index 0000000..0b6d75f
--- /dev/null
+++ b/apps/cli/src/update/run.test.ts
@@ -0,0 +1,171 @@
+import {
+  existsSync,
+  mkdirSync,
+  mkdtempSync,
+  readdirSync,
+  readlinkSync,
+  symlinkSync,
+  writeFileSync,
+} from "node:fs";
+import { tmpdir } from "node:os";
+import { join } from "node:path";
+import { describe, expect, it } from "vitest";
+import {
+  fakeAttestations,
+  fakeSigstore,
+  stageRelease,
+  TEST_PINS,
+} from "../testing/staged-release.ts";
+import { provenanceChecker } from "../verify/provenance.ts";
+import { verifyStagedRelease } from "../verify/release.ts";
+import { type AppLayout, appLayout, currentVersion, readJournal, switchCurrent } from "./layout.ts";
+import { recoverUpdate, runUpdate, type UpdateSteps } from "./run.ts";
+
+class Killed extends Error {}
+const STEPS = ["stage", "verify", "pullImages", "stopServices", "startServices"] as const;
+type Step = (typeof STEPS)[number];
+
+function fakeServices() {
+  return { running: null as string | null, starts: 0 };
+}
+
+function steps(
+  layout: AppLayout,
+  services: ReturnType<typeof fakeServices>,
+  killAt?: Step,
+): UpdateSteps {
+  const tarballs = new Map<string, Record<string, string>>();
+  const kill = (step: Step) => {
+    if (step === killAt) throw new Killed(step);
+  };
+  return {
+    async stage(dir, version) {
+      mkdirSync(dir, { recursive: true });
+      tarballs.set(version, stageRelease(version, dir).tarballs);
+      kill("stage");
+    },
+    async verify(dir, version) {
+      kill("verify");
+      return verifyStagedRelease(dir, version, {
+        pins: TEST_PINS,
+        codesign: async () => true,
+        provenance: provenanceChecker(
+          TEST_PINS,
+          async (n, v) => fakeAttestations(n, v, tarballs.get(v)?.[n] ?? ""),
+          fakeSigstore,
+        ),
+      });
+    },
+    async pullImages() {
+      kill("pullImages");
+    },
+    async stopServices() {
+      services.running = null;
+      kill("stopServices");
+    },
+    async startServices() {
+      services.running = currentVersion(layout);
+      services.starts += 1;
+      kill("startServices");
+    },
+  };
+}
+
+async function installed(version: string) {
+  const layout = appLayout(mkdtempSync(join(tmpdir(), "local dot's home-")));
+  const services = fakeServices();
+  await runUpdate(layout, version, steps(layout, services));
+  return { layout, services };
+}
+
+function invariants(layout: AppLayout, services: ReturnType<typeof fakeServices>) {
+  const current = currentVersion(layout);
+  expect(current, "current names a whole version").not.toBeNull();
+  expect(readlinkSync(layout.current)).toBe(join("versions", current as string));
+  expect(
+    existsSync(
+      join(layout.versions, current as string, "node_modules", "localdot", "release.json"),
+    ),
+  ).toBe(true);
+  expect(
+    readdirSync(layout.root).filter((n) => n.startsWith("staging-") || n.includes(".tmp-")),
+  ).toEqual([]);
+  expect(readJournal(layout)).toBeNull();
+  expect(services.running, "the services run the current version").toBe(current);
+  return current;
+}
+
+describe("update (Review Focus 2: update interrupted mid-way)", () => {
+  it("installs, then updates, keeping the previous version for rollback", async () => {
+    const { layout, services } = await installed("1.0.0");
+    expect(await runUpdate(layout, "1.1.0", steps(layout, services))).toEqual({
+      kind: "updated",
+      from: "1.0.0",
+      to: "1.1.0",
+    });
+    expect(invariants(layout, services)).toBe("1.1.0");
+    expect(readdirSync(layout.versions).sort()).toEqual(["1.0.0", "1.1.0"]);
+    expect(await runUpdate(layout, "1.1.0", steps(layout, services))).toEqual({
+      kind: "current",
+      version: "1.1.0",
+    });
+  });
+
+  it.each(STEPS.map((s, i) => [s, i] as const))(
+    "recovers from a kill during %s",
+    async (step, index) => {
+      const { layout, services } = await installed("1.0.0");
+      await expect(
+        runUpdate(layout, "1.1.0", steps(layout, services, step)),
+      ).rejects.toBeInstanceOf(Killed);
+      const outcome = await recoverUpdate(layout, steps(layout, services));
+      const switched = index >= STEPS.indexOf("startServices");
+      expect(outcome).toBe(switched ? "completed" : "rolled-back");
+      expect(invariants(layout, services)).toBe(switched ? "1.1.0" : "1.0.0");
+      // And the update, run again, completes.
+      await runUpdate(layout, "1.1.0", steps(layout, services));
+      expect(invariants(layout, services)).toBe("1.1.0");
+    },
+  );
+
+  it("refuses to switch to a release that fails verification, and keeps the old one running", async () => {
+    const { layout, services } = await installed("1.0.0");
+    const bad = steps(layout, services);
+    const verify = bad.verify;
+    bad.verify = async (dir, version) => {
+      writeFileSync(join(dir, "node_modules", "localdot", "dist", "daemon.mjs"), "tampered");
+      return verify(dir, version);
+    };
+    await expect(runUpdate(layout, "1.1.0", bad)).rejects.toMatchObject({ check: "files" });
+    expect(await recoverUpdate(layout, steps(layout, services))).toBe("rolled-back");
+    expect(invariants(layout, services)).toBe("1.0.0");
+    expect(existsSync(join(layout.versions, "1.1.0"))).toBe(false);
+  });
+
+  it("removes a half-made link and staging folders left by a kill inside the switch", async () => {
+    const { layout, services } = await installed("1.0.0");
+    symlinkSync(join("versions", "9.9.9"), `${layout.current}.tmp-abcdef`);
+    mkdirSync(join(layout.root, "staging-1.1.0-abcdef"));
+    expect(await recoverUpdate(layout, steps(layout, services))).toBe("nothing");
+    expect(invariants(layout, services)).toBe("1.0.0");
+  });
+
+  it("a first install killed before the switch leaves nothing to run, and the rerun installs", async () => {
+    const layout = appLayout(mkdtempSync(join(tmpdir(), "local dot's home-")));
+    const services = fakeServices();
+    await expect(
+      runUpdate(layout, "1.0.0", steps(layout, services, "pullImages")),
+    ).rejects.toBeInstanceOf(Killed);
+    expect(await recoverUpdate(layout, steps(layout, services))).toBe("rolled-back");
+    expect(currentVersion(layout)).toBeNull();
+    expect(services.starts).toBe(0);
+    await runUpdate(layout, "1.0.0", steps(layout, services));
+    expect(invariants(layout, services)).toBe("1.0.0");
+  });
+
+  it("never points current at a version that is not installed", () => {
+    const layout = appLayout(mkdtempSync(join(tmpdir(), "local dot's home-")));
+    expect(() => switchCurrent(layout, "2.0.0")).toThrow(/no installed version/);
+    expect(currentVersion(layout)).toBeNull();
+  });
+});
diff --git a/apps/cli/src/update/run.ts b/apps/cli/src/update/run.ts
new file mode 100644
index 0000000..06b2f0f
--- /dev/null
+++ b/apps/cli/src/update/run.ts
@@ -0,0 +1,80 @@
+import type { ReleaseManifest } from "@localdot/protocol";
+import type { VerifiedRelease } from "../verify/release.ts";
+import {
+  type AppLayout,
+  clearJournal,
+  currentVersion,
+  newStagingDir,
+  promote,
+  pruneVersions,
+  readJournal,
+  sweepLeftovers,
+  switchCurrent,
+  versionDir,
+  writeJournal,
+} from "./layout.ts";
+
+export interface UpdateSteps {
+  // npm install --prefix <dir> --ignore-scripts --omit=dev localdot@<version>
+  stage(dir: string, version: string): Promise<void>;
+  verify(dir: string, version: string): Promise<VerifiedRelease>;
+  // Pull every image by digest and check that Docker holds exactly that digest.
+  pullImages(manifest: ReleaseManifest): Promise<void>;
+  // Stop the computers through the daemon, then boot the daemon and keyd out of launchd.
+  stopServices(): Promise<void>;
+  // Bootstrap keyd and the daemon from `current`, and wait for both to answer. Idempotent.
+  startServices(): Promise<void>;
+}
+
+export type UpdateOutcome =
+  | { kind: "current"; version: string }
+  | { kind: "updated"; from: string | null; to: string };
+
+// An update never runs from a version it has not verified, and `current` always names a whole,
+// verified version: until the switch, the old one keeps running; after it, the new one. Nothing
+// here cleans up on failure. A kill and an error leave the same state, and recoverUpdate (run
+// before every command, and after a failed update) finishes or undoes it from the journal.
+export async function runUpdate(
+  layout: AppLayout,
+  to: string,
+  steps: UpdateSteps,
+): Promise<UpdateOutcome> {
+  versionDir(layout, to);
+  const from = currentVersion(layout);
+  if (from === to) return { kind: "current", version: to };
+  writeJournal(layout, { v: 1, from, to, phase: "staging" });
+  const staging = newStagingDir(layout, to);
+  await steps.stage(staging, to);
+  const verified = await steps.verify(staging, to);
+  promote(layout, staging, to);
+  writeJournal(layout, { v: 1, from, to, phase: "verified" });
+  await steps.pullImages(verified.manifest);
+  writeJournal(layout, { v: 1, from, to, phase: "images" });
+  await steps.stopServices();
+  writeJournal(layout, { v: 1, from, to, phase: "stopped" });
+  switchCurrent(layout, to);
+  writeJournal(layout, { v: 1, from, to, phase: "switched" });
+  await steps.startServices();
+  clearJournal(layout);
+  pruneVersions(layout, from ? [to, from] : [to]);
+  return { kind: "updated", from, to };
+}
+
+export type RecoveryOutcome = "nothing" | "rolled-back" | "completed";
+
+// Before the switch, the update is abandoned: the old version is current and is started again
+// (stopServices may have run). From the switch on, the new version is current, verified and
+// whole, so it is started. Either way the staging folders go, and the journal is cleared last, so
+// a recovery that is itself killed runs again next time.
+export async function recoverUpdate(
+  layout: AppLayout,
+  steps: Pick<UpdateSteps, "startServices">,
+): Promise<RecoveryOutcome> {
+  sweepLeftovers(layout);
+  const journal = readJournal(layout);
+  if (!journal) return "nothing";
+  const switched = currentVersion(layout) === journal.to;
+  if (currentVersion(layout) !== null) await steps.startServices();
+  clearJournal(layout);
+  return switched ? "completed" : "rolled-back";
+}
