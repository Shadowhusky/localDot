new file mode 100644
index 0000000..868502f
--- /dev/null
+++ b/apps/daemon/src/startup-lines.ts
@@ -0,0 +1,15 @@
+// What the daemon prints when it starts. Under launchd (LOCALDOT_SUPERVISED=1) stdout goes to
+// <home>/logs/daemon.log, which must never hold the install token: the CLI opens a one-time
+// #code= link instead. A daemon run by hand in a terminal keeps P2-R7's #token= link.
+export interface StartupInfo {
+  port: number;
+  token: string;
+  tokenFile: string;
+  supervised: boolean;
+}
+
+export function startupLines({ port, token, tokenFile, supervised }: StartupInfo): string[] {
+  const origin = `http://127.0.0.1:${port}`;
+  if (supervised) return [`localdot daemon on ${origin}; open it with: localdot open`];
+  return [`localdot daemon on ${origin} (token in ${tokenFile})`, `open ${origin}/#token=${token}`];
+}
diff --git a/apps/web/src/lib/install-link.test.ts b/apps/web/src/lib/install-link.test.ts
new file mode 100644
index 0000000..aad98ed
--- /dev/null
+++ b/apps/web/src/lib/install-link.test.ts
@@ -0,0 +1,100 @@
+import { describe, expect, it, vi } from "vitest";
+import { CODE_PATTERN, exchangeCode, takeFragmentLink } from "./install-link.ts";
+
+const CODE = "c".repeat(43);
+const TOKEN = "t".repeat(43);
+
+function host(hash: string) {
+  const replaceState = vi.fn();
+  const localStorage = { getItem: vi.fn(), setItem: vi.fn(), removeItem: vi.fn() };
+  return {
+    location: { hash, pathname: "/", search: "" },
+    localStorage,
+    history: { replaceState },
+    replaceState,
+  };
+}
+
+describe("takeFragmentLink", () => {
+  it("takes a code and clears the fragment before anything else", () => {
+    const h = host(`#code=${CODE}`);
+    expect(takeFragmentLink(h)).toEqual({ kind: "code", code: CODE });
+    expect(h.replaceState).toHaveBeenCalledWith(null, "", "/");
+    expect(h.localStorage.setItem).not.toHaveBeenCalled();
+  });
+
+  it("prefers the code when a link carries both", () => {
+    expect(takeFragmentLink(host(`#token=${TOKEN}&code=${CODE}`))).toEqual({
+      kind: "code",
+      code: CODE,
+    });
+  });
+
+  it("still takes a development #token=", () => {
+    expect(takeFragmentLink(host(`#token=${TOKEN}`))).toEqual({ kind: "token", token: TOKEN });
+  });
+
+  it("clears and reports a malformed code or token", () => {
+    for (const hash of ["#code=abc", `#code=${CODE}x`, "#token=short", "#code="]) {
+      const h = host(hash);
+      expect(takeFragmentLink(h)).toEqual({ kind: "malformed" });
+      expect(h.replaceState).toHaveBeenCalledOnce();
+    }
+  });
+
+  it("leaves other fragments alone", () => {
+    const h = host("#settings");
+    expect(takeFragmentLink(h)).toBeNull();
+    expect(h.replaceState).not.toHaveBeenCalled();
+  });
+
+  it("matches the daemon's code shape", () => {
+    // randomBytes(32).toString("base64url") on the daemon: 43 characters of the URL-safe alphabet.
+    expect(CODE_PATTERN.test(`${"A".repeat(42)}_`)).toBe(true);
+    expect(CODE_PATTERN.test(`${"A".repeat(42)}=`)).toBe(false);
+  });
+});
+
+describe("exchangeCode", () => {
+  it("posts the code same-origin with no credentials, cache or referrer", async () => {
+    const fetchImpl = vi.fn(
+      async () => new Response(JSON.stringify({ token: TOKEN }), { status: 200 }),
+    );
+    expect(await exchangeCode(CODE, fetchImpl as unknown as typeof fetch)).toEqual({
+      kind: "token",
+      token: TOKEN,
+    });
+    expect(fetchImpl).toHaveBeenCalledWith("/auth/exchange", {
+      method: "POST",
+      headers: { "content-type": "application/json" },
+      body: JSON.stringify({ code: CODE }),
+      credentials: "omit",
+      cache: "no-store",
+      referrerPolicy: "no-referrer",
+    });
+  });
+
+  it("says refused for a used or expired code, and unreachable for no answer", async () => {
+    const refused = vi.fn(async () => new Response('{"error":"invalid-code"}', { status: 401 }));
+    const down = vi.fn(async () => {
+      throw new TypeError("Failed to fetch");
+    });
+    const busy = vi.fn(async () => new Response("", { status: 503 }));
+    expect(await exchangeCode(CODE, refused as unknown as typeof fetch)).toEqual({
+      kind: "refused",
+    });
+    expect(await exchangeCode(CODE, down as unknown as typeof fetch)).toEqual({
+      kind: "unreachable",
+    });
+    expect(await exchangeCode(CODE, busy as unknown as typeof fetch)).toEqual({
+      kind: "unreachable",
+    });
+  });
+
+  it("refuses an answer that is not a token", async () => {
+    for (const body of ["{}", '{"token":7}', '{"token":"short"}', "not json"]) {
+      const f = vi.fn(async () => new Response(body, { status: 200 }));
+      expect(await exchangeCode(CODE, f as unknown as typeof fetch)).toEqual({ kind: "refused" });
+    }
+  });
+});
diff --git a/apps/web/src/lib/install-link.ts b/apps/web/src/lib/install-link.ts
new file mode 100644
index 0000000..cf72a48
--- /dev/null
+++ b/apps/web/src/lib/install-link.ts
@@ -0,0 +1,57 @@
+import type { TokenHost } from "./token.ts";
+
+// The CLI opens http://127.0.0.1:4750/#code=<c>: a one-time code the page exchanges for the install
+// token, so the browser's history keeps only a dead code. `#token=` stays for development and the
+// e2e harness. Either fragment leaves the address bar before anything else happens.
+export const CODE_PATTERN = /^[A-Za-z0-9_-]{43}$/;
+const TOKEN_SHAPE = /^[A-Za-z0-9_-]{43}$/;
+
+export type FragmentLink =
+  | { kind: "code"; code: string }
+  | { kind: "token"; token: string }
+  | { kind: "malformed" };
+
+export function takeFragmentLink(host: TokenHost = window): FragmentLink | null {
+  const params = new URLSearchParams(host.location.hash.replace(/^#/, ""));
+  const code = params.get("code");
+  const token = params.get("token");
+  if (code === null && token === null) return null;
+  host.history.replaceState(null, "", `${host.location.pathname}${host.location.search}`);
+  if (code !== null)
+    return CODE_PATTERN.test(code) ? { kind: "code", code } : { kind: "malformed" };
+  return token !== null && TOKEN_SHAPE.test(token)
+    ? { kind: "token", token }
+    : { kind: "malformed" };
+}
+
+export type Exchanged =
+  | { kind: "token"; token: string }
+  | { kind: "refused" }
+  | { kind: "unreachable" };
+
+// Same origin, no credentials, never cached and no referrer: the code goes only to this daemon.
+export async function exchangeCode(
+  code: string,
+  fetchImpl: typeof fetch = fetch,
+): Promise<Exchanged> {
+  let res: Response;
+  try {
+    res = await fetchImpl("/auth/exchange", {
+      method: "POST",
+      headers: { "content-type": "application/json" },
+      body: JSON.stringify({ code }),
+      credentials: "omit",
+      cache: "no-store",
+      referrerPolicy: "no-referrer",
+    });
+  } catch {
+    return { kind: "unreachable" };
+  }
+  if (res.status >= 500) return { kind: "unreachable" };
+  if (res.status !== 200) return { kind: "refused" };
+  const body = (await res.json().catch(() => null)) as { token?: unknown } | null;
+  const token = body?.token;
+  return typeof token === "string" && TOKEN_SHAPE.test(token)
+    ? { kind: "token", token }
+    : { kind: "refused" };
+}
