+import { ImagePin, imageRef } from "@localdot/protocol";
+import { sampleManifest } from "@localdot/protocol/testing";
+import { describe, expect, it } from "vitest";
+import { DockerError } from "./docker.ts";
+import { verifyImage } from "./image-check.ts";
+
+const pin = ImagePin.parse(sampleManifest().images.desktop);
+const ref = imageRef(pin);
+const docker = (answer: unknown | Error) => ({
+  request: async <T>() => {
+    if (answer instanceof Error) throw answer;
+    return answer as T;
+  },
+});
+
+describe("verifyImage (Review Focus 5: doctor on arm64 versus amd64 images)", () => {
+  it("accepts the pinned digest for the engine's platform, whatever Docker calls arm64", async () => {
+    const inspect = { RepoDigests: [ref], Os: "linux", Architecture: "arm64" };
+    expect(await verifyImage(docker(inspect), pin, "arm64")).toEqual({
+      ok: true,
+      ref,
+      arch: "arm64",
+    });
+    expect(
+      (await verifyImage(docker({ ...inspect, Architecture: "aarch64" }), pin, "arm64")).ok,
+    ).toBe(true);
+  });
+
+  it("refuses an amd64 image on an arm64 engine, and says how to fix it", async () => {
+    const v = await verifyImage(
+      docker({ RepoDigests: [ref], Os: "linux", Architecture: "amd64" }),
+      pin,
+      "arm64",
+    );
+    expect(v).toMatchObject({ ok: false, reason: "platform" });
+    expect(v.ok === false && v.detail).toMatch(
+      /linux\/amd64 but Docker runs linux\/arm64.*DOCKER_DEFAULT_PLATFORM/,
+    );
+  });
+
+  it("refuses an arm64 image on an amd64 engine", async () => {
+    const v = await verifyImage(
+      docker({ RepoDigests: [ref], Os: "linux", Architecture: "arm64" }),
+      pin,
+      "x86_64",
+    );
+    expect(v).toMatchObject({ ok: false, reason: "platform" });
+  });
+
+  it("refuses an image Docker holds under another digest", async () => {
+    const other = `${pin.repository}@sha256:${"f".repeat(64)}`;
+    const v = await verifyImage(
+      docker({ RepoDigests: [other], Os: "linux", Architecture: "arm64" }),
+      pin,
+      "arm64",
+    );
+    expect(v).toMatchObject({ ok: false, reason: "digest" });
+  });
+
+  it("reports a missing image and an engine error apart", async () => {
+    expect(
+      await verifyImage(docker(new DockerError(404, "No such image", "/images")), pin, "arm64"),
+    ).toMatchObject({ reason: "missing" });
+    expect(
+      await verifyImage(docker(new DockerError(0, "ECONNREFUSED", "/images")), pin, "arm64"),
+    ).toMatchObject({ reason: "error" });
+  });
+});
diff --git a/apps/daemon/src/cells/image-check.ts b/apps/daemon/src/cells/image-check.ts
new file mode 100644
index 0000000..72410a4
--- /dev/null
+++ b/apps/daemon/src/cells/image-check.ts
@@ -0,0 +1,66 @@
+import { type ImagePin, imageRef } from "@localdot/protocol";
+import { type DockerClient, DockerError } from "./docker.ts";
+
+export type ImageVerdict =
+  | { ok: true; ref: string; arch: string }
+  | { ok: false; ref: string; reason: "missing" | "digest" | "platform" | "error"; detail: string };
+
+interface ImageInspect {
+  RepoDigests?: string[] | null;
+  Os?: string;
+  Architecture?: string;
+  Variant?: string;
+}
+
+// Docker's names for the engine's architecture (/version Arch) and an image's (Architecture).
+const ARCH_ALIASES: Record<string, string> = { aarch64: "arm64", x86_64: "amd64" };
+export const normalArch = (arch: string) => ARCH_ALIASES[arch] ?? arch;
+
+// A cell image is usable only as exactly the pinned digest, for the engine's own platform. Docker
+// verifies content against a digest when it pulls; this checks that what it holds under the
+// reference is that pull (RepoDigests) and that it will not run under emulation: an amd64 desktop
+// on Apple silicon runs under Rosetta or QEMU, where XTest timing and the stream's CPU budget no
+// longer hold (Review Focus 5).
+export async function verifyImage(
+  docker: Pick<DockerClient, "request">,
+  pin: ImagePin,
+  engineArch: string,
+): Promise<ImageVerdict> {
+  const ref = imageRef(pin);
+  let info: ImageInspect;
+  try {
+    info = await docker.request<ImageInspect>({
+      method: "GET",
+      path: `/images/${encodeURIComponent(ref)}/json`,
+    });
+  } catch (err) {
+    if (err instanceof DockerError && err.status === 404) {
+      return { ok: false, ref, reason: "missing", detail: `${ref} is not pulled` };
+    }
+    return {
+      ok: false,
+      ref,
+      reason: "error",
+      detail: err instanceof Error ? err.message : String(err),
+    };
+  }
+  if (!(info.RepoDigests ?? []).includes(ref)) {
+    return {
+      ok: false,
+      ref,
+      reason: "digest",
+      detail: `Docker holds ${pin.repository} under other digests (${(info.RepoDigests ?? []).join(", ") || "none"})`,
+    };
+  }
+  const want = normalArch(engineArch);
+  const got = normalArch(info.Architecture ?? "unknown");
+  if (info.Os !== "linux" || got !== want) {
+    return {
+      ok: false,
+      ref,
+      reason: "platform",
+      detail: `the image is ${info.Os ?? "unknown"}/${got} but Docker runs linux/${want}: it would run under emulation. Remove it (docker image rm ${ref}) and pull again with no DOCKER_DEFAULT_PLATFORM set`,
+    };
+  }
+  return { ok: true, ref, arch: got };
+}
