+//go:build !darwin || !cgo
+
+package vault
+
+import "errors"
+
+// ACLKeychain exists only on macOS with cgo; elsewhere keyd runs with -vault memory or
+// keychain-tool.
+type ACLKeychain struct{ Store }
+
+var errNoACLKeychain = errors.New("keychain: the access-list keychain needs macOS (built with cgo)")
+
+func NewACLKeychain(string) (*ACLKeychain, error) { return nil, errNoACLKeychain }
+
+func NewACLKeychainAt(string, string) (*ACLKeychain, error) { return nil, errNoACLKeychain }
diff --git a/keyd/internal/vault/migrate.go b/keyd/internal/vault/migrate.go
new file mode 100644
index 0000000..fc02d9a
--- /dev/null
+++ b/keyd/internal/vault/migrate.go
@@ -0,0 +1,65 @@
+package vault
+
+import (
+	"bytes"
+	"errors"
+	"fmt"
+)
+
+// MigrateReport says what Migrate did. Residue names the ids whose old copy could not be removed:
+// their value is still in the old store, readable by whatever that store trusts.
+type MigrateReport struct {
+	Moved   int
+	Residue []string
+}
+
+// Migrate moves each id's value from the old store (the /usr/bin/security items of P4a-R3, which
+// any process of the user can read) into the new one (the access-list items only a keyd signed by
+// localDot's team can read), then deletes the old copy. It is idempotent and safe to interrupt: an
+// id already in the new store only has its old copy removed, and an old copy is deleted only after
+// the new one reads back intact. An id in neither store is left to the vault, which reports it
+// missing. A read or write error stops the migration with nothing of that id lost.
+func Migrate(ids []string, from, to Store) (MigrateReport, error) {
+	var r MigrateReport
+	for _, id := range ids {
+		if got, err := to.Get(id); err == nil {
+			clear(got)
+			r.removeOld(from, id)
+			continue
+		} else if !errors.Is(err, ErrNotFound) {
+			return r, fmt.Errorf("migrate %s: %w", id, err)
+		}
+		value, err := from.Get(id)
+		if errors.Is(err, ErrNotFound) {
+			continue
+		}
+		if err != nil {
+			return r, fmt.Errorf("migrate %s: read the old copy: %w", id, err)
+		}
+		err = to.Put(id, value)
+		if err == nil {
+			var back []byte
+			back, err = to.Get(id)
+			if err == nil && !bytes.Equal(back, value) {
+				err = errors.New("the new copy did not read back intact")
+			}
+			clear(back)
+			if err != nil {
+				_ = to.Delete(id)
+			}
+		}
+		clear(value)
+		if err != nil {
+			return r, fmt.Errorf("migrate %s: %w", id, err)
+		}
+		r.Moved++
+		r.removeOld(from, id)
+	}
+	return r, nil
+}
+
+func (r *MigrateReport) removeOld(from Store, id string) {
+	if err := from.Delete(id); err != nil && !errors.Is(err, ErrNotFound) {
+		r.Residue = append(r.Residue, id)
+	}
+}
diff --git a/keyd/internal/vault/migrate_test.go b/keyd/internal/vault/migrate_test.go
new file mode 100644
index 0000000..acb5c20
--- /dev/null
+++ b/keyd/internal/vault/migrate_test.go
@@ -0,0 +1,127 @@
+package vault
+
+import (
+	"bytes"
+	"errors"
+	"testing"
+)
+
+type faultyStore struct {
+	Store
+	failGet, failPut, failDelete error
+	corrupt                      bool
+}
+
+func (f *faultyStore) Get(id string) ([]byte, error) {
+	if f.failGet != nil {
+		return nil, f.failGet
+	}
+	v, err := f.Store.Get(id)
+	if err == nil && f.corrupt {
+		v[0] ^= 1
+	}
+	return v, err
+}
+
+func (f *faultyStore) Put(id string, value []byte) error {
+	if f.failPut != nil {
+		return f.failPut
+	}
+	return f.Store.Put(id, value)
+}
+
+func (f *faultyStore) Delete(id string) error {
+	if f.failDelete != nil {
+		return f.failDelete
+	}
+	return f.Store.Delete(id)
+}
+
+func value(t *testing.T, s Store, id string) []byte {
+	t.Helper()
+	v, err := s.Get(id)
+	if err != nil {
+		t.Fatalf("get %s: %v", id, err)
+	}
+	return v
+}
+
+func TestMigrateMovesEveryValueAndRemovesTheOldCopy(t *testing.T) {
+	from, to := NewMemory(), NewMemory()
+	_ = from.Put("anthropic", []byte("migrate-fake-value-a"))
+	_ = from.Put("weather", []byte("migrate-fake-value-w"))
+	r, err := Migrate([]string{"anthropic", "weather", "absent"}, from, to)
+	if err != nil || r.Moved != 2 || len(r.Residue) != 0 {
+		t.Fatalf("report %+v, err %v", r, err)
+	}
+	if !bytes.Equal(value(t, to, "weather"), []byte("migrate-fake-value-w")) {
+		t.Fatal("the value changed on the way")
+	}
+	for _, id := range []string{"anthropic", "weather"} {
+		if _, err := from.Get(id); !errors.Is(err, ErrNotFound) {
+			t.Fatalf("the old copy of %s is still readable: %v", id, err)
+		}
+	}
+	if _, err := to.Get("absent"); !errors.Is(err, ErrNotFound) {
+		t.Fatal("an id in neither store was invented")
+	}
+}
+
+func TestMigrateIsIdempotentAfterAnInterruption(t *testing.T) {
+	// Killed after the new copy was written, before the old one was deleted.
+	from, to := NewMemory(), NewMemory()
+	_ = from.Put("anthropic", []byte("migrate-old-fake-value"))
+	_ = to.Put("anthropic", []byte("migrate-new-fake-value"))
+	r, err := Migrate([]string{"anthropic"}, from, to)
+	if err != nil || r.Moved != 0 {
+		t.Fatalf("report %+v, err %v", r, err)
+	}
+	if !bytes.Equal(value(t, to, "anthropic"), []byte("migrate-new-fake-value")) {
+		t.Fatal("the new store's value was overwritten by the old one")
+	}
+	if _, err := from.Get("anthropic"); !errors.Is(err, ErrNotFound) {
+		t.Fatal("the old copy was not removed")
+	}
+}
+
+func TestMigrateKeepsTheOldCopyWhenTheNewOneFails(t *testing.T) {
+	cases := map[string]*faultyStore{
+		"a write error":       {Store: NewMemory(), failPut: errors.New("keychain locked")},
+		"a corrupt read-back": {Store: NewMemory(), corrupt: true},
+	}
+	for name, to := range cases {
+		t.Run(name, func(t *testing.T) {
+			from := NewMemory()
+			_ = from.Put("anthropic", []byte("migrate-fake-value-a"))
+			if _, err := Migrate([]string{"anthropic"}, from, to); err == nil {
+				t.Fatal("the migration reported success")
+			}
+			if !bytes.Equal(value(t, from, "anthropic"), []byte("migrate-fake-value-a")) {
+				t.Fatal("the old copy was lost")
+			}
+			if _, err := to.Store.Get("anthropic"); !errors.Is(err, ErrNotFound) {
+				t.Fatal("a copy that did not read back was left in the new store")
+			}
+		})
+	}
+}
+
+func TestMigrateStopsOnAnUnreadableStore(t *testing.T) {
+	from := NewMemory()
+	_ = from.Put("anthropic", []byte("migrate-fake-value-a"))
+	if _, err := Migrate([]string{"anthropic"}, &faultyStore{Store: from, failGet: errors.New("exit status 51")}, NewMemory()); err == nil {
+		t.Fatal("an unreadable old store passed")
+	}
+	if _, err := Migrate([]string{"anthropic"}, from, &faultyStore{Store: NewMemory(), failGet: errors.New("interaction not allowed")}); err == nil {
+		t.Fatal("an unreadable new store passed")
+	}
+}
+
+func TestMigrateReportsAnOldCopyItCouldNotRemove(t *testing.T) {
+	from := &faultyStore{Store: NewMemory(), failDelete: errors.New("exit status 45")}
+	_ = from.Store.Put("anthropic", []byte("migrate-fake-value-a"))
+	r, err := Migrate([]string{"anthropic"}, from, NewMemory())
+	if err != nil || r.Moved != 1 || len(r.Residue) != 1 || r.Residue[0] != "anthropic" {
+		t.Fatalf("report %+v, err %v", r, err)
+	}
+}
